--- /dev/null
+++ b/server/stt/idle-timeout.ts
@@ -0,0 +1,61 @@
+import type { STTProvider, STTStream, StreamEvents, StreamOptions } from './provider.js';
+
+export class IdleTimeoutError extends Error {
+  readonly code = 'IDLE_TIMEOUT';
+  constructor(seconds: number) {
+    super(`STT stream closed after ${seconds}s without audio`);
+    this.name = 'IdleTimeoutError';
+  }
+}
+
+// Billing hygiene (ADR-002): providers bill for stream/socket-open time, so a
+// stream with no audio flowing must not linger.
+export function withIdleTimeout(
+  provider: STTProvider,
+  idleSeconds: number,
+): STTProvider {
+  return {
+    name: provider.name,
+    supports_diarization: provider.supports_diarization,
+    async start_stream(opts: StreamOptions, events: StreamEvents): Promise<STTStream> {
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      let closed = false;
+      const inner = await provider.start_stream(opts, {
+        ...events,
+        onClose: () => {
+          closed = true;
+          if (timer) clearTimeout(timer);
+          events.onClose?.();
+        },
+      });
+
+      const arm = () => {
+        if (timer) clearTimeout(timer);
+        timer = setTimeout(() => {
+          if (closed) return;
+          closed = true;
+          events.onError(new IdleTimeoutError(idleSeconds));
+          inner.close();
+        }, idleSeconds * 1000);
+      };
+      arm();
+
+      return {
+        send_audio: (chunk: Buffer) => {
+          arm();
+          try {
+            inner.send_audio(chunk);
+          } catch {
+            // providers must not throw, but stay safe if one does
+          }
+        },
+        close: () => {
+          if (closed) return;
+          closed = true;
+          if (timer) clearTimeout(timer);
+          inner.close();
+        },
+      };
+    },
+  };
+}
