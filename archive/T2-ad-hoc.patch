@@ -0,0 +1,469 @@
+import { useCallback, useEffect, useReducer, useRef, useState } from 'react';
+import { toast } from 'sonner';
+import { sessionsApi } from './api';
+import { FluentSocket } from './socket';
+import {
+  startCapture,
+  type CaptureHandle,
+  type CaptureOptions,
+} from '@/audio/capture';
+import { parseAssist } from './parse-assist';
+import { parseSrt } from './parse-srt';
+import type {
+  AssistPoint,
+  Segment,
+  ServerEvent,
+  SessionInfo,
+  StartSessionBody,
+} from './types';
+
+export interface FinalEntry {
+  index: number;
+  segment: Segment;
+}
+
+export interface TranslationEntry {
+  index: number;
+  text: string;
+  speaker?: string;
+  start_s: number;
+  end_s: number;
+}
+
+export interface DraftEntry {
+  id: number;
+  text: string;
+}
+
+export interface AssistEntry {
+  index: number;
+  question: string;
+  points: AssistPoint[];
+}
+
+export interface LiveState {
+  wsOpen: boolean;
+  starting: boolean;
+  active: SessionInfo | null;
+  finals: FinalEntry[];
+  translationFeed: TranslationEntry[];
+  translations: Record<number, string>;
+  draft: DraftEntry[];
+  speakers: Record<string, string>;
+  assists: AssistEntry[];
+}
+
+export const initialState: LiveState = {
+  wsOpen: false,
+  starting: false,
+  active: null,
+  finals: [],
+  translationFeed: [],
+  translations: {},
+  draft: [],
+  speakers: {},
+  assists: [],
+};
+
+type Action =
+  | { type: 'ws'; open: boolean }
+  | { type: 'starting' }
+  | { type: 'session'; active: SessionInfo | null }
+  | { type: 'partial'; segment: Segment }
+  | { type: 'final'; index: number; segment: Segment }
+  | { type: 'translation'; index: number; text: string }
+  | { type: 'assist'; index: number; question: string; points: AssistPoint[] }
+  | { type: 'speaker'; map: Record<string, string> }
+  | { type: 'reset' };
+
+export function reduce(state: LiveState, action: Action): LiveState {
+  switch (action.type) {
+    case 'ws':
+      return { ...state, wsOpen: action.open };
+    case 'starting':
+      return { ...state, starting: true };
+    case 'session':
+      return {
+        ...state,
+        starting: false,
+        active: action.active,
+        ...(action.active ? {} : { translationFeed: [], draft: [] }),
+      };
+    case 'partial': {
+      const text = action.segment.text.trim();
+      if (text.length === 0) return state;
+      return { ...state, draft: [{ id: 0, text }] };
+    }
+    case 'final': {
+      if (state.finals.some((f) => f.index === action.index)) {
+        return state;
+      }
+      const entry: FinalEntry = {
+        index: action.index,
+        segment: action.segment,
+      };
+      return { ...state, finals: [...state.finals, entry] };
+    }
+    case 'translation': {
+      let translationFeed = state.translationFeed;
+      if (state.translations[action.index] == null) {
+        const seg = state.finals.find(
+          (f) => f.index === action.index,
+        )?.segment;
+        translationFeed = [
+          ...translationFeed,
+          {
+            index: action.index,
+            text: action.text,
+            start_s: seg?.start_s ?? 0,
+            end_s: seg?.end_s ?? 0,
+            ...(seg?.speaker ? { speaker: seg.speaker } : {}),
+          },
+        ];
+      }
+      return {
+        ...state,
+        translations: { ...state.translations, [action.index]: action.text },
+        translationFeed,
+      };
+    }
+    case 'assist': {
+      if (state.assists.some((a) => a.index === action.index)) {
+        return state;
+      }
+      return {
+        ...state,
+        assists: [
+          ...state.assists,
+          {
+            index: action.index,
+            question: action.question,
+            points: action.points,
+          },
+        ],
+      };
+    }
+    case 'speaker':
+      return { ...state, speakers: { ...state.speakers, ...action.map } };
+    case 'reset':
+      return { ...initialState };
+  }
+}
+
+// The draft strip holds at most one entry: the latest interim, verbatim,
+// under the constant id 0 so React reconciles the same RevealWords
+// instance across interims. A final does NOT clear it - the old interim
+// stays until the next interim replaces it - so the strip never flashes
+// empty mid-session. Session end (and reset) still clears dead text.
+
+// Rebuild live state from the stored session bundle (.srt cues + the .md
+// `## Assist` body) after a reload/reconnect so a page refresh does not
+// blank an in-progress transcript (ADR-007).
+export function backfillFromStored(stored: {
+  meta: { speakers: Record<string, string> };
+  srt: string;
+  assist: string;
+}): {
+  finals: FinalEntry[];
+  translations: Record<number, string>;
+  assists: AssistEntry[];
+} {
+  const knownSpeakers = new Set<string>();
+  for (const [label, name] of Object.entries(stored.meta.speakers)) {
+    knownSpeakers.add(label);
+    knownSpeakers.add(name);
+  }
+  const finals: FinalEntry[] = [];
+  const translations: Record<number, string> = {};
+  for (const cue of parseSrt(stored.srt, knownSpeakers)) {
+    finals.push({
+      index: cue.index,
+      segment: {
+        text: cue.source,
+        start_s: cue.start_s,
+        end_s: cue.end_s,
+        ...(cue.speaker !== undefined ? { speaker: cue.speaker } : {}),
+      },
+    });
+    if (cue.translation != null) {
+      translations[cue.index] = cue.translation;
+    }
+  }
+  return { finals, translations, assists: parseAssist(stored.assist) };
+}
+
+export function useLiveSession(opts?: {
+  onSessionEnded?: (id: string) => void;
+}) {
+  const [state, dispatch] = useReducer(reduce, initialState);
+  const [micMuted, setMicMuted] = useState(false);
+  const socketRef = useRef<FluentSocket | undefined>(undefined);
+  const captureRef = useRef<CaptureHandle | undefined>(undefined);
+  const captureOptsRef = useRef<CaptureOptions | undefined>(undefined);
+  const activeIdRef = useRef<string | null>(null);
+  const stoppingRef = useRef(false);
+  const stateRef = useRef(state);
+  useEffect(() => {
+    stateRef.current = state;
+  });
+  // opts is synced through a ref so the fixed-deps useCallbacks below never
+  // freeze a stale callback prop
+  const optsRef = useRef(opts);
+  useEffect(() => {
+    optsRef.current = opts;
+  });
+  const lastEndedIdRef = useRef<string | null>(null);
+
+  // fires at most once per ended session id; reset by the next start()
+  const emitEnded = useCallback((id: string) => {
+    if (lastEndedIdRef.current === id) return;
+    lastEndedIdRef.current = id;
+    optsRef.current?.onSessionEnded?.(id);
+  }, []);
+
+  const handleEvent = useCallback(
+    (evt: ServerEvent) => {
+      switch (evt.type) {
+        case 'session': {
+          const next = evt.state === 'active' ? (evt.session ?? null) : null;
+          const wasActive = activeIdRef.current !== null;
+          const endedId = activeIdRef.current;
+          activeIdRef.current = next?.id ?? null;
+          dispatch({ type: 'session', active: next });
+          if (next) {
+            void backfill(next.id, dispatch);
+          } else if (wasActive && !stoppingRef.current) {
+            toast.info('Session ended');
+          }
+          // the server broadcasts idle only after writer.finalize(), so the
+          // session files are complete when a listener navigates to them
+          if (wasActive && !next && endedId) emitEnded(endedId);
+          break;
+        }
+        case 'partial':
+          dispatch({ type: 'partial', segment: evt.segment });
+          break;
+        case 'final':
+          dispatch({ type: 'final', index: evt.index, segment: evt.segment });
+          break;
+        case 'translation':
+          dispatch({ type: 'translation', index: evt.index, text: evt.text });
+          break;
+        case 'assist':
+          dispatch({
+            type: 'assist',
+            index: evt.index,
+            question: evt.question,
+            points: evt.points,
+          });
+          break;
+        case 'speaker':
+          dispatch({ type: 'speaker', map: evt.map });
+          break;
+        case 'error':
+          toast.error(evt.message);
+          break;
+      }
+    },
+    [emitEnded],
+  );
+
+  const ensureSocket = useCallback(async () => {
+    if (socketRef.current?.isLive) return;
+    socketRef.current?.close();
+    const sock = new FluentSocket();
+    sock.onEvent = handleEvent;
+    sock.onOpenChange = (open) => {
+      dispatch({ type: 'ws', open });
+      // a dropped socket while a session is live means silently lost audio;
+      // retry the connection (also beats the server-side teardown grace)
+      if (!open && activeIdRef.current) {
+        setTimeout(() => void ensureSocket().catch(() => {}), 1_000);
+      }
+    };
+    socketRef.current = sock;
+    try {
+      await sock.connect();
+    } catch (err) {
+      // a socket torn down by our own cleanup (StrictMode remount, page
+      // switch) is not a connectivity failure; only report a failure of
+      // the socket that is still current
+      if (socketRef.current === sock) throw err;
+    }
+  }, [handleEvent]);
+
+  const start = useCallback(
+    async (body: StartSessionBody, capture: CaptureOptions) => {
+      stoppingRef.current = false;
+      lastEndedIdRef.current = null;
+      setMicMuted(false);
+      dispatch({ type: 'reset' });
+      dispatch({ type: 'starting' });
+      let info: SessionInfo | null = null;
+      try {
+        info = await sessionsApi.start(body);
+        activeIdRef.current = info.id;
+        await ensureSocket();
+        captureOptsRef.current = capture;
+        captureRef.current = await startCapture(capture, (buf) =>
+          socketRef.current?.sendAudio(buf),
+        );
+        dispatch({ type: 'session', active: info });
+      } catch (err) {
+        // capture failures (getDisplayMedia cancel, device unplugged) leave
+        // the REST session running server-side; tear it down so the UI and
+        // the server agree the session is stopped
+        if (info) {
+          stoppingRef.current = true;
+          activeIdRef.current = null;
+          try {
+            await sessionsApi.stop(info.id);
+          } catch {
+            // best effort; the server-side idle timeout reaps it anyway
+          }
+        }
+        dispatch({ type: 'session', active: null });
+        toast.error(
+          err instanceof Error ? err.message : 'failed to start session',
+        );
+        throw err;
+      }
+    },
+    [ensureSocket],
+  );
+
+  const stop = useCallback(async () => {
+    stoppingRef.current = true;
+    captureRef.current?.stop();
+    captureRef.current = undefined;
+    const id = activeIdRef.current;
+    let ended = false;
+    try {
+      if (id) {
+        await sessionsApi.stop(id);
+        ended = true;
+      }
+    } catch (err) {
+      toast.error(err instanceof Error ? err.message : 'failed to stop session');
+    }
+    // clear the ref before emitEnded so the navigation guard (which reads it
+    // synchronously) does not block the navigate to the review page, and so
+    // a dead socket does not trigger a reconnect after a deliberate stop
+    if (ended) activeIdRef.current = null;
+    dispatch({ type: 'session', active: null });
+    if (ended && id) emitEnded(id);
+  }, [emitEnded]);
+
+  // release the mic first so the indicator goes out immediately; a tab share
+  // stays alive inside the handle so resume does not reopen the picker. The
+  // server drops any chunks still in flight while the session is paused
+  const pause = useCallback(async () => {
+    captureRef.current?.pause();
+    const id = activeIdRef.current;
+    if (!id) return;
+    try {
+      await sessionsApi.pause(id);
+    } catch (err) {
+      toast.error(
+        err instanceof Error ? err.message : 'failed to pause session',
+      );
+    }
+  }, []);
+
+  const resume = useCallback(async () => {
+    const id = activeIdRef.current;
+    if (!id) return;
+    let captureResumed = false;
+    try {
+      // rebuild capture first: the session stays paused (billing nothing)
+      // while a revoked share is re-picked, then flips to running
+      if (captureRef.current) {
+        await captureRef.current.resume();
+      } else if (captureOptsRef.current) {
+        captureRef.current = await startCapture(captureOptsRef.current, (buf) =>
+          socketRef.current?.sendAudio(buf),
+        );
+      }
+      captureResumed = true;
+      await sessionsApi.resume(id);
+    } catch (err) {
+      if (captureResumed) captureRef.current?.pause();
+      toast.error(
+        err instanceof Error ? err.message : 'failed to resume session',
+      );
+    }
+  }, []);
+
+  // assist state lives server-side; the rebroadcast `session` event flips
+  // state.active.assist, so this only needs to fire the toggle
+  const toggleAssist = useCallback(async () => {
+    const id = activeIdRef.current;
+    if (!id) return;
+    const enabled = !(stateRef.current.active?.assist ?? false);
+    try {
+      await sessionsApi.setAssist(id, enabled);
+    } catch (err) {
+      toast.error(
+        err instanceof Error ? err.message : 'failed to toggle answer assist',
+      );
+    }
+  }, []);
+
+  // mutes the local mic at the capture gain only: the session and the STT
+  // stream keep running, other sources keep flowing
+  const toggleMicMute = useCallback(() => {
+    setMicMuted((muted) => {
+      captureRef.current?.setMicMuted(!muted);
+      return !muted;
+    });
+  }, []);
+
+  // adopt an already-running session on mount (e.g. after a reload)
+  useEffect(() => {
+    void ensureSocket().catch(() =>
+      toast.error('could not reach the backend'),
+    );
+    return () => {
+      activeIdRef.current = null;
+      captureRef.current?.stop();
+      socketRef.current?.close();
+      socketRef.current = undefined;
+    };
+  }, [ensureSocket]);
+
+  // synchronous check for the navigation guard: reads the ref, not
+  // state.active, which lags one commit behind a stop() + navigate()
+  const hasActiveSession = useCallback(() => activeIdRef.current != null, []);
+
+  return {
+    state,
+    hasActiveSession,
+    start,
+    stop,
+    pause,
+    resume,
+    micMuted,
+    toggleMicMute,
+    toggleAssist,
+  };
+}
+
+async function backfill(
+  id: string,
+  dispatch: React.Dispatch<Action>,
+): Promise<void> {
+  try {
+    const stored = await sessionsApi.get(id);
+    const { finals, translations, assists } = backfillFromStored(stored);
+    for (const f of finals) dispatch({ type: 'final', ...f });
+    for (const [index, text] of Object.entries(translations)) {
+      dispatch({ type: 'translation', index: Number(index), text });
+    }
+    for (const a of assists) dispatch({ type: 'assist', ...a });
+    for (const [label, name] of Object.entries(stored.meta.speakers)) {
+      dispatch({ type: 'speaker', map: { [label]: name } });
+    }
+  } catch {
+    // file may not exist yet; live events will fill in
+  }
+}
