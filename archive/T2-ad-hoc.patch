diff --git a/scripts/smoke.ts b/scripts/smoke.ts
new file mode 100644
index 0000000..3597af0
--- /dev/null
+++ b/scripts/smoke.ts
@@ -0,0 +1,88 @@
+// Opt-in live check (ADR-006): streams the bundled sample WAV through the
+// configured STT provider, takes the first final segment, and runs it through
+// the configured translator. Verifies keys + connectivity before a session.
+// Usage: tsx scripts/smoke.ts
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { loadConfig } from '../server/config.js';
+import { createSTTProvider } from '../server/stt/index.js';
+import type { Segment } from '../server/stt/provider.js';
+import { makeTranslator } from '../server/translate/openai-compat.js';
+
+const SAMPLE = path.resolve(import.meta.dirname, 'sample.wav');
+const CHUNK_MS = 100;
+const FINAL_TIMEOUT_MS = 45_000;
+
+function extractPcm(wav: Buffer): Buffer {
+  if (wav.toString('ascii', 0, 4) !== 'RIFF') throw new Error('not a WAV file');
+  let off = 12;
+  while (off + 8 <= wav.length) {
+    const id = wav.toString('ascii', off, off + 4);
+    const size = wav.readUInt32LE(off + 4);
+    if (id === 'data') return wav.subarray(off + 8, off + 8 + size);
+    off += 8 + size + (size % 2);
+  }
+  throw new Error('no data chunk in WAV');
+}
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function main() {
+  const config = loadConfig();
+  const diarize = config.STT_PROVIDER === 'deepgram';
+  const provider = createSTTProvider(config, diarize);
+  const translator = makeTranslator(config);
+
+  console.log(`STT provider : ${provider.name}${diarize ? ' (+diarization)' : ''}`);
+  console.log(`LLM primary  : ${config.LLM_BASE_URL} / ${config.TRANSLATE_MODEL}`);
+  if (config.LLM_FALLBACK_BASE_URL) {
+    console.log(`LLM fallback : ${config.LLM_FALLBACK_BASE_URL} / ${config.LLM_FALLBACK_MODEL}`);
+  }
+
+  const pcm = extractPcm(await readFile(SAMPLE));
+  const bytesPerChunk = 16000 * 2 * (CHUNK_MS / 1000); // 16kHz s16le
+
+  const firstFinal = new Promise<Segment>((resolve, reject) => {
+    const timer = setTimeout(
+      () => reject(new Error('timed out waiting for a final segment')),
+      FINAL_TIMEOUT_MS,
+    );
+    provider.start_stream({ diarize }, {
+      onPartial: (s) => process.stdout.write(`\rpartial: ${s.text.slice(0, 70)}   `),
+      onFinal: (s) => {
+        clearTimeout(timer);
+        resolve(s);
+      },
+      onError: (err) => {
+        clearTimeout(timer);
+        reject(err);
+      },
+      onClose: () => {},
+    }).then((stream) => {
+      void (async () => {
+        for (let off = 0; off < pcm.length; off += bytesPerChunk) {
+          stream.send_audio(pcm.subarray(off, off + bytesPerChunk));
+          await sleep(CHUNK_MS);
+        }
+        // give the provider a beat to endpoint, then close politely
+        await sleep(3_000);
+        stream.close();
+      })();
+    }).catch((err) => {
+      clearTimeout(timer);
+      reject(err instanceof Error ? err : new Error(String(err)));
+    });
+  });
+
+  const final = await firstFinal;
+  console.log(`\nfinal    : ${final.speaker ? `[${final.speaker}] ` : ''}${final.text}`);
+
+  const translated = await translator.translate(final, [], config.DEFAULT_TARGET_LANG);
+  console.log(`translated (${config.DEFAULT_TARGET_LANG}): ${translated}`);
+  console.log('\nSMOKE PASS');
+}
+
+main().catch((err) => {
+  console.error(`\nSMOKE FAIL: ${err instanceof Error ? err.message : err}`);
+  process.exit(1);
+});
diff --git a/server/app.test.ts b/server/app.test.ts
new file mode 100644
index 0000000..3489e77
--- /dev/null
+++ b/server/app.test.ts
@@ -0,0 +1,697 @@
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import type { AddressInfo } from 'node:net';
+import WebSocket from 'ws';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { buildServer } from './index.js';
+import { parseConfig } from './config.js';
+import { filePathFor, wavPathFor } from './session/markdown.js';
+import type {
+  Segment,
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './stt/provider.js';
+import type { Translator } from './translate/translator.js';
+import type { AnswerAssistant } from './assist/assistant.js';
+
+class FakeProvider implements STTProvider {
+  readonly name = 'deepgram';
+  readonly supports_diarization = true;
+  events?: StreamEvents;
+  audio: Buffer[] = [];
+  closed = false;
+  startCount = 0;
+  sendImpl: (c: Buffer) => void = (c) => {
+    this.audio.push(c);
+  };
+  async start_stream(_opts: StreamOptions, events: StreamEvents): Promise<STTStream> {
+    this.events = events;
+    this.startCount++;
+    this.closed = false;
+    return {
+      send_audio: (c: Buffer) => this.sendImpl(c),
+      close: () => {
+        this.closed = true;
+        events.onClose?.();
+      },
+    };
+  }
+  emitFinal(seg: Segment) {
+    this.events?.onFinal(seg);
+  }
+}
+
+const fakeTranslator: Translator = {
+  translate: async () => 'XIN CHÀO',
+};
+
+let dir: string;
+let app: Awaited<ReturnType<typeof buildServer>>;
+let provider: FakeProvider;
+let translateSpy: ReturnType<typeof vi.fn>;
+let assistSpy: ReturnType<typeof vi.fn>;
+let port: number;
+
+beforeEach(async () => {
+  dir = await fs.mkdtemp(path.join(os.tmpdir(), 'fluent-app-'));
+  provider = new FakeProvider();
+  const config = parseConfig({
+    STT_PROVIDER: 'deepgram',
+    DEEPGRAM_API_KEY: 'dg',
+    LLM_API_KEY: 'llm',
+  });
+  translateSpy = vi.fn(fakeTranslator.translate);
+  assistSpy = vi.fn(async () => ({ question: null, points: [] }));
+  app = await buildServer(config, {
+    rootDir: dir,
+    providerFactory: () => provider,
+    translatorFactory: () => ({ translate: translateSpy }) as Translator,
+    assistantFactory: () => ({ analyze: assistSpy }) as AnswerAssistant,
+  });
+  await app.listen({ port: 0, host: '127.0.0.1' });
+  port = (app.server.address() as AddressInfo).port;
+});
+
+afterEach(async () => {
+  await app.close();
+  await fs.rm(dir, { recursive: true, force: true });
+});
+
+function connectWs() {
+  const ws = new WebSocket(`ws://127.0.0.1:${port}/ws`);
+  const messages: Record<string, unknown>[] = [];
+  ws.on('message', (data) => {
+    messages.push(JSON.parse(String(data)) as Record<string, unknown>);
+  });
+  return { ws, messages };
+}
+
+describe('REST + WS surface', () => {
+  it('full session lifecycle: start -> audio -> final -> translation -> rename -> stop -> read', async () => {
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/sessions',
+      payload: { targetLang: 'vi', diarize: true },
+    });
+    expect(res.statusCode).toBe(201);
+    const info = res.json() as { id: string };
+    expect(info.id).toMatch(/^\d{4}-\d{2}-\d{2}-session-\d{4}$/);
+
+    // one active session max
+    const conflict = await app.inject({ method: 'POST', url: '/api/sessions', payload: {} });
+    expect(conflict.statusCode).toBe(409);
+
+    const { ws, messages } = connectWs();
+    await vi.waitFor(() => expect(messages.length).toBeGreaterThan(0));
+    expect(messages[0]).toMatchObject({ type: 'session', state: 'active' });
+
+    // binary PCM flows to the provider
+    ws.send(Buffer.from([7, 8, 9]));
+    await vi.waitFor(() => expect(provider.audio.length).toBe(1));
+
+    // a final segment produces a final event, an srt cue, and a translation
+    provider.emitFinal({ text: 'Hello.', speaker: 'Speaker 1', start_s: 1, end_s: 2 });
+    await vi.waitFor(() =>
+      expect(messages.some((m) => m.type === 'final')).toBe(true),
+    );
+    await vi.waitFor(() =>
+      expect(
+        messages.some(
+          (m) => m.type === 'translation' && m.text === 'XIN CHÀO',
+        ),
+      ).toBe(true),
+    );
+
+    // speaker rename broadcasts + persists to frontmatter
+    const rename = await app.inject({
+      method: 'PATCH',
+      url: `/api/sessions/${info.id}/speakers`,
+      payload: { map: { 'Speaker 1': 'Interviewer' } },
+    });
+    expect(rename.statusCode).toBe(200);
+    await vi.waitFor(() =>
+      expect(messages.some((m) => m.type === 'speaker')).toBe(true),
+    );
+
+    const stop = await app.inject({ method: 'POST', url: `/api/sessions/${info.id}/stop` });
+    expect(stop.statusCode).toBe(200);
+    await vi.waitFor(() =>
+      expect(
+        messages.some((m) => m.type === 'session' && m.state === 'idle'),
+      ).toBe(true),
+    );
+    expect(provider.closed).toBe(true);
+
+    const read = await app.inject({ method: 'GET', url: `/api/sessions/${info.id}` });
+    expect(read.statusCode).toBe(200);
