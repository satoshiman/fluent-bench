+import type { FastifyInstance } from 'fastify';
+import type { WebSocket } from 'ws';
+import { z } from 'zod';
+import type { SessionManager } from './session/manager.js';
+
+const controlSchema = z.object({ type: z.literal('ping') });
+
+// Grace period so page reloads / Vite HMR do not tear down a live stream.
+const DISCONNECT_GRACE_MS = 3_000;
+
+export function registerWs(app: FastifyInstance, sessions: SessionManager): void {
+  const sockets = new Set<WebSocket>();
+  let teardownTimer: ReturnType<typeof setTimeout> | undefined;
+
+  app.get('/ws', { websocket: true }, (socket) => {
+    sockets.add(socket);
+    if (teardownTimer) {
+      clearTimeout(teardownTimer);
+      teardownTimer = undefined;
+    }
+
+    const unsubscribe = sessions.subscribe((evt) => {
+      if (socket.readyState === socket.OPEN) {
+        socket.send(JSON.stringify(evt));
+      }
+    });
+
+    const current = sessions.current();
+    socket.send(
+      JSON.stringify(
+        current
+          ? { type: 'session', state: 'active', session: current }
+          : { type: 'session', state: 'idle' },
+      ),
+    );
+
+    socket.on('message', (data: Buffer, isBinary: boolean) => {
+      if (isBinary) {
+        // linear16 PCM straight into the STT stream
+        try {
+          sessions.sendAudio(data);
+        } catch (err) {
+          socket.send(
+            JSON.stringify({
+              type: 'error',
+              message: err instanceof Error ? err.message : 'audio send failed',
+            }),
+          );
+        }
+        return;
+      }
+      try {
+        const msg = controlSchema.parse(JSON.parse(data.toString()));
+        if (msg.type === 'ping') socket.send(JSON.stringify({ type: 'pong' }));
+      } catch {
+        socket.send(
+          JSON.stringify({ type: 'error', message: 'invalid control message' }),
+        );
+      }
+    });
+
+    socket.on('close', () => {
+      unsubscribe();
+      sockets.delete(socket);
+      // Billing hygiene (ADR-002): a disconnected browser means no audio is
+      // coming; tear the provider stream down after a short grace period.
+      if (sockets.size === 0) {
+        teardownTimer = setTimeout(() => {
+          const cur = sessions.current();
+          if (cur) void sessions.stop(cur.id).catch(() => {});
+        }, DISCONNECT_GRACE_MS);
+      }
+    });
+  });
+}
