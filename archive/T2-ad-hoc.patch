+export interface Segment {
+  text: string;
+  speaker?: string;
+  start_s: number;
+  end_s: number;
+}
+
+export interface AssistPoint {
+  en: string;
+  note: string;
+}
+
+export interface SessionInfo {
+  id: string;
+  started_at: string;
+  target_lang: string;
+  diarization: boolean;
+  stt_provider: string;
+  model: string | null;
+  file: string;
+  paused: boolean;
+  assist: boolean;
+  record_audio: boolean;
+}
+
+export type ServerEvent =
+  | { type: 'session'; state: 'idle' | 'active'; session?: SessionInfo }
+  | { type: 'partial'; segment: Segment }
+  | { type: 'final'; index: number; segment: Segment }
+  | { type: 'translation'; index: number; text: string }
+  | { type: 'assist'; index: number; question: string; points: AssistPoint[] }
+  | { type: 'speaker'; map: Record<string, string> }
+  | { type: 'error'; message: string; code?: string; index?: number }
+  | { type: 'pong' };
+
+export interface SessionSummary {
+  id: string;
+  file: string;
+  started_at: string | null;
+  ended_at: string | null;
+  source_lang: string;
+  target_lang: string;
+  stt_provider: string;
+  model: string | null;
+  diarization: boolean;
+  audio_file: string | null;
+  speakers: Record<string, string>;
+  duration_s: number | null;
+  segments: number;
+}
+
+export interface StoredSession {
+  meta: SessionSummary;
+  srt: string;
+  assist: string;
+}
+
+export interface StartSessionBody {
+  targetLang?: string;
+  diarize?: boolean;
+  model?: string;
+  keyterms?: string[];
+  slug?: string;
+  audioSource?: string;
+  recordAudio?: boolean;
+}
