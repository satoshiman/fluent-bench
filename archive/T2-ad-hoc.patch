+
+const validEnv: Record<string, string> = {
+  STT_PROVIDER: 'deepgram',
+  DEEPGRAM_API_KEY: 'dg-key',
+  LLM_API_KEY: 'llm-key',
+  LLM_FALLBACK_BASE_URL: 'https://api.openai.com/v1',
+  LLM_FALLBACK_API_KEY: 'fb-key',
+};
+
+describe('parseConfig', () => {
+  it('applies documented defaults', () => {
+    const c = parseConfig(validEnv);
+    expect(c.STT_PROVIDER).toBe('deepgram');
+    expect(c.LLM_BASE_URL).toBe('https://api.deepseek.com');
+    expect(c.TRANSLATE_MODEL).toBe('deepseek-flash');
+    expect(c.LLM_FALLBACK_MODEL).toBe('gpt-4.1-mini');
+    expect(c.DEFAULT_TARGET_LANG).toBe('vi');
+    expect(c.PORT).toBe(3000);
+  });
+
+  it('fails fast with a readable error when the selected provider key is missing', () => {
+    expect(() =>
+      parseConfig({ ...validEnv, DEEPGRAM_API_KEY: undefined }),
+    ).toThrow(/DEEPGRAM_API_KEY/);
+    expect(() =>
+      parseConfig({
+        ...validEnv,
+        STT_PROVIDER: 'assemblyai',
+        ASSEMBLYAI_API_KEY: undefined,
+      }),
+    ).toThrow(/ASSEMBLYAI_API_KEY/);
+  });
+
+  it('fails when LLM_API_KEY is missing', () => {
+    expect(() => parseConfig({ ...validEnv, LLM_API_KEY: '' })).toThrow(
+      /LLM_API_KEY/,
+    );
+  });
+
+  it('requires the fallback key only when a fallback URL is set', () => {
+    const c = parseConfig({
+      ...validEnv,
+      LLM_FALLBACK_BASE_URL: '',
+      LLM_FALLBACK_API_KEY: '',
+    });
+    expect(c.LLM_FALLBACK_BASE_URL).toBeUndefined();
+    expect(() =>
+      parseConfig({ ...validEnv, LLM_FALLBACK_API_KEY: '' }),
+    ).toThrow(/LLM_FALLBACK_API_KEY/);
+  });
+
+  it('rejects an unknown STT_PROVIDER value', () => {
+    expect(() =>
+      parseConfig({ ...validEnv, STT_PROVIDER: 'whisper' }),
+    ).toThrow(/STT_PROVIDER/);
+  });
+});
