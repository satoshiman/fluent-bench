@@ -0,0 +1,87 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+export function useDocumentPiP(): {
+  supported: boolean;
+  pipWindow: Window | null;
+  open: () => Promise<void>;
+  close: () => void;
+} {
+  const supported = 'documentPictureInPicture' in window;
+  const [pipWindow, setPipWindow] = useState<Window | null>(null);
+  const pipWindowRef = useRef<Window | null>(null);
+  const teardownRef = useRef<(() => void) | null>(null);
+
+  const reset = useCallback(() => {
+    teardownRef.current?.();
+    teardownRef.current = null;
+    pipWindowRef.current = null;
+    setPipWindow(null);
+  }, []);
+
+  const open = useCallback(async () => {
+    const api = window.documentPictureInPicture;
+    if (!api || pipWindowRef.current) return;
+
+    const win = await api.requestWindow({ width: 520, height: 360 });
+
+    for (const sheet of Array.from(document.styleSheets)) {
+      if (sheet.href) {
+        const link = win.document.createElement('link');
+        link.rel = 'stylesheet';
+        link.href = sheet.href;
+        win.document.head.appendChild(link);
+      } else if (sheet.ownerNode?.textContent) {
+        const style = win.document.createElement('style');
+        style.textContent = sheet.ownerNode.textContent;
+        win.document.head.appendChild(style);
+      }
+    }
+    try {
+      win.document.adoptedStyleSheets = [...document.adoptedStyleSheets];
+    } catch {
+      // constructed sheets may not be adoptable cross-document
+    }
+
+    const applyTheme = () => {
+      win.document.documentElement.className =
+        document.documentElement.className;
+      win.document.documentElement.style.colorScheme = getComputedStyle(
+        document.documentElement,
+      ).colorScheme;
+    };
+    applyTheme();
+    const observer = new MutationObserver(applyTheme);
+    observer.observe(document.documentElement, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+
+    win.document.body.className = 'bg-background text-foreground';
+
+    const onPageHide = () => reset();
+    win.addEventListener('pagehide', onPageHide);
+    teardownRef.current = () => {
+      observer.disconnect();
+      win.removeEventListener('pagehide', onPageHide);
+    };
+    pipWindowRef.current = win;
+    setPipWindow(win);
+  }, [reset]);
+
+  const close = useCallback(() => {
+    const win = pipWindowRef.current;
+    if (!win) return;
+    reset();
+    win.close();
+  }, [reset]);
+
+  useEffect(
+    () => () => {
+      teardownRef.current?.();
+      pipWindowRef.current?.close();
+    },
+    [],
+  );
+
+  return { supported, pipWindow, open, close };
+}
