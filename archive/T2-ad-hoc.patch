@@ -0,0 +1,59 @@
+import { describe, expect, it } from 'vitest';
+import { parseAssist } from './parse-assist';
+
+describe('parseAssist', () => {
+  it('parses a question with points, with and without notes', () => {
+    const md = [
+      '## Assist',
+      '',
+      '- `#3` ? What is your name?',
+      '  - My name is ... (tên của tôi là ...)',
+      '  - I work at ...',
+      '',
+    ].join('\n');
+    expect(parseAssist(md)).toEqual([
+      {
+        index: 3,
+        question: 'What is your name?',
+        points: [
+          { en: 'My name is ...', note: 'tên của tôi là ...' },
+          { en: 'I work at ...', note: '' },
+        ],
+      },
+    ]);
+  });
+
+  it('parses multiple entries and ignores stray bullets', () => {
+    const md = [
+      '## Assist',
+      '',
+      '- `#0` ? Q1?',
+      '  - point a (note a)',
+      '- `#4` ? Q2?',
+      '  - stray bullet',
+      'not a bullet',
+      '  - point b',
+      '- `#7` ? Q3?',
+    ].join('\n');
+    // 'not a bullet' closes the Q2 entry, so the later indented bullet is
+    // dropped as stray rather than attached across the gap
+    expect(parseAssist(md)).toEqual([
+      {
+        index: 0,
+        question: 'Q1?',
+        points: [{ en: 'point a', note: 'note a' }],
+      },
+      {
+        index: 4,
+        question: 'Q2?',
+        points: [{ en: 'stray bullet', note: '' }],
+      },
+      { index: 7, question: 'Q3?', points: [] },
+    ]);
+  });
+
+  it('handles empty input', () => {
+    expect(parseAssist('')).toEqual([]);
+    expect(parseAssist('## Assist\n')).toEqual([]);
+  });
+});
diff --git a/web/src/lib/parse-assist.ts b/web/src/lib/parse-assist.ts
new file mode 100644
index 0000000..5276626
--- /dev/null
+++ b/web/src/lib/parse-assist.ts
@@ -0,0 +1,44 @@
+import type { AssistPoint } from './types';
+
+export interface ParsedAssist {
+  index: number;
+  question: string;
+  points: AssistPoint[];
+}
+
+// Parses the `## Assist` body of a session .md (ADR-007): a `- \`#n\` ?`
+// header per detected question, then one indented bullet per point with an
+// optional `(note)` gloss. Stray bullets outside an entry are ignored.
+export function parseAssist(text: string): ParsedAssist[] {
+  const entries: ParsedAssist[] = [];
+  let current: ParsedAssist | null = null;
+  for (const line of text.split('\n')) {
+    const q = /^- `#(\d+)` \? (.*)$/.exec(line);
+    if (q) {
+      current = {
+        index: Number(q[1]),
+        question: q[2]!.trim(),
+        points: [],
+      };
+      entries.push(current);
+      continue;
+    }
+    if (current) {
+      const bullet = /^ {2}- (.*) \(([^()]*)\)$/.exec(line);
+      if (bullet) {
+        current.points.push({
+          en: bullet[1]!.trim(),
+          note: bullet[2]!.trim(),
+        });
+        continue;
+      }
+      const bare = /^ {2}- (.*)$/.exec(line);
+      if (bare) {
+        current.points.push({ en: bare[1]!.trim(), note: '' });
+        continue;
+      }
+      current = null;
+    }
+  }
+  return entries;
+}
