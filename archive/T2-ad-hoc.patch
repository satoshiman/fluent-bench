diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..34b26a5
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,31 @@
+# STT provider selection: "deepgram" (default, diarization-capable) or
+# "assemblyai" (low-cost path, no diarization).
+STT_PROVIDER=deepgram
+
+# STT provider keys (secrets - leave empty here, fill in .env)
+DEEPGRAM_API_KEY=
+ASSEMBLYAI_API_KEY=
+
+# Seconds of no audio before the STT stream auto-closes (billing hygiene).
+STT_IDLE_TIMEOUT_S=30
+
+# Primary LLM (OpenAI-compatible). Defaults point at DeepSeek.
+LLM_BASE_URL=https://api.deepseek.com
+LLM_API_KEY=
+TRANSLATE_MODEL=deepseek-flash
+# Model for answer-assist calls (optional, defaults to TRANSLATE_MODEL).
+ASSIST_MODEL=
+
+# Fallback LLM (optional): retried once when the primary errors or times out.
+# Enabled only when both LLM_FALLBACK_BASE_URL and LLM_FALLBACK_API_KEY are
+# set. Uncomment the URL to enable. Suggested: OpenAI gpt-4.1-mini-class.
+# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
+LLM_FALLBACK_API_KEY=
+LLM_FALLBACK_MODEL=gpt-4.1-mini
+
+# Default target language for new sessions (ISO code or name the LLM knows).
+# Overridable per session in the UI.
+DEFAULT_TARGET_LANG=vi
+
+# Backend bind port (always 127.0.0.1).
+PORT=3000
