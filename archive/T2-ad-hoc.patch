+        <span
+          key={i}
+          className={`eq-bar w-[3px] rounded-full ${size === 'lg' ? 'bg-primary/40' : 'bg-primary'}`}
+          style={{ animationDelay: `${i * 140}ms` }}
+        />
+      ))}
+    </span>
