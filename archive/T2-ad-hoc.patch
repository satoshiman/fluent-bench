@@ -0,0 +1,104 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Segment, STTProvider } from './provider.js';
+
+export interface ContractHarness {
+  provider: STTProvider;
+  emitInbound(msg: unknown): void;
+  sentBinary(): Buffer[];
+  sentText(): string[];
+  closed(): boolean;
+}
+
+export interface ContractFixtures {
+  partial: unknown;
+  final: unknown;
+  ignored?: unknown;
+  partialText: string;
+  finalText: string;
+  finalSpeaker?: string;
+}
+
+// Shared contract every STTProvider implementation must satisfy (ADR-002 /
+// ADR-006): partial/final event mapping, audio forwarding, prompt teardown.
+export function sttProviderContract(
+  name: string,
+  makeHarness: () => Promise<ContractHarness> | ContractHarness,
+  fixtures: ContractFixtures,
+) {
+  describe(`${name} STTProvider contract`, () => {
+    it('forwards audio chunks to the transport', async () => {
+      const h = await makeHarness();
+      const events = stubEvents();
+      const stream = await h.provider.start_stream({ diarize: true }, events);
+      const chunk = Buffer.from([1, 2, 3, 4]);
+      stream.send_audio(chunk);
+      expect(h.sentBinary()).toContainEqual(chunk);
+      stream.close();
+    });
+
+    it('maps a partial payload to onPartial', async () => {
+      const h = await makeHarness();
+      const events = stubEvents();
+      const stream = await h.provider.start_stream({ diarize: true }, events);
+      h.emitInbound(fixtures.partial);
+      expect(events.partials.map((s) => s.text)).toContain(fixtures.partialText);
+      expect(events.finals).toHaveLength(0);
+      stream.close();
+    });
+
+    it('maps a final payload to onFinal, carrying the speaker when present', async () => {
+      const h = await makeHarness();
+      const events = stubEvents();
+      const stream = await h.provider.start_stream({ diarize: true }, events);
+      h.emitInbound(fixtures.final);
+      expect(events.finals.map((s) => s.text)).toContain(fixtures.finalText);
+      if (fixtures.finalSpeaker != null) {
+        expect(events.finals[0]?.speaker).toBe(fixtures.finalSpeaker);
+      }
+      stream.close();
+    });
+
+    it('closes the transport promptly on close()', async () => {
+      const h = await makeHarness();
+      const events = stubEvents();
+      const stream = await h.provider.start_stream({ diarize: true }, events);
+      stream.close();
+      await vi.waitFor(() => expect(h.closed()).toBe(true), {
+        timeout: 3000,
+      });
+    });
+
+    it('ignores non-transcript control messages without erroring', async () => {
+      if (fixtures.ignored === undefined) return;
+      const h = await makeHarness();
+      const events = stubEvents();
+      const stream = await h.provider.start_stream({ diarize: true }, events);
+      h.emitInbound(fixtures.ignored);
+      expect(events.errors).toHaveLength(0);
+      expect(events.partials).toHaveLength(0);
+      expect(events.finals).toHaveLength(0);
+      stream.close();
+    });
+  });
+}
+
+export function stubEvents() {
+  const partials: Segment[] = [];
+  const finals: Segment[] = [];
+  const errors: Error[] = [];
+  let closedCount = 0;
+  return {
+    partials,
+    finals,
+    errors,
+    get closedCount() {
+      return closedCount;
+    },
+    onPartial: (s: Segment) => partials.push(s),
+    onFinal: (s: Segment) => finals.push(s),
+    onError: (e: Error) => errors.push(e),
+    onClose: () => {
+      closedCount += 1;
+    },
+  };
+}
