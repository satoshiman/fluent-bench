+  return {
+    plugins: [react(), tailwindcss()],
+    resolve: {
+      alias: {
+        '@': path.resolve(import.meta.dirname, './src'),
+      },
+    },
+    server: {
+      host: '127.0.0.1',
+      proxy: {
+        '/api': `http://127.0.0.1:${backendPort}`,
+        '/ws': { target: `ws://127.0.0.1:${backendPort}`, ws: true },
