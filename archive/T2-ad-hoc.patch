+}: {
+  paragraph: TranscriptParagraph;
+  translations: Record<number, string>;
+}) {
+  const english = paragraph.entries.map((e) => e.segment.text).join(' ');
+  const translated = paragraph.entries
+    .map((e) => translations[e.index])
+    .filter((t): t is string => t != null);
+  const pending = paragraph.entries.some(
+    (e) => translations[e.index] == null,
+  );
+  return (
+    <div
+      className="flex flex-col gap-1 border-l-2 pl-3"
+      style={{
