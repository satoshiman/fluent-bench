+// Each word mounts as its own span; the CSS animation runs once on mount, so
+// only newly appended words reveal, staggered relative to the batch they
+// arrived with. Existing spans are reconciled in place and never re-animate.
+function RevealWords({ text, step = 50 }: { text: string; step?: number }) {
+  const words = text.split(' ');
+  // `from` must be the word count of the last COMMITTED render: the effect
+  // only runs after commit, and it must not trigger a re-render or the
+  // pending words' delays would reset mid-cascade
+  const seenRef = useRef(0);
+  // oxlint-disable-next-line react/refs -- reading the previous committed count is intentional
+  const from = Math.min(seenRef.current, words.length);
+  useEffect(() => {
+    seenRef.current = words.length;
+  }, [words.length]);
+  return words.map((w, i) => (
+    <Fragment key={i}>
+      <span
+        className="word-reveal"
+        style={{
+          animationDelay: `${Math.min(Math.max(i - from, 0), 8) * step}ms`,
+        }}
+      >
+        {w}
+      </span>
+      {i < words.length - 1 ? ' ' : null}
+    </Fragment>
+  ));
