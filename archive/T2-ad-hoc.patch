+++ b/server/session/writer.ts
@@ -0,0 +1,138 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { AssistPoint } from '../assist/assistant.js';
+import type { Segment } from '../stt/provider.js';
+import {
+  filePathFor,
+  parseFrontmatter,
+  renderFrontmatter,
+  srtPathFor,
+  type SessionMeta,
+} from './markdown.js';
+import { formatCue, insertTranslationLine } from './srt.js';
+
+interface WarnLog {
+  warn: (msg: string) => void;
+}
+
+const silentLog: WarnLog = { warn: () => {} };
+
+// Three-file session bundle (ADR-007): `.md` frontmatter + `## Assist` body,
+// bilingual `.srt` cues, sibling `.wav` handled by WavRecorder. All writes
+// serialize on one internal queue so a translation rewrite can never
+// interleave with a cue append.
+export class SessionWriter {
+  private queue: Promise<unknown> = Promise.resolve();
+
+  private constructor(
+    readonly filePath: string,
+    readonly srtPath: string,
+    private meta: SessionMeta,
+    private log: WarnLog,
+  ) {}
+
+  get speakers(): Record<string, string> {
+    return this.meta.speakers;
+  }
+
+  static async create(
+    rootDir: string,
+    meta: SessionMeta,
+    log: WarnLog = silentLog,
+  ): Promise<SessionWriter> {
+    const filePath = filePathFor(rootDir, meta.id);
+    const srtPath = srtPathFor(rootDir, meta.id);
+    await fs.mkdir(path.dirname(filePath), { recursive: true });
+    await fs.writeFile(
+      filePath,
+      `${renderFrontmatter(meta)}\n\n## Assist\n`,
+      { flag: 'wx' },
+    );
+    try {
+      await fs.writeFile(srtPath, '', { flag: 'wx' });
+    } catch (err) {
+      // no orphan half-bundle: the .md went down first, so it goes too
+      await fs.unlink(filePath).catch(() => {});
+      throw err;
+    }
+    return new SessionWriter(filePath, srtPath, meta, log);
+  }
+
+  appendSegment(index: number, seg: Segment): Promise<void> {
+    const speakerName = seg.speaker
+      ? (this.meta.speakers[seg.speaker] ?? seg.speaker)
+      : undefined;
+    const cue = formatCue(index, seg, speakerName);
+    return this.enqueue(() => fs.appendFile(this.srtPath, cue));
+  }
+
+  // Translations land after newer cues may already exist, so this is a
+  // read -> splice -> tmp+rename cycle, serialized on the same queue as the
+  // appends. A missing or already-translated cue logs and skips.
+  appendTranslation(index: number, text: string): Promise<void> {
+    return this.enqueue(async () => {
+      const srt = await fs.readFile(this.srtPath, 'utf8');
+      const spliced = insertTranslationLine(srt, index, text);
+      if (spliced === null) {
+        this.log.warn(
+          `translation for segment ${index} not written: cue missing or already translated`,
+        );
+        return;
+      }
+      const tmp = `${this.srtPath}.tmp`;
+      await fs.writeFile(tmp, spliced);
+      await fs.rename(tmp, this.srtPath);
+    });
+  }
+
+  // Answer-assist block (ADR-007): the detected question under the #n tag,
+  // then one indented bullet per suggested point. The gloss goes in
+  // parentheses; a point with an empty note renders bare.
+  appendAssist(
+    index: number,
+    question: string,
+    points: AssistPoint[],
+  ): Promise<void> {
+    const lines = [`- \`#${index}\` ? ${question}`];
+    for (const p of points) {
+      lines.push(p.note ? `  - ${p.en} (${p.note})` : `  - ${p.en}`);
+    }
+    return this.enqueue(() =>
+      fs.appendFile(this.filePath, `${lines.join('\n')}\n`),
+    );
+  }
+
+  async renameSpeakers(map: Record<string, string>): Promise<void> {
+    for (const [label, name] of Object.entries(map)) {
+      this.meta.speakers[label] = name;
+    }
+    await this.rewriteFrontmatter();
+  }
+
+  async finalize(duration_s: number): Promise<void> {
+    this.meta.ended_at = new Date().toISOString();
+    this.meta.duration_s = Math.round(duration_s);
+    await this.rewriteFrontmatter();
+  }
+
+  private async rewriteFrontmatter(): Promise<void> {
+    await this.enqueue(async () => {
+      let body = '';
+      try {
+        const existing = await fs.readFile(this.filePath, 'utf8');
+        body = parseFrontmatter(existing).body;
+      } catch {
+        body = '';
+      }
+      const tmp = `${this.filePath}.tmp`;
+      await fs.writeFile(tmp, `${renderFrontmatter(this.meta)}\n${body}`);
+      await fs.rename(tmp, this.filePath);
+    });
+  }
+
+  private enqueue<T>(op: () => Promise<T>): Promise<T> {
+    const run = this.queue.then(op);
+    this.queue = run.catch(() => {});
+    return run;
+  }
+}
