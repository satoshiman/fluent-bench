+import { describe, expect, it } from 'vitest';
+import type OpenAI from 'openai';
+import type { LLMEndpoint } from '../translate/openai-compat.js';
+import { parseConfig } from '../config.js';
+import { AssistError } from './assistant.js';
+import {
+  makeAssistant,
+  OpenAICompatAssistant,
+  renderPrompt,
+} from './openai-compat.js';
+
+const endpoint = (url: string, model = 'm'): LLMEndpoint => ({
+  baseURL: url,
+  apiKey: 'k',
+  model,
+});
+
+const QUESTION_JSON = JSON.stringify({
+  is_question: true,
+  question: 'What is your name?',
+  points: [
+    { en: 'My name is ...', note: 'tên của tôi là' },
+    { en: 'I am ... years old', note: 'tôi ... tuổi' },
+  ],
+});
+
+function fakeClient(opts: {
+  responses?: Record<string, string>;
+  fail?: Record<string, boolean>;
+  onCreate?: (ep: LLMEndpoint, body: Record<string, unknown>) => void;
+}) {
+  const calls: string[] = [];
+  const factory = (ep: LLMEndpoint) =>
+    ({
+      chat: {
+        completions: {
+          create: async (body: Record<string, unknown>) => {
+            calls.push(ep.baseURL);
+            opts.onCreate?.(ep, body);
+            if (opts.fail?.[ep.baseURL]) {
+              throw new Error(`boom from ${ep.baseURL}`);
+            }
+            return {
+              choices: [
+                {
+                  message: {
