+import type {
+  SessionInfo,
+  SessionSummary,
+  StartSessionBody,
+  StoredSession,
+} from './types';
+
+async function api<T>(path: string, init?: RequestInit): Promise<T> {
+  const res = await fetch(path, {
+    ...init,
+    headers:
+      init?.body != null ? { 'Content-Type': 'application/json' } : undefined,
+  });
+  if (!res.ok) {
+    const body = (await res.json().catch(() => null)) as {
+      error?: string;
+    } | null;
+    throw new Error(body?.error ?? `request failed: HTTP ${res.status}`);
+  }
+  return (await res.json()) as T;
+}
+
+export const sessionsApi = {
+  start: (body: StartSessionBody) =>
+    api<SessionInfo>('/api/sessions', {
+      method: 'POST',
+      body: JSON.stringify(body),
+    }),
+  stop: (id: string) =>
+    api<{ ok: boolean }>(`/api/sessions/${encodeURIComponent(id)}/stop`, {
+      method: 'POST',
+    }),
+  pause: (id: string) =>
+    api<{ ok: boolean }>(`/api/sessions/${encodeURIComponent(id)}/pause`, {
+      method: 'POST',
+    }),
+  resume: (id: string) =>
+    api<{ ok: boolean }>(`/api/sessions/${encodeURIComponent(id)}/resume`, {
+      method: 'POST',
+    }),
+  setAssist: (id: string, enabled: boolean) =>
+    api<{ ok: boolean }>(`/api/sessions/${encodeURIComponent(id)}/assist`, {
+      method: 'POST',
+      body: JSON.stringify({ enabled }),
+    }),
+  list: () =>
+    api<{ active: SessionInfo | null; sessions: SessionSummary[] }>(
+      '/api/sessions',
+    ),
+  get: (id: string) =>
+    api<StoredSession>(`/api/sessions/${encodeURIComponent(id)}`),
+  audioUrl: (id: string) =>
+    `/api/sessions/${encodeURIComponent(id)}/audio`,
+};
