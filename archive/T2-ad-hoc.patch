diff --git a/server/assist/openai-compat.ts b/server/assist/openai-compat.ts
new file mode 100644
index 0000000..8e1535b
--- /dev/null
+++ b/server/assist/openai-compat.ts
@@ -0,0 +1,187 @@
+import type OpenAI from 'openai';
+import { z } from 'zod';
+import type { Config } from '../config.js';
+import {
+  defaultClientFactory,
+  type ClientFactory,
+  type LLMEndpoint,
+} from '../translate/openai-compat.js';
+import type { Translatable } from '../translate/translator.js';
+import {
+  AssistError,
+  type AnswerAssistant,
+  type AssistPoint,
+  type AssistResult,
+} from './assistant.js';
+
+const SYSTEM_PROMPT =
+  'You are an answer-assist engine inside a live transcription tool. ' +
+  'The user is a non-native English speaker in interviews and meetings. ' +
+  'Analyze the latest finalized transcript segment together with the ' +
+  'rolling context. Decide whether someone has just finished asking the ' +
+  'user a question or giving them a prompt to answer (including imperative ' +
+  'prompts like "Tell me about yourself" or "Walk me through your resume"). ' +
+  'Output only a JSON object.\n\n' +
+  'Schema: {"is_question": boolean, "question": string|null, "points": ' +
+  '[{"en": string, "note": string}]}.\n\n' +
+  'Rules:\n' +
+  '- If nothing answerable just ended, return is_question:false, ' +
+  'question:null, points:[].\n' +
+  '- question restates the detected question in English.\n' +
+  '- points: at most 5 items, ordered by importance. "en" is main keywords ' +
+  'or a short phrase (3-10 words), never a full polished sentence. For ' +
+  'generic personal questions (name, hometown, self-intro, strengths, ' +
+  'salary, availability) write "en" as a sentence skeleton with a blank, ' +
+  'e.g. "My name is ...", "I have ... years of experience in ...".\n' +
+  '- "note" is a 3-8 word gloss in the target language, helping the user ' +
+  'grasp the point. Empty string if nothing useful to add.';
+
+const MAX_POINTS = 5;
+
+const responseSchema = z.object({
+  is_question: z.boolean(),
+  question: z.string().nullable(),
+  points: z.array(z.object({ en: z.string(), note: z.string() })),
+});
+
+// One LLM call per finalized segment while assist is on (PLAN-009): the same
+// OpenAI-compatible plumbing as the translator, with JSON-mode output
+// validated against a zod schema. Best-effort: a single fallback attempt,
+// no retries beyond that.
+export class OpenAICompatAssistant implements AnswerAssistant {
+  constructor(
+    private readonly primary: LLMEndpoint,
+    private readonly fallback: LLMEndpoint | undefined,
+    private readonly clientFactory: ClientFactory = defaultClientFactory,
+  ) {}
+
+  async analyze(
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<AssistResult> {
+    try {
+      return await this.request(this.primary, segment, context, targetLang);
+    } catch (err) {
+      if (!this.fallback) {
+        throw new AssistError(
+          `primary assist call failed and no fallback configured: ${msg(err)}`,
+          err,
+        );
+      }
+      try {
+        return await this.request(this.fallback, segment, context, targetLang);
+      } catch (fallbackErr) {
+        throw new AssistError(
+          `primary and fallback assist calls failed: ${msg(fallbackErr)}`,
+          fallbackErr,
+        );
+      }
+    }
+  }
+
+  private async request(
+    endpoint: LLMEndpoint,
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<AssistResult> {
+    const client = this.clientFactory(endpoint);
+    const body: Record<string, unknown> = {
+      model: endpoint.model,
+      messages: [
+        { role: 'system', content: SYSTEM_PROMPT },
+        { role: 'user', content: renderPrompt(segment, context, targetLang) },
+      ],
+      temperature: 0.2,
+      response_format: { type: 'json_object' },
+      ...endpoint.extraBody,
+    };
+    const res = (await client.chat.completions.create(
+      body as never,
+    )) as OpenAI.ChatCompletion;
+    const text = res.choices[0]?.message?.content?.trim();
+    if (!text) {
+      throw new AssistError('empty assist response');
+    }
+    let raw: unknown;
+    try {
+      raw = JSON.parse(text);
+    } catch (err) {
+      throw new AssistError('assist response is not valid JSON', err);
+    }
+    const parsed = responseSchema.safeParse(raw);
+    if (!parsed.success) {
+      throw new AssistError(
+        `assist response failed schema validation: ${parsed.error.message}`,
+      );
+    }
+    return normalize(parsed.data);
+  }
+}
+
+function normalize(data: z.infer<typeof responseSchema>): AssistResult {
+  const question = data.is_question ? (data.question?.trim() ?? '') : '';
+  if (question === '') {
+    return { question: null, points: [] };
+  }
+  const points: AssistPoint[] = data.points
+    .map((p) => ({ en: p.en.trim(), note: p.note.trim() }))
+    .filter((p) => p.en !== '')
+    .slice(0, MAX_POINTS);
+  return { question, points };
+}
+
+export function renderPrompt(
+  segment: Translatable,
+  context: readonly Translatable[],
+  targetLang: string,
+): string {
+  const lines: string[] = [`Target language: ${targetLang}`];
+  if (context.length > 0) {
+    lines.push('', 'Context (recent transcript):');
+    for (const seg of context) {
+      lines.push(seg.speaker ? `[${seg.speaker}] ${seg.text}` : seg.text);
+    }
+  }
+  lines.push(
+    '',
+    'Segment to analyze:',
+    segment.speaker ? `[${segment.speaker}] ${segment.text}` : segment.text,
+  );
+  return lines.join('\n');
+}
+
+// Non-thinking mode where the provider supports it (ADR-003): DeepSeek
+// accepts an explicit thinking toggle; harmless to omit for providers that
+// do not expose one.
+export function makeAssistant(
+  config: Config,
+  clientFactory?: ClientFactory,
+): AnswerAssistant {
+  const primary: LLMEndpoint = {
+    baseURL: config.LLM_BASE_URL,
+    apiKey: config.LLM_API_KEY ?? '',
+    model: config.ASSIST_MODEL ?? config.TRANSLATE_MODEL,
+  };
+  if (/deepseek/i.test(config.LLM_BASE_URL)) {
+    primary.extraBody = { thinking: { type: 'disabled' } };
+  }
+  const fallback: LLMEndpoint | undefined =
+    config.LLM_FALLBACK_BASE_URL && config.LLM_FALLBACK_API_KEY
+      ? {
+          baseURL: config.LLM_FALLBACK_BASE_URL,
+          apiKey: config.LLM_FALLBACK_API_KEY,
+          model: config.LLM_FALLBACK_MODEL,
+        }
+      : undefined;
+  return new OpenAICompatAssistant(
+    primary,
+    fallback,
+    clientFactory ?? defaultClientFactory,
+  );
+}
+
+function msg(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
