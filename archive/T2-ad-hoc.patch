@@ -0,0 +1,32 @@
+export interface Segment {
+  text: string;
+  speaker?: string;
+  start_s: number;
+  end_s: number;
+}
+
+export interface StreamOptions {
+  diarize: boolean;
+  model?: string;
+  keyterms?: string[];
+  sampleRate?: number;
+  language?: string;
+}
+
+export interface StreamEvents {
+  onPartial(seg: Segment): void;
+  onFinal(seg: Segment): void;
+  onError(err: Error): void;
+  onClose?(): void;
+}
+
+export interface STTStream {
+  send_audio(chunk: Buffer): void;
+  close(): void;
+}
+
+export interface STTProvider {
+  readonly name: string;
+  readonly supports_diarization: boolean;
+  start_stream(opts: StreamOptions, events: StreamEvents): Promise<STTStream>;
+}
