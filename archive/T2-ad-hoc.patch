+  assist: false,
+  record_audio: false,
+});
+
+describe('finals', () => {
+  it('appends finalized entries', () => {
+    let s = reduce(base(), { type: 'final', index: 0, segment: seg('hi') });
+    s = reduce(s, { type: 'final', index: 1, segment: seg('there') });
+    expect(s.finals).toHaveLength(2);
+    expect(s.finals.map((e) => e.segment.text)).toEqual(['hi', 'there']);
+  });
+
+  it('dedups indexes already in finals', () => {
+    let s = reduce(base(), { type: 'final', index: 0, segment: seg('a') });
+    s = reduce(s, { type: 'final', index: 0, segment: seg('a') });
+    expect(s.finals).toHaveLength(1);
+  });
+
+  it('keeps finals when the session ends', () => {
+    let s = reduce(base(), { type: 'final', index: 0, segment: seg('a') });
+    s = reduce(s, { type: 'session', active: null });
+    expect(s.finals).toHaveLength(1);
+    expect(s.draft).toEqual([]);
+  });
+
+  it('keeps the draft when a session event reports paused', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('draft') });
+    s = reduce(s, { type: 'session', active: info(true) });
+    expect(draftText(s)).toBe('draft');
+    expect(s.active?.paused).toBe(true);
+  });
+});
+
+describe('partial draft', () => {
+  it('replaces the draft verbatim as interims grow', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('hello') });
+    expect(draftText(s)).toBe('hello');
+    s = reduce(s, { type: 'partial', segment: seg('hello brave') });
+    expect(draftText(s)).toBe('hello brave');
+    s = reduce(s, {
+      type: 'partial',
+      segment: seg('hello brave new world'),
+    });
+    expect(draftText(s)).toBe('hello brave new world');
+  });
+
+  // real Deepgram interims (scripts/capture-interims.ts): one window can
+  // insert or drop head words - "was losing" became "flow was losing" and
+  // back - while start_s stays pinned at 8.32; each interim lands verbatim
+  it('replaces the draft verbatim on head and tail revisions', () => {
+    let s = reduce(base(), {
+      type: 'partial',
+      segment: seg('was losing almost', 8.32),
+    });
+    s = reduce(s, {
+      type: 'partial',
+      segment: seg('flow was losing almost half of new users', 8.32),
+    });
+    expect(draftText(s)).toBe('flow was losing almost half of new users');
+    s = reduce(s, {
+      type: 'partial',
+      segment: seg(
+        'was losing almost half of new users before they finished',
+        8.32,
+      ),
+    });
+    expect(draftText(s)).toBe(
+      'was losing almost half of new users before they finished',
+    );
+  });
+
+  it('trims the interim but keeps a single entry under id 0', () => {
+    const s = reduce(base(), {
+      type: 'partial',
+      segment: seg('  spaced out  '),
+    });
+    expect(s.draft).toEqual([{ id: 0, text: 'spaced out' }]);
+  });
+
+  it('ignores an empty or whitespace-only interim', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('   ') });
+    expect(s.draft).toEqual([]);
+    s = reduce(s, { type: 'partial', segment: seg('hello') });
+    s = reduce(s, { type: 'partial', segment: seg('  ') });
+    expect(draftText(s)).toBe('hello');
+  });
+
+  it('keeps the draft when the utterance finalizes', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('hello') });
+    s = reduce(s, { type: 'final', index: 0, segment: seg('hello.') });
+    expect(draftText(s)).toBe('hello');
+    expect(s.finals).toHaveLength(1);
+  });
+
+  it('replaces the kept draft with the next interim after a final', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('hello') });
+    s = reduce(s, { type: 'final', index: 0, segment: seg('hello.') });
+    s = reduce(s, { type: 'partial', segment: seg('good morning', 5) });
+    expect(draftText(s)).toBe('good morning');
+  });
+
+  it('keeps the draft when a duplicate final arrives', () => {
+    let s = reduce(base(), {
+      type: 'final',
+      index: 0,
+      segment: seg('hello.'),
+    });
+    s = reduce(s, { type: 'partial', segment: seg('next window') });
+    s = reduce(s, { type: 'final', index: 0, segment: seg('hello.') });
+    expect(draftText(s)).toBe('next window');
+    expect(s.finals).toHaveLength(1);
+  });
+
+  it('clears the draft when the session ends', () => {
+    let s = reduce(base(), { type: 'partial', segment: seg('draft') });
+    s = reduce(s, { type: 'session', active: null });
+    expect(s.draft).toEqual([]);
+  });
+});
+
+// 60s of real nova-3 output captured by scripts/capture-interims.ts:
+// 12 finals, head/tail revisions inside constant-start windows, and
+// finals that truncate the last interim so the next window re-emits words.
+// With verbatim-replace semantics the strip shows exactly the last
+// interim; a final commits to the feed but leaves the draft alone.
+describe('real Deepgram capture replay', () => {
+  const capture = captureFixture as Array<{
+    start: number;
+    duration: number;
+    is_final: boolean;
+    transcript: string;
+  }>;
+
+  it('always shows the last interim verbatim, across finals', () => {
+    let s = initialState;
+    let index = 0;
+    let lastInterim = '';
+    for (const m of capture) {
+      const segment = {
+        text: m.transcript.trim(),
+        start_s: m.start,
+        end_s: m.start + m.duration,
+      };
+      s = reduce(
+        s,
+        m.is_final
+          ? { type: 'final', index: index++, segment }
+          : { type: 'partial', segment },
+      );
+      if (!m.is_final) lastInterim = m.transcript.trim();
+      expect(draftText(s)).toBe(lastInterim);
+    }
+    expect(index).toBeGreaterThan(0);
+  });
+});
+
+describe('assists', () => {
+  const entry = () => ({
+    index: 0,
+    question: 'What is your name?',
+    points: [{ en: 'My name is ...', note: 'tên' }],
