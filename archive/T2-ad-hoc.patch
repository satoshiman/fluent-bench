+      question: 'Tell me about yourself',
+      points: [{ en: 'background', note: '' }],
+    });
+    expect(s.assists.map((a) => a.index)).toEqual([0, 3]);
+  });
+
+  it('dedupes assist entries by index', () => {
+    let s = reduce(base(), { type: 'assist', ...entry() });
+    s = reduce(s, { type: 'assist', ...entry() });
+    expect(s.assists).toHaveLength(1);
+    expect(s.assists[0]?.question).toBe('What is your name?');
+  });
+
+  it('keeps assist entries when the session ends', () => {
+    let s = reduce(base(), { type: 'assist', ...entry() });
+    s = reduce(s, { type: 'session', active: null });
+    expect(s.assists).toHaveLength(1);
+  });
+});
+
+describe('translationFeed', () => {
+  it('appends translations in arrival order', () => {
+    let s = reduce(base(), {
+      type: 'translation',
+      index: 1,
+      text: 'một',
+    });
+    s = reduce(s, { type: 'translation', index: 0, text: 'không' });
+    expect(s.translationFeed.map((e) => e.index)).toEqual([1, 0]);
+    expect(s.translations[0]).toBe('không');
+    expect(s.translations[1]).toBe('một');
+  });
+
+  it('dedups repeat translations for the same index', () => {
+    let s = reduce(base(), { type: 'translation', index: 0, text: 'a' });
+    s = reduce(s, { type: 'translation', index: 0, text: 'b' });
+    expect(s.translationFeed).toHaveLength(1);
+    expect(s.translations[0]).toBe('b');
+  });
+
+  it('clears the feed when the session ends', () => {
+    let s = reduce(base(), { type: 'translation', index: 0, text: 'a' });
+    s = reduce(s, { type: 'session', active: null });
+    expect(s.translationFeed).toHaveLength(0);
+  });
+});
