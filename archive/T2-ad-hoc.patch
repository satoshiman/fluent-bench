diff --git a/scripts/capture-interims.ts b/scripts/capture-interims.ts
new file mode 100644
index 0000000..bcaf20e
--- /dev/null
+++ b/scripts/capture-interims.ts
@@ -0,0 +1,111 @@
+// Debug capture: streams a WAV file through Deepgram's live API with the same
+// connect args as server/stt/deepgram.ts and logs EVERY raw Results message
+// (type, start, duration, is_final, speech_final, transcript) plus arrival
+// sequence and wall-clock offset, so interim behavior can be analyzed from
+// real data instead of assumed.
+// Usage: tsx scripts/capture-interims.ts [wav] [out.jsonl]
+import { readFile, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { DeepgramClient } from '@deepgram/sdk';
+import { loadConfig } from '../server/config.js';
+
+const WAV = path.resolve(process.argv[2] ?? path.join(import.meta.dirname, 'sample.wav'));
+const OUT = path.resolve(
+  process.argv[3] ?? path.join(os.tmpdir(), `capture-${Date.now()}.jsonl`),
+);
+const CHUNK_MS = 100;
+const TAIL_MS = 4_000;
+
+function extractPcm(wav: Buffer): Buffer {
+  if (wav.toString('ascii', 0, 4) !== 'RIFF') throw new Error('not a WAV file');
+  let off = 12;
+  while (off + 8 <= wav.length) {
+    const id = wav.toString('ascii', off, off + 4);
+    const size = wav.readUInt32LE(off + 4);
+    if (id === 'data') return wav.subarray(off + 8, off + 8 + size);
+    off += 8 + size + (size % 2);
+  }
+  throw new Error('no data chunk in WAV');
+}
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function main() {
+  const config = loadConfig();
+  const client = new DeepgramClient({ apiKey: config.DEEPGRAM_API_KEY });
+  const socket = (await client.listen.v1.connect({
+    model: 'nova-3',
+    language: 'en',
+    encoding: 'linear16',
+    sample_rate: 16000,
+    channels: 1,
+    interim_results: true,
+    smart_format: true,
+    endpointing: 300,
+    diarize: true,
+    Authorization: `Token ${config.DEEPGRAM_API_KEY}`,
+    reconnectAttempts: 0,
+  } as never)) as unknown as {
+    on(e: 'open' | 'close', cb: () => void): void;
+    on(e: 'message', cb: (m: unknown) => void): void;
+    on(e: 'error', cb: (e: Error) => void): void;
+    connect(): void;
+    sendMedia(c: ArrayBufferView): void;
+    sendCloseStream(m: { type: string }): void;
+    close(): void;
+  };
+
+  const t0 = Date.now();
+  const lines: string[] = [];
+  let seq = 0;
+  socket.on('message', (m) => {
+    const r = m as Record<string, unknown>;
+    if (r.type !== 'Results') {
+      lines.push(JSON.stringify({ seq: seq++, at: Date.now() - t0, raw: r }));
+      return;
+    }
+    const alt = (r.channel as { alternatives?: Array<{ transcript?: string; words?: unknown[] }> })
+      ?.alternatives?.[0];
+    lines.push(
+      JSON.stringify({
+        seq: seq++,
+        at: Date.now() - t0,
+        type: r.type,
+        start: r.start,
+        duration: r.duration,
+        is_final: r.is_final ?? false,
+        speech_final: r.speech_final ?? false,
+        words: alt?.words?.length ?? 0,
+        transcript: alt?.transcript ?? '',
+      }),
+    );
+  });
+  socket.on('error', (e) => {
+    lines.push(JSON.stringify({ seq: seq++, at: Date.now() - t0, error: String(e) }));
+  });
+  const closed = new Promise<void>((r) => socket.on('close', () => r()));
+  socket.connect();
+
+  await new Promise<void>((r) => socket.on('open', () => r()));
+  const pcm = extractPcm(await readFile(WAV));
+  const bytesPerChunk = 16000 * 2 * (CHUNK_MS / 1000);
+  for (let off = 0; off < pcm.length; off += bytesPerChunk) {
+    socket.sendMedia(pcm.subarray(off, off + bytesPerChunk));
+    await sleep(CHUNK_MS);
+  }
+  await sleep(TAIL_MS);
+  try {
+    socket.sendCloseStream({ type: 'CloseStream' });
+  } catch {}
+  socket.close();
+  await Promise.race([closed, sleep(2_000)]);
+
+  await writeFile(OUT, lines.join('\n') + '\n');
+  console.log(`wrote ${lines.length} messages -> ${OUT}`);
+}
+
+main().catch((err) => {
+  console.error(`CAPTURE FAIL: ${err instanceof Error ? err.message : err}`);
+  process.exit(1);
+});
diff --git a/scripts/dev.ts b/scripts/dev.ts
new file mode 100644
index 0000000..9183170
--- /dev/null
+++ b/scripts/dev.ts
@@ -0,0 +1,15 @@
+import 'dotenv/config';
+import { spawn } from 'node:child_process';
+
+const procs = [
+  spawn('npx', ['tsx', 'watch', 'server/index.ts'], { stdio: 'inherit' }),
+  spawn('npm', ['--prefix', 'web', 'run', 'dev'], { stdio: 'inherit' }),
+];
+
+function shutdown(code = 0) {
+  for (const p of procs) p.kill('SIGTERM');
+  process.exit(code);
+}
+process.on('SIGINT', () => shutdown(0));
+process.on('SIGTERM', () => shutdown(0));
+for (const p of procs) p.on('exit', (code) => shutdown(code ?? 1));
diff --git a/scripts/estimate-cost.ts b/scripts/estimate-cost.ts
new file mode 100644
index 0000000..9885589
--- /dev/null
+++ b/scripts/estimate-cost.ts
@@ -0,0 +1,69 @@
+// Prints the per-hour cost model derived from env config (BDR-002 launch
+// check, executable). Rates from ADR-002/ADR-003 as of 2026-11-05.
+// Usage: tsx scripts/estimate-cost.ts
+import { loadConfig } from '../server/config.js';
+
+const CEILING = 2.0;
+
+// USD per audio hour
+const STT_RATES: Record<string, { base: number; diarization: number; label: string }> = {
+  'nova-3': { base: 0.46, diarization: 0.12, label: 'Deepgram Nova-3 Monolingual' },
+  'nova-3-multilingual': { base: 0.55, diarization: 0.12, label: 'Deepgram Nova-3 Multilingual' },
+  assemblyai: { base: 0.15, diarization: 0, label: 'AssemblyAI Universal-Streaming' },
+};
+
+// USD per 1M tokens
+const LLM_RATES: Record<string, { input: number; output: number }> = {
+  'deepseek-flash': { input: 0.3, output: 1.2 },
+  'gpt-4.1-mini': { input: 0.4, output: 1.6 },
+};
+const LLM_DEFAULT = { input: 0.5, output: 2.0 };
+
+const SEGMENTS_PER_HOUR = 60;
+const INPUT_TOKENS_PER_SEGMENT = 2_000;
+const OUTPUT_TOKENS_PER_SEGMENT = 1_000;
+const KEYTERM_ADDON = 0.08;
+
+function sttCost(provider: string, diarize: boolean, model?: string) {
+  if (provider === 'assemblyai') {
+    return { label: STT_RATES.assemblyai!.label, rate: STT_RATES.assemblyai!.base };
+  }
+  const key = model && /multi/i.test(model) ? 'nova-3-multilingual' : 'nova-3';
+  const r = STT_RATES[key]!;
+  return { label: r.label, rate: r.base + (diarize ? r.diarization : 0) };
+}
+
+function llmCost(model: string) {
+  const r = LLM_RATES[model] ?? LLM_DEFAULT;
+  const inCost = (SEGMENTS_PER_HOUR * INPUT_TOKENS_PER_SEGMENT * r.input) / 1e6;
+  const outCost = (SEGMENTS_PER_HOUR * OUTPUT_TOKENS_PER_SEGMENT * r.output) / 1e6;
+  return inCost + outCost;
+}
+
+const config = loadConfig();
+const usd = (n: number) => `$${n.toFixed(3)}`;
+
+console.log('Per-hour cost model (from current env config)\n');
+
+const diarized = sttCost('deepgram', true, 'nova-3');
+console.log(`Typical session (diarized, ${diarized.label}):`);
+const llm = llmCost(config.TRANSLATE_MODEL);
+const total = diarized.rate + llm;
+console.log(`  STT         ${usd(diarized.rate)}/hr`);
+console.log(`  Translate   ${usd(llm)}/hr (${config.TRANSLATE_MODEL} via ${config.LLM_BASE_URL})`);
+console.log(`  ----------  -------------`);
+console.log(`  total       ${usd(total)}/hr  (ceiling ${usd(CEILING)})`);
+console.log(`  headroom    ${usd(CEILING - total)} for keyterm prompting (+${usd(KEYTERM_ADDON)}/hr) and price drift`);
+
+const cheap = sttCost('assemblyai', false);
+console.log(`\nLow-cost path (diarization off, ${cheap.label}):`);
+console.log(`  STT         ${usd(cheap.rate)}/hr`);
+console.log(`  total       ${usd(cheap.rate + llm)}/hr`);
+
+if (config.LLM_FALLBACK_BASE_URL) {
+  console.log(`\nFallback LLM (${config.LLM_FALLBACK_MODEL} via ${config.LLM_FALLBACK_BASE_URL}):`);
+  console.log(`  Translate   ${usd(llmCost(config.LLM_FALLBACK_MODEL))}/hr if engaged full-time`);
+}
+
+console.log(total <= CEILING ? '\nBUDGET: PASS' : '\nBUDGET: EXCEEDS CEILING');
+process.exit(total <= CEILING ? 0 : 1);
