@@ -0,0 +1,52 @@
+import type { ServerEvent } from './types';
+
+export class FluentSocket {
+  private ws?: WebSocket;
+  onEvent: (evt: ServerEvent) => void = () => {};
+  onOpenChange: (open: boolean) => void = () => {};
+
+  get isLive(): boolean {
+    return this.ws !== undefined && this.ws.readyState < WebSocket.CLOSING;
+  }
+
+  connect(): Promise<void> {
+    return new Promise((resolve, reject) => {
+      const proto = location.protocol === 'https:' ? 'wss' : 'ws';
+      const ws = new WebSocket(`${proto}://${location.host}/ws`);
+      this.ws = ws;
+      ws.binaryType = 'arraybuffer';
+      ws.onopen = () => {
+        this.onOpenChange(true);
+        resolve();
+      };
+      ws.onerror = () => {
+        this.onOpenChange(false);
+        reject(new Error('websocket connection failed'));
+      };
+      ws.onclose = () => this.onOpenChange(false);
+      ws.onmessage = (e) => {
+        if (typeof e.data !== 'string') return;
+        try {
+          this.onEvent(JSON.parse(e.data) as ServerEvent);
+        } catch {
+          // malformed server event; ignore
+        }
+      };
+    });
+  }
+
+  sendAudio(chunk: ArrayBuffer): void {
+    if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(chunk);
+  }
+
+  ping(): void {
+    if (this.ws?.readyState === WebSocket.OPEN) {
+      this.ws.send(JSON.stringify({ type: 'ping' }));
+    }
+  }
+
+  close(): void {
+    this.ws?.close();
+    this.ws = undefined;
+  }
+}
