+import { describe, expect, it } from 'vitest';
+import { buildContext, CONTEXT_MAX_SEGMENTS, type Translatable } from './translator.js';
+
+const seg = (text: string, speaker?: string): Translatable => ({
+  text,
+  ...(speaker ? { speaker } : {}),
+});
+
+describe('buildContext', () => {
+  it('returns at most the last K segments in order', () => {
+    const many = Array.from({ length: 20 }, (_, i) => seg(`segment ${i}`));
+    const ctx = buildContext(many, 5, 100_000);
+    expect(ctx.map((s) => s.text)).toEqual([
+      'segment 15',
+      'segment 16',
+      'segment 17',
+      'segment 18',
+      'segment 19',
+    ]);
+  });
+
+  it('respects the char cap by dropping the oldest segments', () => {
+    const segs = [
+      seg('x'.repeat(800)),
+      seg('y'.repeat(800)),
+      seg('z'.repeat(100)),
+    ];
+    const ctx = buildContext(segs, CONTEXT_MAX_SEGMENTS, 1000);
+    expect(ctx.map((s) => s.text)).toEqual(['y'.repeat(800), 'z'.repeat(100)]);
+  });
+
+  it('always keeps the newest segment even when it exceeds the cap', () => {
+    const segs = [seg('small'), seg('x'.repeat(5000))];
+    const ctx = buildContext(segs, 8, 100);
+    expect(ctx).toHaveLength(1);
+    expect(ctx[0]?.text).toBe('x'.repeat(5000));
+  });
+
+  it('handles empty input', () => {
+    expect(buildContext([])).toEqual([]);
+  });
+});
diff --git a/server/translate/translator.ts b/server/translate/translator.ts
new file mode 100644
index 0000000..2359d15
--- /dev/null
+++ b/server/translate/translator.ts
@@ -0,0 +1,47 @@
+export interface Translatable {
+  text: string;
+  speaker?: string;
+}
+
+export interface Translator {
+  translate(
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<string>;
+}
+
+export class TranslationError extends Error {
+  readonly code = 'TRANSLATION_FAILED';
+  constructor(
+    message: string,
+    readonly cause?: unknown,
+  ) {
+    super(message);
+    this.name = 'TranslationError';
+  }
+}
+
+export const CONTEXT_MAX_SEGMENTS = 8;
+export const CONTEXT_MAX_CHARS = 1500;
+
+// Rolling context (ADR-003): the last K finalized segments, char-capped so
+// input tokens stay bounded. ~3 chars/token is a conservative proxy.
+export function buildContext(
+  segments: readonly Translatable[],
+  maxSegments = CONTEXT_MAX_SEGMENTS,
+  maxChars = CONTEXT_MAX_CHARS,
+): Translatable[] {
+  const tail = segments.slice(-maxSegments);
+  const out: Translatable[] = [];
+  let chars = 0;
+  for (let i = tail.length - 1; i >= 0; i--) {
+    const seg = tail[i];
+    if (!seg) break;
+    const cost = seg.text.length + (seg.speaker ? seg.speaker.length + 4 : 0);
+    if (chars + cost > maxChars && out.length > 0) break;
+    chars += cost;
+    out.unshift(seg);
+  }
+  return out;
+}
