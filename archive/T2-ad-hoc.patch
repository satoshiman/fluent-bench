@@ -0,0 +1,485 @@
+import { useEffect, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useBlocker, useNavigate } from 'react-router';
+import {
+  AudioLines,
+  CircleHelp,
+  Mic,
+  Monitor,
+  Languages,
+  Square,
+  Users,
+  Tags,
+} from 'lucide-react';
+import { toast } from 'sonner';
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import {
+  Card,
+  CardAction,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from '@/components/ui/card';
+import {
+  Field,
+  FieldDescription,
+  FieldGroup,
+  FieldLabel,
+} from '@/components/ui/field';
+import { Input } from '@/components/ui/input';
+import { ScrollArea } from '@/components/ui/scroll-area';
+import {
+  Select,
+  SelectContent,
+  SelectGroup,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select';
+import { Switch } from '@/components/ui/switch';
+import {
+  listInputDevices,
+  type CaptureOptions,
+  type InputDevice,
+} from '@/audio/capture';
+import {
+  SourcePicker,
+  type SourceOption,
+} from '@/components/source-picker';
+import {
+  LiveStrip,
+  PipTranscript,
+  TranscriptEyeToggle,
+  TranscriptParagraphView,
+} from '@/components/transcript';
+import { groupSegments } from '@/lib/transcript-groups';
+import { useDocumentPiP } from '@/lib/use-document-pip';
+import { useLiveSession } from '@/lib/use-live-session';
+import type { StartSessionBody } from '@/lib/types';
+
+const TARGET_LANGS = [
+  ['vi', 'Vietnamese'],
+  ['zh', 'Chinese'],
+  ['ja', 'Japanese'],
+  ['ko', 'Korean'],
+  ['es', 'Spanish'],
+  ['fr', 'French'],
+  ['de', 'German'],
+  ['pt', 'Portuguese'],
+  ['ru', 'Russian'],
+  ['th', 'Thai'],
+] as const;
+
+const TAB_SOURCE = 'tab';
+
+export function LivePage() {
+  const navigate = useNavigate();
+  const {
+    state,
+    hasActiveSession,
+    start,
+    stop,
+    pause,
+    resume,
+    micMuted,
+    toggleMicMute,
+    toggleAssist,
+  } = useLiveSession({
+    onSessionEnded: (id) => navigate(`/sessions/${id}`),
+  });
+  const [targetLang, setTargetLang] = useState('vi');
+  const [diarize, setDiarize] = useState(true);
+  const [keyterms, setKeyterms] = useState('');
+  const [devices, setDevices] = useState<InputDevice[]>([]);
+  const [source, setSource] = useState('mic');
+  const [includeMic, setIncludeMic] = useState(true);
+  const [historyOn, setHistoryOn] = useState(false);
+  const [recordAudio, setRecordAudio] = useState(true);
+
+  const lag = state.finals.length - Object.keys(state.translations).length;
+
+  useEffect(() => {
+    const refresh = () => {
+      listInputDevices()
+        .then(setDevices)
+        .catch(() => {});
+    };
+    refresh();
+    navigator.mediaDevices.addEventListener('devicechange', refresh);
+    return () =>
+      navigator.mediaDevices.removeEventListener('devicechange', refresh);
+  }, []);
+
+  const {
+    supported: pipSupported,
+    pipWindow,
+    open: openPip,
+    close: closePip,
+  } = useDocumentPiP();
+
+  useEffect(() => {
+    if (!state.active) closePip();
+  }, [state.active, closePip]);
+
+  useEffect(() => () => closePip(), [closePip]);
+
+  // block in-app navigation while recording; the predicate reads the
+  // synchronous ref check so a stop() + navigate() in one continuation does
+  // not trip the guard on stale state
+  const blocker = useBlocker(
+    ({ currentLocation, nextLocation }) =>
+      hasActiveSession() &&
+      nextLocation.pathname !== currentLocation.pathname,
+  );
+
+  // router guards cannot intercept tab close/reload/typed-url exits
+  useEffect(() => {
+    if (state.active == null) return;
+    const warn = (e: BeforeUnloadEvent) => {
+      e.preventDefault();
+    };
+    window.addEventListener('beforeunload', warn);
+    return () => window.removeEventListener('beforeunload', warn);
+  }, [state.active]);
+
+  const leaveDialog = (
+    <AlertDialog
+      open={blocker.state === 'blocked'}
+      onOpenChange={(open) => {
+        if (!open) blocker.reset?.();
+      }}
+    >
+      <AlertDialogContent>
+        <AlertDialogHeader>
+          <AlertDialogTitle>Leave this page?</AlertDialogTitle>
+          <AlertDialogDescription>
+            A session is still recording. Leaving will stop it.
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        <AlertDialogFooter>
+          <AlertDialogCancel onClick={() => blocker.reset?.()}>
+            Stay
+          </AlertDialogCancel>
+          <AlertDialogAction onClick={() => blocker.proceed?.()}>
+            Leave and stop
+          </AlertDialogAction>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+
+  const sourceOptions: SourceOption[] = [
+    {
+      value: 'mic',
+      title: 'Default microphone',
+      description: 'System default input',
+      icon: Mic,
+    },
+    ...devices
+      .filter((d) => d.deviceId !== 'default')
+      .map((d, i) => ({
+        value: `device:${d.deviceId}`,
+        title: d.label || `Microphone ${i + 1}`,
+        description: 'Audio input device',
+        icon: Mic,
+      })),
+    {
+      value: TAB_SOURCE,
+      title: 'Browser tab audio',
+      description: 'Chrome/Edge tab share',
+      icon: Monitor,
+    },
+  ];
+
+  const startSession = () => {
+    let audioSource = 'mic';
+    let capture: CaptureOptions = { kind: 'mic' };
+    if (source === TAB_SOURCE) {
+      audioSource = includeMic ? 'tab+mic' : 'tab';
+      capture = { kind: 'tab', includeMic };
+    } else if (source.startsWith('device:')) {
+      const deviceId = source.slice('device:'.length);
+      const label =
+        devices.find((d) => d.deviceId === deviceId)?.label ?? 'input';
+      audioSource = `device:${label}`.slice(0, 40);
+      capture = { kind: 'device', deviceId };
+    }
+    const body: StartSessionBody = {
+      targetLang,
+      diarize,
+      audioSource,
+      recordAudio,
+      ...(keyterms.trim()
+        ? {
+            keyterms: keyterms
+              .split(',')
+              .map((k) => k.trim())
+              .filter(Boolean),
+          }
+        : {}),
+    };
+    void start(body, capture).catch(() => {});
+  };
+
+  if (!state.active) {
+    return (
+      <div className="mx-auto flex max-w-lg flex-col gap-6 pt-10">
+        <Card>
+          <CardHeader>
+            <CardTitle>Start a session</CardTitle>
+            <CardDescription>
+              Live English transcription with translation. Audio leaves this
+              machine only to the configured STT and LLM APIs.
+            </CardDescription>
+          </CardHeader>
+          <CardContent>
+            <FieldGroup>
+              <Field>
+                <FieldLabel>
+                  <Mic className="size-3.5 text-muted-foreground" />
+                  Audio source
+                </FieldLabel>
+                <SourcePicker
+                  options={sourceOptions}
+                  value={source}
+                  onChange={setSource}
+                />
+                {source === TAB_SOURCE ? (
+                  <FieldDescription>
+                    Pick a browser tab in the share dialog and enable "Share
+                    tab audio"; sharing the whole screen often has no audio.
+                  </FieldDescription>
+                ) : null}
+              </Field>
+              {source === TAB_SOURCE ? (
+                <Field orientation="horizontal">
+                  <div className="flex flex-1 flex-col gap-1">
+                    <FieldLabel htmlFor="include-mic">
+                      Include my microphone
+                    </FieldLabel>
+                    <FieldDescription>
+                      Mix your mic into the same stream so diarization can
+                      separate you from remote speakers.
+                    </FieldDescription>
+                  </div>
+                  <Switch
+                    id="include-mic"
+                    checked={includeMic}
+                    onCheckedChange={(v) => setIncludeMic(v === true)}
+                  />
+                </Field>
+              ) : null}
+              <Field>
+                <FieldLabel>
+                  <Languages className="size-3.5 text-muted-foreground" />
+                  Target language
+                </FieldLabel>
+                <Select
+                  value={targetLang}
+                  onValueChange={(v) => setTargetLang(v as string)}
+                >
+                  <SelectTrigger className="w-full">
+                    <SelectValue />
+                  </SelectTrigger>
+                  <SelectContent>
+                    <SelectGroup>
+                      {TARGET_LANGS.map(([code, name]) => (
+                        <SelectItem key={code} value={code}>
+                          {name} ({code})
+                        </SelectItem>
+                      ))}
+                    </SelectGroup>
+                  </SelectContent>
+                </Select>
+              </Field>
+              <Field orientation="horizontal">
+                <div className="flex flex-1 flex-col gap-1">
+                  <FieldLabel htmlFor="diarize">
+                    <Users className="size-3.5 text-muted-foreground" />
+                    Speaker diarization
+                  </FieldLabel>
+                  <FieldDescription>
+                    Label speakers (uses Deepgram). Off uses the low-cost
+                    AssemblyAI path when its key is configured.
+                  </FieldDescription>
+                </div>
+                <Switch
+                  id="diarize"
+                  checked={diarize}
+                  onCheckedChange={(v) => setDiarize(v === true)}
+                />
+              </Field>
+              <Field orientation="horizontal">
+                <div className="flex flex-1 flex-col gap-1">
+                  <FieldLabel htmlFor="record-audio">
+                    <AudioLines className="size-3.5 text-muted-foreground" />
+                    Record audio
+                  </FieldLabel>
+                  <FieldDescription>
+                    On by default (BDR-005): saves a WAV next to the
+                    transcript (~115 MB/hour) and enables playback with
+                    click-to-seek in Review.
+                  </FieldDescription>
+                </div>
+                <Switch
+                  id="record-audio"
+                  checked={recordAudio}
+                  onCheckedChange={(v) => setRecordAudio(v === true)}
+                />
+              </Field>
+              <Field>
+                <FieldLabel htmlFor="keyterms">
+                  <Tags className="size-3.5 text-muted-foreground" />
+                  Keyterms (optional)
+                </FieldLabel>
+                <Input
+                  id="keyterms"
+                  placeholder="names or domain terms, comma-separated"
+                  value={keyterms}
+                  onChange={(e) => setKeyterms(e.target.value)}
+                />
+              </Field>
+              <Button disabled={state.starting} onClick={startSession}>
+                <Mic data-icon="inline-start" />
+                {state.starting ? 'Starting…' : 'Start session'}
+              </Button>
+            </FieldGroup>
+          </CardContent>
+        </Card>
+        {leaveDialog}
+      </div>
+    );
+  }
+
+  const stripProps = {
+    feed: state.finals,
+    paused: state.active.paused,
+    draft: state.draft,
+    translationFeed: state.translationFeed,
+    assists: state.assists,
+    micMuted,
+    hasMic: source !== 'tab' || includeMic,
+    onToggleMicMute: toggleMicMute,
+    onTogglePause: () => void (state.active?.paused ? resume() : pause()),
+    assistActive: state.active.assist,
+    onToggleAssist: () => void toggleAssist(),
+  };
+
+  return (
+    <div className="flex h-full flex-col gap-3">
+      <div className="flex flex-wrap items-center gap-2">
+        <Badge variant="secondary" className="font-mono">
+          {state.active.id}
+        </Badge>
+        <Badge variant="outline">{state.active.stt_provider}</Badge>
+        {state.active.model ? (
+          <Badge variant="outline">{state.active.model}</Badge>
+        ) : null}
+        <Badge variant="outline">
+          <Languages data-icon="inline-start" />
+          en → {state.active.target_lang}
+        </Badge>
+        <Badge variant="outline">
+          <Users data-icon="inline-start" />
+          {state.active.diarization ? 'diarization on' : 'diarization off'}
+        </Badge>
+        <Badge
+          variant={lag > 2 ? 'destructive' : 'outline'}
+          title="segments awaiting translation"
+        >
+          lag {lag}
+        </Badge>
+        {state.active.record_audio ? (
+          <Badge variant="secondary">
+            <AudioLines data-icon="inline-start" />
+            rec
+          </Badge>
+        ) : null}
+        {state.active.assist ? (
+          <Badge variant="secondary">
+            <CircleHelp data-icon="inline-start" />
+            assist on
+          </Badge>
+        ) : null}
+        {state.active.paused ? <Badge variant="secondary">paused</Badge> : null}
+        <Button
+          variant="destructive"
+          size="sm"
+          className="ml-auto"
+          onClick={() => void stop()}
+          title="Stop session"
+        >
+          <Square data-icon="inline-start" />
+          Stop
+        </Button>
+      </div>
+
+      <LiveStrip
+        {...stripProps}
+        pipActive={pipWindow != null}
+        onTogglePip={
+          pipSupported
+            ? () =>
+                void (pipWindow
+                  ? closePip()
+                  : openPip().catch(() =>
+                      toast.error('Could not open floating window'),
+                    ))
+            : undefined
+        }
+      />
+
+      {pipWindow
+        ? createPortal(
+            <PipTranscript {...stripProps} />,
+            pipWindow.document.body,
+          )
+        : null}
+
+      <Card className={historyOn ? 'flex min-h-0 flex-1 flex-col' : undefined}>
+        <CardHeader className="pb-2">
+          <CardTitle className="text-sm uppercase tracking-wide text-muted-foreground">
+            Transcript
+          </CardTitle>
+          <CardAction>
+            <TranscriptEyeToggle
+              transcriptOn={historyOn}
+              onToggle={() => setHistoryOn((on) => !on)}
+            />
+          </CardAction>
+        </CardHeader>
+        {historyOn ? (
+          <CardContent className="min-h-0 flex-1 p-0">
+            <ScrollArea className="h-full px-6 pb-4">
+              <div className="flex flex-col gap-4">
+                {groupSegments(state.finals)
+                  .slice()
+                  .reverse()
+                  .map((paragraph, i) => (
+                    <TranscriptParagraphView
+                      key={`${paragraph.entries[0]?.index ?? i}`}
+                      paragraph={paragraph}
+                      translations={state.translations}
+                    />
+                  ))}
+              </div>
+            </ScrollArea>
+          </CardContent>
+        ) : null}
+      </Card>
+      {leaveDialog}
+    </div>
+  );
+}
