@@ -0,0 +1,106 @@
+import * as fs from 'node:fs/promises';
+import type { FileHandle } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface WavRecorderOptions {
+  sampleRate?: number;
+  channels?: number;
+  bitsPerSample?: number;
+}
+
+const HEADER_SIZE = 44;
+
+function wavHeader(opts: Required<WavRecorderOptions>): Buffer {
+  const { sampleRate, channels, bitsPerSample } = opts;
+  const blockAlign = (channels * bitsPerSample) / 8;
+  const byteRate = sampleRate * blockAlign;
+  const h = Buffer.alloc(HEADER_SIZE);
+  h.write('RIFF', 0, 'ascii');
+  h.writeUInt32LE(36, 4); // 36 + dataSize, patched on finalize
+  h.write('WAVE', 8, 'ascii');
+  h.write('fmt ', 12, 'ascii');
+  h.writeUInt32LE(16, 16); // fmt chunk size
+  h.writeUInt16LE(1, 20); // PCM
+  h.writeUInt16LE(channels, 22);
+  h.writeUInt32LE(sampleRate, 24);
+  h.writeUInt32LE(byteRate, 28);
+  h.writeUInt16LE(blockAlign, 32);
+  h.writeUInt16LE(bitsPerSample, 34);
+  h.write('data', 36, 'ascii');
+  h.writeUInt32LE(0, 40); // dataSize, patched on finalize
+  return h;
+}
+
+// Opt-in session audio capture (PLAN-010): appends the same linear16 PCM
+// that goes to the STT stream into a canonical WAV so the Review page can
+// replay it. Writes are serialized like MarkdownSessionWriter's queue so
+// chunks land in arrival order.
+export class WavRecorder {
+  private queue: Promise<unknown> = Promise.resolve();
+  private fh: FileHandle | null = null;
+  private payloadBytes = 0;
+  private done = false;
+
+  private constructor(
+    private readonly filePath: string,
+    private readonly opts: Required<WavRecorderOptions>,
+  ) {}
+
+  static async create(
+    filePath: string,
+    opts: WavRecorderOptions = {},
+  ): Promise<WavRecorder> {
+    const full: Required<WavRecorderOptions> = {
+      sampleRate: opts.sampleRate ?? 16_000,
+      channels: opts.channels ?? 1,
+      bitsPerSample: opts.bitsPerSample ?? 16,
+    };
+    const rec = new WavRecorder(filePath, full);
+    await fs.mkdir(path.dirname(filePath), { recursive: true });
+    rec.fh = await fs.open(filePath, 'wx');
+    await rec.fh.write(wavHeader(full));
+    return rec;
+  }
+
+  append(chunk: Buffer): Promise<void> {
+    return this.enqueue(async () => {
+      if (!this.fh || this.done) return;
+      await this.fh.write(chunk);
+      this.payloadBytes += chunk.length;
+    });
+  }
+
+  get bytesWritten(): number {
+    return this.payloadBytes;
+  }
+
+  async finalize(): Promise<void> {
+    await this.enqueue(async () => {
+      if (!this.fh || this.done) return;
+      this.done = true;
+      const sizes = Buffer.alloc(4);
+      sizes.writeUInt32LE(36 + this.payloadBytes, 0);
+      await this.fh.write(sizes, 0, 4, 4);
+      sizes.writeUInt32LE(this.payloadBytes, 0);
+      await this.fh.write(sizes, 0, 4, 40);
+      await this.fh.close();
+      this.fh = null;
+    });
+  }
+
+  async abort(): Promise<void> {
+    await this.enqueue(async () => {
+      this.done = true;
+      const fh = this.fh;
+      this.fh = null;
+      if (fh) await fh.close();
+      await fs.unlink(this.filePath).catch(() => {});
+    });
+  }
+
+  private enqueue<T>(op: () => Promise<T>): Promise<T> {
+    const run = this.queue.then(op);
+    this.queue = run.catch(() => {});
+    return run;
+  }
+}
