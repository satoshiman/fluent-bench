+import { describe, expect, it } from 'vitest';
+import {
+  parseFrontmatter,
+  renderFrontmatter,
+  sessionIdFor,
+  type SessionMeta,
+} from './markdown.js';
+
+const meta = (id: string): SessionMeta => ({
+  id,
+  started_at: '2026-11-05T10:00:00.000Z',
+  ended_at: null,
+  source_lang: 'en',
+  target_lang: 'vi',
+  stt_provider: 'deepgram',
+  model: 'nova-3',
+  diarization: true,
+  audio_source: null,
+  audio_file: null,
+  speakers: {},
+  duration_s: null,
+});
+
+describe('frontmatter round-trip', () => {
+  it('renders all metadata keys', () => {
+    const id = '2026-11-05-session-1000';
+    const { meta: parsed } = parseFrontmatter(
+      `${renderFrontmatter(meta(id))}\n`,
+    );
+    for (const key of [
+      'id',
+      'started_at',
+      'ended_at',
+      'source_lang',
+      'target_lang',
+      'stt_provider',
+      'model',
+      'diarization',
+      'speakers',
+      'duration_s',
+    ]) {
+      expect(parsed).toHaveProperty(key);
+    }
+    expect(parsed.id).toBe(id);
+    expect(parsed.diarization).toBe(true);
+    expect(parsed.speakers).toEqual({});
+  });
+
+  it('serializes audio_source for debugging the capture path', () => {
+    const m = meta('2026-11-05-session-1000');
+    m.audio_source = 'tab+mic';
+    const { meta: parsed } = parseFrontmatter(`${renderFrontmatter(m)}\n`);
+    expect(parsed.audio_source).toBe('tab+mic');
+  });
+
+  it('serializes audio_file when session audio was recorded', () => {
+    const m = meta('2026-11-05-session-1000');
+    m.audio_file = 'session-1000.wav';
+    const { meta: parsed } = parseFrontmatter(`${renderFrontmatter(m)}\n`);
+    expect(parsed.audio_file).toBe('session-1000.wav');
+  });
+
+  it('parseFrontmatter inverts renderFrontmatter', () => {
+    const m = meta('2026-11-05-session-1000');
+    m.speakers = { 'Speaker 1': 'Alice', 'Speaker 2': 'Bob "B"' };
+    const rendered = renderFrontmatter(m);
+    const { meta: parsed } = parseFrontmatter(`${rendered}\n\nbody\n`);
+    expect(parsed).toEqual({ ...m });
+  });
+});
+
+describe('sessionIdFor', () => {
+  it('formats <date>-<slug>-<HHmm>', () => {
+    const d = new Date('2026-11-05T10:07:30.000Z');
+    expect(sessionIdFor(d, 'session')).toBe('2026-11-05-session-1007');
+  });
+});
diff --git a/server/session/markdown.ts b/server/session/markdown.ts
new file mode 100644
index 0000000..ecf4eb0
--- /dev/null
+++ b/server/session/markdown.ts
@@ -0,0 +1,135 @@
+import path from 'node:path';
+
+export interface SessionMeta {
+  id: string;
+  started_at: string;
+  ended_at: string | null;
+  source_lang: string;
+  target_lang: string;
+  stt_provider: string;
+  model: string | null;
+  diarization: boolean;
+  audio_source: string | null;
+  audio_file: string | null;
+  speakers: Record<string, string>;
+  duration_s: number | null;
+}
+
+const META_KEY_ORDER: Array<keyof SessionMeta> = [
+  'id',
+  'started_at',
+  'ended_at',
+  'source_lang',
+  'target_lang',
+  'stt_provider',
+  'model',
+  'diarization',
+  'audio_source',
+  'audio_file',
+  'speakers',
+  'duration_s',
+];
+
+export function sessionIdFor(date: Date, slug: string): string {
+  const day = date.toISOString().slice(0, 10);
+  const hhmm = date.toISOString().slice(11, 16).replace(':', '');
+  return `${day}-${slug}-${hhmm}`;
+}
+
+export function filePathFor(rootDir: string, id: string): string {
+  const m = /^(\d{4}-\d{2}-\d{2})-(.+)$/.exec(id);
+  if (!m) throw new Error(`invalid session id: ${id}`);
+  return path.join(rootDir, m[1]!, `${m[2]!}.md`);
+}
+
+// Optional session audio (PLAN-010): the WAV is a sibling of the .md,
+// identical stem, referenced from the `audio_file` frontmatter key.
+export function wavPathFor(rootDir: string, id: string): string {
+  return filePathFor(rootDir, id).replace(/\.md$/, '.wav');
+}
+
+// The transcript artifact (ADR-007): a bilingual .srt sibling of the .md.
+export function srtPathFor(rootDir: string, id: string): string {
+  return filePathFor(rootDir, id).replace(/\.md$/, '.srt');
+}
+
+function yamlScalar(v: string | number | boolean | null): string {
+  if (v === null) return 'null';
+  if (typeof v === 'string') return JSON.stringify(v);
+  return String(v);
+}
+
+export function renderFrontmatter(meta: SessionMeta): string {
+  const lines: string[] = ['---'];
+  for (const key of META_KEY_ORDER) {
+    const v = meta[key];
+    if (key === 'speakers') {
+      const map = v as Record<string, string>;
+      if (Object.keys(map).length === 0) {
+        lines.push('speakers: {}');
+        continue;
+      }
+      lines.push('speakers:');
+      for (const [label, name] of Object.entries(map)) {
+        lines.push(`  ${JSON.stringify(label)}: ${JSON.stringify(name)}`);
+      }
+      continue;
+    }
+    lines.push(`${key}: ${yamlScalar(v as string | number | boolean | null)}`);
+  }
+  lines.push('---');
+  return lines.join('\n');
+}
+
+// Parses the YAML subset this module emits: flat scalars plus one nested map
+// level (used for `speakers`). Files are machine-written by us, so a full
+// YAML parser is unnecessary (and not a pinned dep per ADR-006).
+export function parseFrontmatter(md: string): {
+  meta: Record<string, unknown>;
+  body: string;
+} {
+  const lines = md.split('\n');
+  if (lines[0]?.trim() !== '---') return { meta: {}, body: md };
+  const meta: Record<string, unknown> = {};
+  let i = 1;
+  let currentMap: Record<string, string> | undefined;
+  for (; i < lines.length; i++) {
+    const line = lines[i]!;
+    if (line.trim() === '---') {
+      i += 1;
+      break;
+    }
+    const nested = /^ {2}("(?:[^"\\]|\\.)*"): ("(?:[^"\\]|\\.)*")$/.exec(line);
+    if (nested && currentMap) {
+      currentMap[JSON.parse(nested[1]!) as string] = JSON.parse(nested[2]!) as string;
+      continue;
+    }
+    const kv = /^([A-Za-z_]+):(?: (.*))?$/.exec(line);
+    if (!kv) continue;
+    const key = kv[1]!;
+    const raw = kv[2] ?? '';
+    if (raw === '' || raw === '{}') {
+      currentMap = {};
+      meta[key] = currentMap;
+      continue;
+    }
+    currentMap = undefined;
+    meta[key] = parseScalar(raw);
+  }
+  return { meta, body: lines.slice(i).join('\n') };
+}
+
+function parseScalar(raw: string): unknown {
+  if (raw === 'null') return null;
+  if (raw === 'true') return true;
+  if (raw === 'false') return false;
+  if (raw.startsWith('"')) {
+    try {
+      return JSON.parse(raw);
+    } catch {
+      return raw;
+    }
+  }
+  const n = Number(raw);
+  return Number.isNaN(n) ? raw : n;
+}
diff --git a/server/session/routes.ts b/server/session/routes.ts
new file mode 100644
index 0000000..d299d3f
--- /dev/null
+++ b/server/session/routes.ts
@@ -0,0 +1,124 @@
+import { createReadStream } from 'node:fs';
+import { stat } from 'node:fs/promises';
+import type { FastifyInstance } from 'fastify';
+import { z } from 'zod';
+import type { SessionManager } from './manager.js';
+import { wavPathFor } from './markdown.js';
+import { listSessions, readSession } from './store.js';
+
+const startSchema = z.object({
+  targetLang: z.string().min(1).max(60).optional(),
+  diarize: z.boolean().optional(),
+  model: z.string().min(1).max(80).optional(),
+  keyterms: z.array(z.string().min(1).max(80)).max(50).optional(),
+  slug: z
+    .string()
+    .regex(/^[a-z0-9-]+$/)
+    .max(40)
+    .optional(),
+  audioSource: z.string().min(1).max(40).optional(),
+  recordAudio: z.boolean().optional(),
+});
+
+const renameSchema = z.object({
+  map: z.record(z.string().min(1).max(60), z.string().min(1).max(80)),
+});
+
+const assistSchema = z.object({ enabled: z.boolean() });
+
+export function registerSessionRoutes(
+  app: FastifyInstance,
+  sessions: SessionManager,
+): void {
+  app.post('/api/sessions', async (req, reply) => {
+    const body = startSchema.parse(req.body ?? {});
+    const info = await sessions.start(body);
+    return reply.code(201).send(info);
+  });
+
+  app.post('/api/sessions/:id/stop', async (req) => {
+    const { id } = req.params as { id: string };
+    await sessions.stop(id);
+    return { ok: true };
+  });
+
+  app.post('/api/sessions/:id/pause', async (req) => {
+    const { id } = req.params as { id: string };
+    await sessions.pause(id);
+    return { ok: true };
+  });
+
+  app.post('/api/sessions/:id/resume', async (req) => {
+    const { id } = req.params as { id: string };
+    await sessions.resume(id);
+    return { ok: true };
+  });
+
+  app.post('/api/sessions/:id/assist', async (req) => {
+    const { id } = req.params as { id: string };
+    const { enabled } = assistSchema.parse(req.body ?? {});
+    await sessions.setAssist(id, enabled);
+    return { ok: true };
+  });
+
+  app.get('/api/sessions', async () => ({
+    active: sessions.current(),
+    sessions: await listSessions(sessions.dir),
+  }));
+
+  app.get('/api/sessions/:id', async (req, reply) => {
+    const { id } = req.params as { id: string };
+    const stored = await readSession(sessions.dir, id);
+    if (!stored) {
+      return reply.code(404).send({ error: `session not found: ${id}` });
+    }
+    return stored;
+  });
+
+  // Optional session audio (PLAN-010): only sessions whose frontmatter
+  // carries `audio_file` have a WAV to serve. Single-range support is all
+  // the <audio> element needs for seek.
+  app.get('/api/sessions/:id/audio', async (req, reply) => {
+    const { id } = req.params as { id: string };
+    const stored = await readSession(sessions.dir, id);
+    if (!stored || !stored.meta.audio_file) {
+      return reply.code(404).send({ error: `no audio for session: ${id}` });
+    }
+    const file = wavPathFor(sessions.dir, id);
+    const size = (await stat(file).catch(() => null))?.size;
+    if (size == null) {
+      return reply.code(404).send({ error: `no audio for session: ${id}` });
+    }
+    void reply
+      .header('Content-Type', 'audio/wav')
+      .header('Accept-Ranges', 'bytes');
+    const range = /^bytes=(\d+)-(\d*)$/.exec(
+      String(req.headers.range ?? ''),
+    );
+    if (range) {
+      const start = Number(range[1]);
+      const end = range[2] ? Math.min(Number(range[2]), size - 1) : size - 1;
+      if (start >= size || start > end) {
+        return reply
+          .code(416)
+          .header('Content-Range', `bytes */${size}`)
+          .send({ error: 'range not satisfiable' });
+      }
+      return reply
+        .code(206)
+        .header('Content-Range', `bytes ${start}-${end}/${size}`)
+        .header('Content-Length', end - start + 1)
+        .send(createReadStream(file, { start, end }));
+    }
+    return reply
+      .header('Content-Length', size)
+      .send(createReadStream(file));
+  });
+
+  app.patch('/api/sessions/:id/speakers', async (req) => {
+    const { id } = req.params as { id: string };
+    const { map } = renameSchema.parse(req.body ?? {});
+    await sessions.renameSpeakers(id, map);
+    return { ok: true };
+  });
+}
