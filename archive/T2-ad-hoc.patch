+import { describe, expect, it } from 'vitest';
+import {
+  cueCount,
+  formatCue,
+  formatSrtTimestamp,
+  insertTranslationLine,
+} from './srt.js';
+
+describe('formatSrtTimestamp', () => {
+  it('formats HH:MM:SS,mmm with ms rounding', () => {
+    expect(formatSrtTimestamp(2)).toBe('00:00:02,000');
+    expect(formatSrtTimestamp(4.8)).toBe('00:00:04,800');
+    expect(formatSrtTimestamp(0.1234)).toBe('00:00:00,123');
+    expect(formatSrtTimestamp(0.1235)).toBe('00:00:00,124');
+  });
+
+  it('keeps zero-padded hours past one hour', () => {
+    expect(formatSrtTimestamp(3725.25)).toBe('01:02:05,250');
+    expect(formatSrtTimestamp(36_000)).toBe('10:00:00,000');
+  });
+
+  it('clamps negative input to zero', () => {
+    expect(formatSrtTimestamp(-3)).toBe('00:00:00,000');
+  });
+});
+
+describe('formatCue', () => {
+  it('emits a numbered cue block ending in a blank line', () => {
+    const cue = formatCue(
+      0,
+      { text: 'Hello.', start_s: 2, end_s: 4.8 },
+      'Speaker 1',
+    );
+    expect(cue).toBe(
+      '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\n\n',
+    );
+  });
+
+  it('omits the speaker prefix when none is given', () => {
+    const cue = formatCue(4, { text: 'Hi.', start_s: 1, end_s: 2 });
+    expect(cue).toBe('5\n00:00:01,000 --> 00:00:02,000\nHi.\n\n');
+  });
+
+  it('flattens embedded newlines so the block stays intact', () => {
+    const cue = formatCue(
+      0,
+      { text: 'line one\nline two', start_s: 0, end_s: 1 },
+    );
+    expect(cue).toContain('line one line two');
+    expect(cue.split('\n\n')).toHaveLength(2);
+  });
+});
+
+describe('insertTranslationLine', () => {
+  const srt = [
+    '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.',
+    '2\n00:00:05,100 --> 00:00:08,200\nHi there.',
+    '3\n00:00:09,000 --> 00:00:10,000\nBye.',
+    '',
+  ].join('\n\n');
+
+  it('splices a translation into a middle cue', () => {
+    const out = insertTranslationLine(srt, 1, 'Chào.');
+    expect(out).toBe(
+      [
+        '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.',
+        '2\n00:00:05,100 --> 00:00:08,200\nHi there.\nChào.',
+        '3\n00:00:09,000 --> 00:00:10,000\nBye.',
+        '',
+      ].join('\n\n'),
+    );
+  });
+
+  it('returns null when the cue is missing', () => {
+    expect(insertTranslationLine(srt, 9, 'x')).toBeNull();
+    expect(insertTranslationLine('', 0, 'x')).toBeNull();
+  });
+
+  it('returns null when the cue already has a translation line', () => {
+    const withTr = insertTranslationLine(srt, 0, 'Xin chào.')!;
+    expect(insertTranslationLine(withTr, 0, 'again')).toBeNull();
+  });
+
+  it('flattens newlines inside the translation', () => {
+    const out = insertTranslationLine(srt, 2, 'a\nb')!;
+    expect(out).toContain('Bye.\na b');
+  });
+});
+
+describe('cueCount', () => {
+  it('counts ` --> ` lines', () => {
+    expect(cueCount('')).toBe(0);
+    expect(
+      cueCount(
+        '1\n00:00:02,000 --> 00:00:04,800\nHi.\n\n' +
+          '2\n00:00:05,000 --> 00:00:06,000\nYo.\n\n',
+      ),
+    ).toBe(2);
+  });
+});
diff --git a/server/session/srt.ts b/server/session/srt.ts
new file mode 100644
index 0000000..1a13808
--- /dev/null
+++ b/server/session/srt.ts
@@ -0,0 +1,68 @@
+import type { Segment } from '../stt/provider.js';
+
+// SRT cue helpers (ADR-007): one numbered cue per segment, source text on
+// the first text line, translation spliced in as the last text line when it
+// arrives. Cue number = segment index + 1, permanently binding the cue to
+// the zero-based socket event index.
+
+// `HH:MM:SS,mmm` - hours always zero-padded (SRT convention).
+export function formatSrtTimestamp(s: number): string {
+  const total = Math.max(0, Math.round(s * 1000));
+  const hh = Math.floor(total / 3_600_000);
+  const mm = Math.floor((total % 3_600_000) / 60_000);
+  const ss = Math.floor((total % 60_000) / 1000);
+  const mmm = total % 1000;
+  const pad = (n: number, w = 2) => String(n).padStart(w, '0');
+  return `${pad(hh)}:${pad(mm)}:${pad(ss)},${pad(mmm, 3)}`;
+}
+
+// A blank line would corrupt the block structure, so embedded newlines
+// collapse to spaces.
+function oneLine(text: string): string {
+  return text.replace(/\s*\n\s*/g, ' ');
+}
+
+export function formatCue(
+  index: number,
+  seg: Segment,
+  speakerName?: string,
+): string {
+  const prefix = speakerName ? `${speakerName}: ` : '';
+  return [
+    String(index + 1),
+    `${formatSrtTimestamp(seg.start_s)} --> ${formatSrtTimestamp(seg.end_s)}`,
+    `${prefix}${oneLine(seg.text)}`,
+    '',
+    '',
+  ].join('\n');
+}
+
+// Inserts `text` as the last text line of cue `index + 1`. Returns null when
+// the cue is missing or already carries a second text line (a landed
+// translation); the caller logs and skips the write.
+export function insertTranslationLine(
+  srt: string,
+  index: number,
+  text: string,
+): string | null {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const target = String(index + 1);
+  for (let i = 0; i < blocks.length; i++) {
+    const lines = blocks[i]!.split('\n');
+    if (lines[0]?.trim() !== target) continue;
+    if (!lines[1]?.includes(' --> ')) continue;
+    if (lines.length > 3) return null;
+    lines.push(oneLine(text));
+    blocks[i] = lines.join('\n');
+    return `${blocks.join('\n\n')}\n\n`;
+  }
+  return null;
+}
+
+export function cueCount(srt: string): number {
+  let n = 0;
+  for (const line of srt.split('\n')) {
+    if (line.includes(' --> ')) n++;
+  }
+  return n;
+}
diff --git a/server/session/store.ts b/server/session/store.ts
new file mode 100644
index 0000000..f72d700
--- /dev/null
+++ b/server/session/store.ts
@@ -0,0 +1,121 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import {
+  filePathFor,
+  parseFrontmatter,
+  srtPathFor,
+} from './markdown.js';
+import { cueCount } from './srt.js';
+
+export interface SessionSummary {
+  id: string;
+  file: string;
+  started_at: string | null;
+  ended_at: string | null;
+  source_lang: string;
+  target_lang: string;
+  stt_provider: string;
+  model: string | null;
+  diarization: boolean;
+  audio_file: string | null;
+  speakers: Record<string, string>;
+  duration_s: number | null;
+  segments: number;
+}
+
+export interface StoredSession {
+  meta: SessionSummary;
+  srt: string;
+  assist: string;
+}
+
+function toSummary(
+  meta: Record<string, unknown>,
+  file: string,
+  segments: number,
+): SessionSummary {
+  const speakers =
+    meta['speakers'] && typeof meta['speakers'] === 'object'
+      ? (meta['speakers'] as Record<string, string>)
+      : {};
+  return {
+    id: String(meta['id'] ?? ''),
+    file,
+    started_at: (meta['started_at'] as string | null) ?? null,
+    ended_at: (meta['ended_at'] as string | null) ?? null,
+    source_lang: String(meta['source_lang'] ?? 'en'),
+    target_lang: String(meta['target_lang'] ?? ''),
+    stt_provider: String(meta['stt_provider'] ?? ''),
+    model: (meta['model'] as string | null) ?? null,
+    diarization: meta['diarization'] === true,
+    audio_file: (meta['audio_file'] as string | null) ?? null,
+    speakers,
+    duration_s: typeof meta['duration_s'] === 'number' ? meta['duration_s'] : null,
+    segments,
+  };
+}
+
+async function readSrt(path: string): Promise<string> {
+  try {
+    return await fs.readFile(path, 'utf8');
+  } catch {
+    return '';
+  }
+}
+
+// Session discovery is a plain filesystem listing, newest first (ADR-004).
+// The transcript lives in the sibling .srt (ADR-007); the .md frontmatter
+// remains the bundle's metadata anchor.
+export async function listSessions(rootDir: string): Promise<SessionSummary[]> {
+  const out: SessionSummary[] = [];
+  let days: string[] = [];
+  try {
+    days = (await fs.readdir(rootDir)).filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(d));
+  } catch {
+    return [];
+  }
+  for (const day of days) {
+    const dir = path.join(rootDir, day);
+    let files: string[] = [];
+    try {
+      files = (await fs.readdir(dir)).filter((f) => f.endsWith('.md'));
+    } catch {
+      continue;
+    }
+    for (const file of files) {
+      const full = path.join(dir, file);
+      try {
+        const md = await fs.readFile(full, 'utf8');
+        const { meta } = parseFrontmatter(md);
+        const stem = file.replace(/\.md$/, '');
+        if (!meta['id']) meta['id'] = `${day}-${stem}`;
+        const srt = await readSrt(path.join(dir, `${stem}.srt`));
+        out.push(toSummary(meta, full, cueCount(srt)));
+      } catch {
+        continue;
+      }
+    }
+  }
+  out.sort((a, b) => (b.started_at ?? '').localeCompare(a.started_at ?? ''));
+  return out;
+}
+
+export async function readSession(
+  rootDir: string,
+  id: string,
+): Promise<StoredSession | null> {
+  let file: string;
+  try {
+    file = filePathFor(rootDir, id);
+  } catch {
+    return null;
+  }
+  try {
+    const md = await fs.readFile(file, 'utf8');
+    const { meta, body } = parseFrontmatter(md);
+    const srt = await readSrt(srtPathFor(rootDir, id));
+    return { meta: toSummary(meta, file, cueCount(srt)), srt, assist: body };
+  } catch {
+    return null;
+  }
+}
