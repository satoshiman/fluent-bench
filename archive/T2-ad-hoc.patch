index 0000000..7035d0c
--- /dev/null
+++ b/server/session/manager.ts
@@ -0,0 +1,512 @@
+import { access } from 'node:fs/promises';
+import path from 'node:path';
+import type { FastifyBaseLogger } from 'fastify';
+import type { Config } from '../config.js';
+import { createSTTProvider } from '../stt/index.js';
+import type {
+  Segment,
+  STTProvider,
+  STTStream,
+  StreamOptions,
+} from '../stt/provider.js';
+import { buildContext, type Translatable, type Translator } from '../translate/translator.js';
+import { makeTranslator } from '../translate/openai-compat.js';
+import type { AnswerAssistant, AssistPoint } from '../assist/assistant.js';
+import { makeAssistant } from '../assist/openai-compat.js';
+import { IdleTimeoutError } from '../stt/idle-timeout.js';
+import { WavRecorder } from '../audio/wav-recorder.js';
+import {
+  filePathFor,
+  sessionIdFor,
+  wavPathFor,
+  type SessionMeta,
+} from './markdown.js';
+import { SessionWriter } from './writer.js';
+
+export class SessionConflictError extends Error {
+  readonly code = 'SESSION_ACTIVE';
+  constructor() {
+    super('a session is already active');
+    this.name = 'SessionConflictError';
+  }
+}
+
+export class SessionNotFoundError extends Error {
+  readonly code = 'SESSION_NOT_FOUND';
+  constructor(id: string) {
+    super(`session not found or not active: ${id}`);
+    this.name = 'SessionNotFoundError';
+  }
+}
+
+export interface SessionStartOptions {
+  targetLang?: string | undefined;
+  diarize?: boolean | undefined;
+  model?: string | undefined;
+  keyterms?: string[] | undefined;
+  slug?: string | undefined;
+  audioSource?: string | undefined;
+  recordAudio?: boolean | undefined;
+}
+
+export interface SessionInfo {
+  id: string;
+  started_at: string;
+  target_lang: string;
+  diarization: boolean;
+  stt_provider: string;
+  model: string | null;
+  file: string;
+  paused: boolean;
+  assist: boolean;
+  record_audio: boolean;
+}
+
+export type ServerEvent =
+  | { type: 'session'; state: 'idle' | 'active'; session?: SessionInfo }
+  | { type: 'partial'; segment: Segment }
+  | { type: 'final'; index: number; segment: Segment }
+  | { type: 'translation'; index: number; text: string }
+  | { type: 'assist'; index: number; question: string; points: AssistPoint[] }
+  | { type: 'speaker'; map: Record<string, string> }
+  | { type: 'error'; message: string; code?: string; index?: number };
+
+interface ActiveSession {
+  info: SessionInfo;
+  writer: SessionWriter;
+  recorder: WavRecorder | null;
+  recorderFailed: boolean;
+  streamBaseS: number;
+  provider: STTProvider;
+  translator: Translator;
+  assistant: AnswerAssistant;
+  assist: boolean;
+  lastAssistErrorNotified: boolean;
+  streamOpts: StreamOptions;
+  stream: STTStream;
+  startedAtMs: number;
+  segCounter: number;
+  finals: Translatable[];
+  stopping: boolean;
+  paused: boolean;
+  pausedAtMs: number;
+  pausedTotalMs: number;
+  translationAttempts: Map<number, number>;
+}
+
+const MAX_TRANSLATION_ATTEMPTS = 3;
+const RETRY_DELAY_MS = 5_000;
+
+export interface SessionManagerDeps {
+  rootDir?: string;
+  providerFactory?: (config: Config, diarize: boolean) => STTProvider;
+  translatorFactory?: (config: Config) => Translator;
+  assistantFactory?: (config: Config) => AnswerAssistant;
+}
+
+export class SessionManager {
+  private active: ActiveSession | undefined;
+  private listeners = new Set<(evt: ServerEvent) => void>();
+  private readonly sessionsDir: string;
+  private readonly providerFactory: (config: Config, diarize: boolean) => STTProvider;
+  private readonly translatorFactory: (config: Config) => Translator;
+  private readonly assistantFactory: (config: Config) => AnswerAssistant;
+
+  constructor(
+    private readonly config: Config,
+    private readonly log: FastifyBaseLogger | Console,
+    deps: SessionManagerDeps = {},
+  ) {
+    this.sessionsDir = deps.rootDir ?? path.resolve(process.cwd(), 'sessions');
+    this.providerFactory = deps.providerFactory ?? createSTTProvider;
+    this.translatorFactory = deps.translatorFactory ?? makeTranslator;
+    this.assistantFactory = deps.assistantFactory ?? makeAssistant;
+  }
+
+  get dir(): string {
+    return this.sessionsDir;
+  }
+
+  subscribe(cb: (evt: ServerEvent) => void): () => void {
+    this.listeners.add(cb);
+    return () => this.listeners.delete(cb);
+  }
+
+  private broadcast(evt: ServerEvent): void {
+    for (const cb of this.listeners) {
+      try {
+        cb(evt);
+      } catch (err) {
+        this.log.warn({ err }, 'session event listener threw');
+      }
+    }
+  }
+
+  current(): SessionInfo | null {
+    return this.active?.info ?? null;
+  }
+
+  async start(opts: SessionStartOptions = {}): Promise<SessionInfo> {
+    if (this.active) throw new SessionConflictError();
+
+    const diarize = opts.diarize ?? true;
+    const targetLang = opts.targetLang ?? this.config.DEFAULT_TARGET_LANG;
+    const provider = this.providerFactory(this.config, diarize);
+    const translator = this.translatorFactory(this.config);
+    const assistant = this.assistantFactory(this.config);
+    const model = opts.model ?? (provider.name === 'deepgram' ? 'nova-3' : null);
+
+    const id = await this.uniqueId(opts.slug ?? 'session');
+    const meta: SessionMeta = {
+      id,
+      started_at: new Date().toISOString(),
+      ended_at: null,
+      source_lang: 'en',
+      target_lang: targetLang,
+      stt_provider: provider.name,
+      model,
+      diarization: diarize,
+      audio_source: opts.audioSource ?? null,
+      audio_file: null,
+      speakers: {},
+      duration_s: null,
+    };
+    // Opt-in audio retention (BDR-003, PLAN-010): a sibling .wav written by
+    // teeing the same PCM that goes to the STT stream. A create failure
+    // propagates - the user asked for recording, so failing the start is
+    // more honest than silently running unrecorded.
+    let recorder: WavRecorder | null = null;
+    if (opts.recordAudio === true) {
+      const wavPath = wavPathFor(this.sessionsDir, id);
+      recorder = await WavRecorder.create(wavPath);
+      meta.audio_file = path.basename(wavPath);
+    }
+    let writer: SessionWriter;
+    try {
+      writer = await SessionWriter.create(this.sessionsDir, meta, this.log);
+    } catch (err) {
+      await recorder?.abort().catch(() => {});
+      throw err;
+    }
+
+    const active: ActiveSession = {
+      info: {
+        id,
+        started_at: meta.started_at,
+        target_lang: targetLang,
+        diarization: diarize,
+        stt_provider: provider.name,
+        model,
+        file: writer.filePath,
+        paused: false,
+        assist: false,
+        record_audio: recorder != null,
+      },
+      writer,
+      recorder,
+      recorderFailed: false,
+      streamBaseS: 0,
+      provider,
+      translator,
+      assistant,
+      assist: false,
+      lastAssistErrorNotified: false,
+      streamOpts: {
+        diarize,
+        ...(model ? { model } : {}),
+        ...(opts.keyterms ? { keyterms: opts.keyterms } : {}),
+      },
+      stream: undefined as unknown as STTStream,
+      startedAtMs: Date.now(),
+      segCounter: 0,
+      finals: [],
+      stopping: false,
+      paused: false,
+      pausedAtMs: 0,
+      pausedTotalMs: 0,
+      translationAttempts: new Map(),
+    };
+
+    try {
+      active.stream = await this.openStream(active);
+    } catch (err) {
+      await recorder?.abort().catch(() => {});
+      throw err;
+    }
+    this.active = active;
+    this.broadcast({ type: 'session', state: 'active', session: active.info });
+    return active.info;
+  }
+
+  private async openStream(active: ActiveSession): Promise<STTStream> {
+    // Wall-clock seconds of audio already sent = where this stream's audio
+    // lands in the session WAV (paused time produces no audio). Read at
+    // entry: while paused the expression is time-invariant (the two
+    // Date.now() terms cancel), so a resume gets the exact pre-pause total
+    // even though stream setup latency follows.
+    const now = Date.now();
+    active.streamBaseS =
+      (now -
+        active.startedAtMs -
+        active.pausedTotalMs -
+        (active.paused ? now - active.pausedAtMs : 0)) /
+      1000;
+    return active.provider.start_stream(active.streamOpts, {
+      onPartial: (seg) => this.broadcast({ type: 'partial', segment: seg }),
+      onFinal: (seg) => void this.handleFinal(active, seg),
+      onError: (err) => this.handleSttError(active, err),
+      onClose: () => {
+        if (!active.stopping && !active.paused) {
+          this.log.warn('STT stream closed unexpectedly; ending session');
+          void this.finish(active);
+        }
+      },
+    });
+  }
+
+  sendAudio(chunk: Buffer): void {
+    const active = this.active;
+    if (!active || active.paused) return;
+    active.stream.send_audio(chunk);
+    // Tee into the WAV only after the send succeeds so the file mirrors
+    // what the provider actually received. Recording is best-effort: one
+    // warning per session, then transcription continues without it.
+    const recorder = active.recorder;
+    if (recorder && !active.recorderFailed) {
+      void recorder.append(chunk).catch((err: unknown) => {
+        active.recorderFailed = true;
+        this.log.warn({ err }, 'audio recording failed; continuing without it');
+      });
+    }
+  }
+
+  async pause(id: string): Promise<void> {
+    const active = this.active;
+    if (!active || active.info.id !== id) throw new SessionNotFoundError(id);
+    if (active.paused) return;
+    // flag before close so onClose treats it as deliberate, not a dropped stream
+    active.paused = true;
+    active.pausedAtMs = Date.now();
+    active.info.paused = true;
+    try {
+      active.stream.close();
+    } catch {
+      // already closed
+    }
+    this.broadcast({ type: 'session', state: 'active', session: active.info });
+  }
+
+  async resume(id: string): Promise<void> {
+    const active = this.active;
+    if (!active || active.info.id !== id) throw new SessionNotFoundError(id);
+    if (!active.paused) return;
+    // throws -> session stays paused and the error reaches the REST caller
+    active.stream = await this.openStream(active);
+    active.pausedTotalMs += Date.now() - active.pausedAtMs;
+    active.paused = false;
+    active.info.paused = false;
+    this.broadcast({ type: 'session', state: 'active', session: active.info });
+  }
+
+  async stop(id: string): Promise<void> {
+    const active = this.active;
+    if (!active || active.info.id !== id) throw new SessionNotFoundError(id);
+    active.stopping = true;
+    await this.finish(active);
+  }
+
+  async setAssist(id: string, enabled: boolean): Promise<void> {
+    const active = this.active;
+    if (!active || active.info.id !== id) throw new SessionNotFoundError(id);
+    if (active.assist === enabled) return;
+    active.assist = enabled;
+    active.info.assist = enabled;
+    this.broadcast({ type: 'session', state: 'active', session: active.info });
+  }
+
+  async renameSpeakers(id: string, map: Record<string, string>): Promise<void> {
+    const active = this.active;
+    if (!active || active.info.id !== id) throw new SessionNotFoundError(id);
+    await active.writer.renameSpeakers(map);
+    this.broadcast({ type: 'speaker', map });
+  }
+
+  async shutdown(): Promise<void> {
+    if (this.active) {
+      this.active.stopping = true;
+      await this.finish(this.active);
+    }
+  }
+
+  private async handleFinal(
+    active: ActiveSession,
+    seg: Segment,
+  ): Promise<void> {
+    const index = active.segCounter++;
+    // Provider timestamps are stream-relative and restart on every resume;
+    // streamBaseS shifts them to session (and WAV) time so the [mm:ss] tag
+    // keeps increasing across pauses.
+    const timed: Segment = {
+      ...seg,
+      start_s: seg.start_s + active.streamBaseS,
+      end_s: seg.end_s + active.streamBaseS,
+    };
+    if (timed.speaker && !(timed.speaker in active.writer.speakers)) {
+      // bounded: a few writes per session, only on first sight of a label
+      await active.writer.renameSpeakers({
+        [timed.speaker]: timed.speaker,
+      });
+      this.broadcast({
+        type: 'speaker',
+        map: { [timed.speaker]: timed.speaker },
+      });
+    }
+    active.finals.push({
+      text: timed.text,
+      ...(timed.speaker ? { speaker: timed.speaker } : {}),
+    });
+    try {
+      await active.writer.appendSegment(index, timed);
+    } catch (err) {
+      this.log.error({ err }, 'failed to append transcript segment');
+    }
+    this.broadcast({ type: 'final', index, segment: timed });
+    void this.translateSegment(active, index, timed);
+    if (active.assist) void this.runAssist(active, index, timed);
+  }
+
+  private async translateSegment(
+    active: ActiveSession,
+    index: number,
+    seg: Segment,
+  ): Promise<void> {
+    const translator = active.translator;
+    const prior = active.finals.slice(0, -1);
+    const context = buildContext(prior);
+    const attempt = (active.translationAttempts.get(index) ?? 0) + 1;
+    active.translationAttempts.set(index, attempt);
+    try {
+      const text = await translator.translate(
+        { text: seg.text, ...(seg.speaker ? { speaker: seg.speaker } : {}) },
+        context,
+        active.info.target_lang,
+      );
+      try {
+        await active.writer.appendTranslation(index, text);
+      } catch (err) {
+        this.log.error({ err }, 'failed to append translation');
+      }
+      this.broadcast({ type: 'translation', index, text });
+    } catch (err) {
+      this.log.warn({ err, index, attempt }, 'translation failed');
+      if (attempt < MAX_TRANSLATION_ATTEMPTS) {
+        setTimeout(
+          () => void this.translateSegment(active, index, seg),
+          RETRY_DELAY_MS * attempt,
+        );
+      } else {
+        this.broadcast({
+          type: 'error',
+          code: 'TRANSLATION_FAILED',
+          index,
+          message: 'segment left untranslated after retries',
+        });
+      }
+    }
+  }
+
+  // Fire-and-forget per final while assist is on (PLAN-009): one bounded LLM
+  // call, best-effort. Any failure is logged; the first failure per session
+  // also surfaces a single ASSIST_FAILED event so the UI can toast once
+  // instead of per segment.
+  private async runAssist(
+    active: ActiveSession,
+    index: number,
+    seg: Segment,
+  ): Promise<void> {
+    const context = buildContext(active.finals.slice(0, -1));
+    try {
+      const result = await active.assistant.analyze(
+        { text: seg.text, ...(seg.speaker ? { speaker: seg.speaker } : {}) },
+        context,
+        active.info.target_lang,
+      );
+      if (result.question == null) return;
+      try {
+        await active.writer.appendAssist(index, result.question, result.points);
+      } catch (err) {
+        this.log.error({ err }, 'failed to append assist block');
+      }
+      this.broadcast({
+        type: 'assist',
+        index,
+        question: result.question,
+        points: result.points,
+      });
+    } catch (err) {
+      this.log.warn({ err, index }, 'assist analysis failed');
+      if (!active.lastAssistErrorNotified) {
+        active.lastAssistErrorNotified = true;
+        this.broadcast({
+          type: 'error',
+          code: 'ASSIST_FAILED',
+          index,
+          message: 'answer assist unavailable',
+        });
+      }
+    }
+  }
+
+  private handleSttError(active: ActiveSession, err: Error): void {
+    if (err instanceof IdleTimeoutError) {
+      this.broadcast({ type: 'error', code: err.code, message: err.message });
+      active.stopping = true;
+      void this.finish(active);
+      return;
+    }
+    this.log.error({ err, session: active.info.id }, 'STT stream error');
+    this.broadcast({ type: 'error', message: err.message });
+  }
+
+  private async finish(active: ActiveSession): Promise<void> {
+    if (this.active !== active) return;
+    this.active = undefined;
+    try {
+      active.stream.close();
+    } catch {
+      // already closed
+    }
+    const now = Date.now();
+    const durationMs =
+      now -
+      active.startedAtMs -
+      active.pausedTotalMs -
+      (active.paused ? now - active.pausedAtMs : 0);
+    try {
+      await active.writer.finalize(durationMs / 1000);
+    } catch (err) {
+      this.log.error({ err }, 'failed to finalize session file');
+    }
+    if (active.recorder) {
+      try {
+        await active.recorder.finalize();
+      } catch (err) {
+        this.log.error({ err }, 'failed to finalize session audio');
+      }
+    }
+    this.broadcast({ type: 'session', state: 'idle' });
+  }
+
+  private async uniqueId(slug: string): Promise<string> {
+    const base = sessionIdFor(new Date(), slug);
+    let id = base;
+    for (let n = 2; ; n++) {
+      try {
+        await access(filePathFor(this.sessionsDir, id));
+        id = `${base}-${n}`;
+      } catch {
+        return id;
+      }
+    }
+  }
+}
