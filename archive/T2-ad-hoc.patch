@@ -0,0 +1,145 @@
+import WebSocket from 'ws';
+import type {
+  Segment,
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+const STREAMING_URL = 'wss://streaming.assemblyai.com/v3/ws';
+const OPEN_TIMEOUT_MS = 10_000;
+const TERMINATE_GRACE_MS = 1_000;
+
+export interface WSLike {
+  send(data: string | Buffer): void;
+  close(): void;
+  on(event: 'open' | 'close', cb: () => void): void;
+  on(event: 'message', cb: (data: Buffer | string) => void): void;
+  on(event: 'error', cb: (err: Error) => void): void;
+}
+
+export type WSFactory = (url: string) => WSLike;
+
+interface AaiTurnMessage {
+  type?: string;
+  turn_order?: number;
+  end_of_turn?: boolean;
+  turn_is_formatted?: boolean;
+  transcript?: string;
+  words?: Array<{ start?: number; end?: number }>;
+}
+
+export class AssemblyAIProvider implements STTProvider {
+  readonly name = 'assemblyai';
+  readonly supports_diarization = false;
+
+  constructor(
+    private readonly apiKey: string,
+    private readonly wsFactory?: WSFactory,
+  ) {}
+
+  start_stream(opts: StreamOptions, events: StreamEvents): Promise<STTStream> {
+    const url = this.buildUrl(opts);
+    const socket = (this.wsFactory ?? defaultWsFactory(this.apiKey))(url);
+    const seenFinalTurns = new Set<number>();
+
+    socket.on('message', (data) => {
+      let msg: AaiTurnMessage;
+      try {
+        msg = JSON.parse(String(data)) as AaiTurnMessage;
+      } catch {
+        return;
+      }
+      if (msg.type === 'Termination') {
+        events.onClose?.();
+        socket.close();
+        return;
+      }
+      if (msg.type !== 'Turn') return;
+      const text = msg.transcript?.trim() ?? '';
+      if (!text) return;
+
+      const first = msg.words?.[0];
+      const last = msg.words?.[msg.words.length - 1];
+      const seg: Segment = {
+        text,
+        start_s: (first?.start ?? 0) / 1000,
+        end_s: (last?.end ?? 0) / 1000,
+      };
+
+      if (!msg.end_of_turn) {
+        events.onPartial(seg);
+        return;
+      }
+      // format_turns=true emits two end_of_turn Turns per turn_order:
+      // unformatted then formatted. Emit the final only on the formatted one.
+      if (msg.turn_is_formatted && !seenFinalTurns.has(msg.turn_order ?? -1)) {
+        if (msg.turn_order != null) seenFinalTurns.add(msg.turn_order);
+        events.onFinal(seg);
+      }
+    });
+    socket.on('error', (err) => events.onError(toError(err)));
+    socket.on('close', () => events.onClose?.());
+
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(
+        () => reject(new Error('AssemblyAI stream open timed out')),
+        OPEN_TIMEOUT_MS,
+      );
+      socket.on('open', () => {
+        clearTimeout(timer);
+        let sendFailed = false;
+        resolve({
+          send_audio: (chunk: Buffer) => {
+            if (sendFailed) return;
+            try {
+              socket.send(chunk);
+            } catch (err) {
+              sendFailed = true;
+              events.onError(toError(err));
+              try {
+                socket.close();
+              } catch {
+                // already closed
+              }
+            }
+          },
+          close: () => {
+            try {
+              socket.send(JSON.stringify({ type: 'Terminate' }));
+            } catch {
+              // ignore; socket closing below
+            }
+            // AssemblyAI bills socket-open duration: close promptly.
+            setTimeout(() => socket.close(), TERMINATE_GRACE_MS);
+          },
+        });
+      });
+      socket.on('error', (err) => {
+        clearTimeout(timer);
+        reject(toError(err));
+      });
+    });
+  }
+
+  private buildUrl(opts: StreamOptions): string {
+    const url = new URL(STREAMING_URL);
+    url.searchParams.set('sample_rate', String(opts.sampleRate ?? 16000));
+    url.searchParams.set('encoding', 'pcm_s16le');
+    url.searchParams.set('format_turns', 'true');
+    for (const term of opts.keyterms ?? []) {
+      url.searchParams.append('keyterms_prompt', term);
+    }
+    return url.toString();
+  }
+}
+
+function defaultWsFactory(apiKey: string): WSFactory {
+  return (url) =>
+    new WebSocket(url, { headers: { Authorization: apiKey } }) as unknown as WSLike;
+}
+
+function toError(err: unknown): Error {
+  return err instanceof Error ? err : new Error(String(err));
+}
