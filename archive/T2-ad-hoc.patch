+++ b/web/src/components/assist.tsx
@@ -0,0 +1,65 @@
+import type { AssistEntry } from '@/lib/use-live-session';
+
+// Detected questions + answer points, latest first. Skeleton points (the
+// "My name is ..." fill-in-the-blank style) render italic so they read as
+// templates rather than finished sentences. Rendered inside the live strip
+// (and the PiP window), so it has no Card chrome of its own.
+export function AssistEntries({
+  entries,
+  active,
+}: {
+  entries: AssistEntry[];
+  active?: boolean;
+}) {
+  if (entries.length === 0) {
+    return (
+      <div className="flex h-full items-center justify-center">
+        <p className="text-sm text-muted-foreground">
+          {active
+            ? 'Listening for questions…'
+            : 'Answer assist is off. Toggle it on to get answer points.'}
+        </p>
+      </div>
+    );
+  }
+  return (
+    <div className="flex flex-col gap-5">
+      {entries
+        .slice()
+        .reverse()
+        .map((entry) => (
+          <div
+            key={entry.index}
+            className="flex flex-col gap-2 border-l-2 border-primary/50 pl-3"
+          >
+            <div className="flex items-baseline gap-2">
+              <span className="shrink-0 font-mono text-xs text-muted-foreground">
+                #{entry.index}
+              </span>
+              <p className="text-base font-medium leading-snug">
+                {entry.question}
+              </p>
+            </div>
+            {entry.points.length > 0 ? (
+              <ul className="flex flex-col gap-1.5">
+                {entry.points.map((point, i) => (
+                  <li key={i} className="flex flex-col">
+                    <span
+                      className={`text-sm ${point.en.includes('...') ? 'italic' : ''}`}
+                    >
+                      {point.en}
+                    </span>
+                    {point.note ? (
+                      <span className="text-xs text-muted-foreground">
+                        {point.note}
+                      </span>
+                    ) : null}
+                  </li>
+                ))}
+              </ul>
+            ) : null}
+          </div>
+        ))}
+    </div>
+  );
+}
diff --git a/web/src/components/audio-player.tsx b/web/src/components/audio-player.tsx
new file mode 100644
index 0000000..59d70ff
--- /dev/null
+++ b/web/src/components/audio-player.tsx
@@ -0,0 +1,232 @@
+import {
+  useRef,
+  useState,
+  type KeyboardEvent,
+  type PointerEvent,
+  type RefObject,
+} from 'react';
+import {
+  AudioLines,
+  FastForward,
+  Magnet,
+  Pause,
+  Play,
+  Rewind,
+} from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent } from '@/components/ui/card';
+import { cn } from 'cn';
+
+function fmtTime(s: number): string {
+  if (!Number.isFinite(s) || s < 0) return '0:00';
+  const t = Math.floor(s);
+  const m = Math.floor(t / 60);
+  return `${m}:${String(t % 60).padStart(2, '0')}`;
+}
+
+const RATES = [1, 1.25, 1.5, 2];
+const SKIP_S = 10;
+
+interface SessionAudioPlayerProps {
+  src: string;
+  // segment start positions (seconds) rendered as ticks on the seek bar
+  marks: number[];
+  audioRef: RefObject<HTMLAudioElement | null>;
+  follow: boolean;
+  onToggleFollow: () => void;
+  onTime?: (t: number) => void;
+}
+
+// Custom transport for session WAV playback (Review page): a hidden <audio>
+// driven by a seek bar that carries one tick per transcript segment, so the
+// bar itself reads as a rough waveform of who spoke when.
+export function SessionAudioPlayer({
+  src,
+  marks,
+  audioRef,
+  follow,
+  onToggleFollow,
+  onTime,
+}: SessionAudioPlayerProps) {
+  const trackRef = useRef<HTMLDivElement | null>(null);
+  const [playing, setPlaying] = useState(false);
+  const [time, setTime] = useState(0);
+  const [duration, setDuration] = useState(0);
+  const [rate, setRate] = useState(1);
+
+  const seekable = Number.isFinite(duration) && duration > 0;
+  const frac = seekable ? Math.min(1, Math.max(0, time / duration)) : 0;
+
+  const seekTo = (clientX: number) => {
+    const track = trackRef.current;
+    const a = audioRef.current;
+    if (!track || !a || !seekable) return;
+    const rect = track.getBoundingClientRect();
+    const f = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
+    a.currentTime = f * duration;
+  };
+
+  const onTrackPointerDown = (e: PointerEvent<HTMLDivElement>) => {
+    e.currentTarget.setPointerCapture(e.pointerId);
+    seekTo(e.clientX);
+  };
+  const onTrackPointerMove = (e: PointerEvent<HTMLDivElement>) => {
+    if (e.buttons === 1) seekTo(e.clientX);
+  };
+  const onTrackKeyDown = (e: KeyboardEvent<HTMLDivElement>) => {
+    const a = audioRef.current;
+    if (!a || !seekable) return;
+    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
+      e.preventDefault();
+      const delta = (e.key === 'ArrowRight' ? 5 : -5) * (e.shiftKey ? 3 : 1);
+      a.currentTime = Math.min(
+        duration,
+        Math.max(0, a.currentTime + delta),
+      );
+    }
+  };
+
+  const skip = (delta: number) => {
+    const a = audioRef.current;
+    if (!a || !seekable) return;
+    a.currentTime = Math.min(duration, Math.max(0, a.currentTime + delta));
+  };
+
+  const toggle = () => {
+    const a = audioRef.current;
+    if (!a) return;
+    if (a.paused) void a.play().catch(() => {});
+    else a.pause();
+  };
+
+  const cycleRate = () => {
+    const a = audioRef.current;
+    const next = RATES[(RATES.indexOf(rate) + 1) % RATES.length]!;
+    setRate(next);
+    if (a) a.playbackRate = next;
+  };
+
+  return (
+    <Card size="sm" className="sticky top-3 z-10">
+      <CardContent className="flex flex-col gap-1.5">
+        <div className="flex items-center gap-2">
+          <AudioLines className="size-4 shrink-0 text-primary" />
+          <Button
+            variant="secondary"
+            size="icon"
+            className="size-8 shrink-0 rounded-full"
+            onClick={toggle}
+            aria-label={playing ? 'Pause' : 'Play'}
+          >
+            {playing ? (
+              <Pause className="size-4" />
+            ) : (
+              <Play className="size-4" />
+            )}
+          </Button>
+          <Button
+            variant="ghost"
+            size="icon"
+            className="size-7 shrink-0"
+            onClick={() => skip(-SKIP_S)}
+            aria-label={`Back ${SKIP_S} seconds`}
+          >
+            <Rewind className="size-3.5" />
+          </Button>
+          <Button
+            variant="ghost"
+            size="icon"
+            className="size-7 shrink-0"
+            onClick={() => skip(SKIP_S)}
+            aria-label={`Forward ${SKIP_S} seconds`}
+          >
+            <FastForward className="size-3.5" />
+          </Button>
+          <span className="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
+            {fmtTime(time)} / {fmtTime(duration)}
+          </span>
+          <div
+            ref={trackRef}
+            role="slider"
+            tabIndex={0}
+            aria-label="Seek audio"
+            aria-valuemin={0}
+            aria-valuemax={Math.round(duration)}
+            aria-valuenow={Math.round(time)}
+            onPointerDown={onTrackPointerDown}
+            onPointerMove={onTrackPointerMove}
+            onKeyDown={onTrackKeyDown}
+            className="relative h-4 min-w-0 flex-1 cursor-pointer touch-none select-none outline-none focus-visible:ring-2 focus-visible:ring-ring/50 rounded-full"
+          >
+            <div className="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-muted" />
+            <div
+              className="absolute inset-x-0 top-1/2 h-1 origin-left rounded-full bg-primary"
+              style={{ transform: `translateY(-50%) scaleX(${frac})` }}
+            />
+            {seekable
+              ? marks
+                  .filter((m) => m > 0.5 && m <= duration)
+                  .map((m) => (
+                    <span
+                      key={m}
+                      className="absolute top-1/2 size-1 rounded-full bg-primary/50"
+                      style={{
+                        left: `${(m / duration) * 100}%`,
+                        transform: 'translate(-50%, -50%)',
+                      }}
+                    />
+                  ))
+              : null}
+            <span
+              className="absolute top-1/2 size-2.5 rounded-full bg-primary ring-2 ring-background"
+              style={{
+                left: `${frac * 100}%`,
+                transform: 'translate(-50%, -50%)',
+              }}
+            />
+          </div>
+          <Button
+            variant="ghost"
+            size="sm"
+            className="h-7 w-10 shrink-0 px-0 font-mono text-xs tabular-nums"
+            onClick={cycleRate}
+            aria-label="Playback speed"
+          >
+            {rate}x
+          </Button>
+          <Button
+            variant="ghost"
+            size="icon"
+            className={cn(
+              'size-7 shrink-0',
+              follow && 'text-primary',
+            )}
+            onClick={onToggleFollow}
+            aria-pressed={follow}
+            title="Highlight follows playback"
+          >
+            <Magnet className="size-3.5" />
+          </Button>
+        </div>
+        <p className="text-[11px] leading-snug text-muted-foreground">
+          Click a [mm:ss] timestamp to play from that point.
+        </p>
+      </CardContent>
+      <audio
+        ref={audioRef}
+        preload="metadata"
+        src={src}
+        className="hidden"
+        onTimeUpdate={(e) => {
+          setTime(e.currentTarget.currentTime);
+          onTime?.(e.currentTarget.currentTime);
+        }}
+        onPlay={() => setPlaying(true)}
+        onPause={() => setPlaying(false)}
+        onEnded={() => setPlaying(false)}
+        onLoadedMetadata={(e) => setDuration(e.currentTarget.duration)}
+        onDurationChange={(e) => setDuration(e.currentTarget.duration)}
+      />
+    </Card>
+  );
+}
