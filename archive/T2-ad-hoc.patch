+
+  it('finalize keeps the ## Assist body and sets ended_at/duration_s', async () => {
+    const w = await SessionWriter.create(dir, meta('2026-11-05-session-1000'));
+    await w.appendAssist(0, 'Q?', [{ en: 'a', note: '' }]);
+    await w.finalize(61.6);
+    const { meta: parsed, body } = parseFrontmatter(
