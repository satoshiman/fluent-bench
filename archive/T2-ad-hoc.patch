+import { EventEmitter } from 'node:events';
+import { describe, expect, it } from 'vitest';
+import { DeepgramProvider, type DgSocketLike } from './deepgram.js';
+import { sttProviderContract, type ContractHarness } from './contract.js';
+import { createSTTProvider } from './index.js';
+import { parseConfig } from '../config.js';
+
+class FakeDgSocket extends EventEmitter implements DgSocketLike {
+  binary: Buffer[] = [];
+  json: unknown[] = [];
+  closedFlag = false;
+  connectCount = 0;
+  readyState?: number;
+  connect(): void {
+    this.connectCount++;
+  }
+  sendMedia(chunk: ArrayBufferView): void {
+    this.binary.push(
+      Buffer.from(chunk.buffer as ArrayBuffer, chunk.byteOffset, chunk.byteLength),
+    );
+  }
+  sendCloseStream(msg: { type: string }): void {
+    this.json.push(msg);
+  }
+  close(): void {
+    this.closedFlag = true;
+    this.emit('close');
+  }
+}
+
+let socket: FakeDgSocket;
+let connectArgs: Record<string, unknown> | undefined;
+
+function harness(): ContractHarness {
+  socket = new FakeDgSocket();
+  connectArgs = undefined;
+  const provider = new DeepgramProvider('test-key', async (args) => {
+    connectArgs = args;
+    return socket;
+  });
+  return {
+    provider,
+    emitInbound: (msg) => socket.emit('message', msg),
+    sentBinary: () => socket.binary,
+    sentText: () => socket.json.map((m) => JSON.stringify(m)),
+    closed: () => socket.closedFlag,
+  };
+}
+
+sttProviderContract('deepgram', harness, {
+  partial: {
+    type: 'Results',
+    is_final: false,
+    start: 1.0,
+    duration: 0.5,
+    channel: {
+      alternatives: [
+        {
+          transcript: 'hello',
+          words: [{ word: 'hello', speaker: 0, start: 1, end: 1.5 }],
+        },
+      ],
+    },
+  },
+  final: {
+    type: 'Results',
+    is_final: true,
+    start: 1.0,
+    duration: 1.5,
+    channel: {
+      alternatives: [
+        {
+          transcript: 'hello world',
+          words: [
+            { word: 'hello', speaker: 1, start: 1, end: 1.5 },
+            { word: 'world', speaker: 1, start: 1.5, end: 2.5 },
+          ],
+        },
+      ],
+    },
+  },
+  ignored: { type: 'Metadata', request_id: 'x' },
+  partialText: 'hello',
+  finalText: 'hello world',
+  finalSpeaker: 'Speaker 2',
+});
+
+describe('DeepgramProvider', () => {
+  it('passes model/diarize/keyterm options to the connect call', async () => {
+    const h = harness();
+    const stream = await h.provider.start_stream(
+      { diarize: true, model: 'nova-3', keyterms: ['Cognition', 'Devin'] },
+      {
+        onPartial: () => {},
+        onFinal: () => {},
+        onError: () => {},
+      },
+    );
+    expect(connectArgs?.model).toBe('nova-3');
+    expect(connectArgs?.diarize).toBe(true);
+    expect(connectArgs?.keyterm).toEqual(['Cognition', 'Devin']);
+    expect(connectArgs?.encoding).toBe('linear16');
+    expect(connectArgs?.sample_rate).toBe(16000);
+    expect(connectArgs?.endpointing).toBe(300);
+    stream.close();
+  });
+
+  it('opens the socket explicitly (SDK returns a startClosed socket)', async () => {
+    const h = harness();
+    const stream = await h.provider.start_stream(
+      { diarize: true },
+      { onPartial: () => {}, onFinal: () => {}, onError: () => {} },
+    );
+    expect(socket.connectCount).toBe(1);
+    stream.close();
+  });
+
+  it('buffers audio until the socket opens, then flushes in order', async () => {
+    const h = harness();
+    socket.readyState = 0; // CONNECTING
+    const stream = await h.provider.start_stream(
+      { diarize: true },
+      { onPartial: () => {}, onFinal: () => {}, onError: () => {} },
+    );
+    stream.send_audio(Buffer.from('first'));
+    stream.send_audio(Buffer.from('second'));
+    expect(socket.binary).toHaveLength(0);
+    socket.readyState = 1; // OPEN
+    socket.emit('open');
+    expect(socket.binary.map(String)).toEqual(['first', 'second']);
+    stream.send_audio(Buffer.from('third'));
+    expect(socket.binary.map(String)).toEqual(['first', 'second', 'third']);
+    stream.close();
+  });
+
+  it('sends CloseStream before closing the socket', async () => {
+    const h = harness();
+    const stream = await h.provider.start_stream(
+      { diarize: false },
+      { onPartial: () => {}, onFinal: () => {}, onError: () => {} },
+    );
+    stream.close();
+    expect(socket.json).toContainEqual({ type: 'CloseStream' });
+    expect(socket.closedFlag).toBe(true);
+  });
+});
+
+describe('createSTTProvider resolution', () => {
+  const baseEnv = {
+    DEEPGRAM_API_KEY: 'dg',
+    ASSEMBLYAI_API_KEY: 'aai',
+    LLM_API_KEY: 'llm',
+  };
+
+  it('uses deepgram when diarization is on', () => {
+    const p = createSTTProvider(parseConfig(baseEnv), true);
+    expect(p.name).toBe('deepgram');
+  });
+
+  it('uses the assemblyai low-cost path when diarization is off and the key exists', () => {
+    const p = createSTTProvider(parseConfig(baseEnv), false);
+    expect(p.name).toBe('assemblyai');
+  });
+
+  it('falls back to deepgram without diarization when no AssemblyAI key', () => {
+    const p = createSTTProvider(
+      parseConfig({ ...baseEnv, ASSEMBLYAI_API_KEY: '' }),
+      false,
+    );
+    expect(p.name).toBe('deepgram');
+  });
+
+  it('rejects diarization when STT_PROVIDER=assemblyai', () => {
+    expect(() =>
+      createSTTProvider(
+        parseConfig({ ...baseEnv, STT_PROVIDER: 'assemblyai' }),
+        true,
+      ),
+    ).toThrow(/Diarization requires Deepgram/);
+  });
+});
