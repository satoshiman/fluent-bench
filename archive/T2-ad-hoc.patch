+++ b/web/src/components/transcript.tsx
@@ -0,0 +1,589 @@
+import { Fragment, useEffect, useRef, useState } from 'react';
+import {
+  CircleHelp,
+  Eye,
+  EyeOff,
+  Mic,
+  MicOff,
+  Pause,
+  PictureInPicture2,
+  Play,
+  User,
+} from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent } from '@/components/ui/card';
+import {
+  speakerColorIndex,
+  type TranscriptParagraph,
+} from '@/lib/transcript-groups';
+import { AssistEntries } from '@/components/assist';
+import type {
+  AssistEntry,
+  DraftEntry,
+  FinalEntry,
+  TranslationEntry,
+} from '@/lib/use-live-session';
+
+function fmtClock(s: number): string {
+  const t = Math.max(0, Math.round(s));
+  const mm = String(Math.floor(t / 60)).padStart(2, '0');
+  const ss = String(t % 60).padStart(2, '0');
+  return `${mm}:${ss}`;
+}
+
+function speakerVar(label: string | undefined): React.CSSProperties {
+  return {
+    '--spk': `var(--speaker-${speakerColorIndex(label) + 1})`,
+  } as React.CSSProperties;
+}
+
+export function LiveDot({ className }: { className?: string }) {
+  return (
+    <span
+      aria-hidden
+      className={`animate-pulse-soft inline-block size-2 rounded-full bg-primary ${className ?? ''}`}
+    />
+  );
+}
+
+export function SpeakerChip({ label }: { label: string }) {
+  // "Speaker 3" -> "3"; labels without a trailing number show as-is
+  const num = /\d+$/.exec(label)?.[0] ?? label;
+  return (
+    <span
+      style={speakerVar(label)}
