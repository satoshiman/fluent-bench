+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { IdleTimeoutError, withIdleTimeout } from './idle-timeout.js';
+import type { STTProvider, STTStream, StreamEvents, StreamOptions } from './provider.js';
+
+class FakeProvider implements STTProvider {
+  readonly name = 'fake';
+  readonly supports_diarization = false;
+  closed = false;
+  audio: Buffer[] = [];
+  async start_stream(_opts: StreamOptions, _events: StreamEvents): Promise<STTStream> {
+    return {
+      send_audio: (c: Buffer) => this.audio.push(c),
+      close: () => {
+        this.closed = true;
+      },
+    };
+  }
+}
+
+const noopEvents: StreamEvents = {
+  onPartial: () => {},
+  onFinal: () => {},
+  onError: () => {},
+};
+
+describe('withIdleTimeout', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it('auto-closes the stream after N idle seconds and reports it', async () => {
+    const inner = new FakeProvider();
+    const provider = withIdleTimeout(inner, 5);
+    const errors: Error[] = [];
+    const stream = await provider.start_stream(
+      { diarize: false },
+      { ...noopEvents, onError: (e) => errors.push(e) },
+    );
+    stream.send_audio(Buffer.from('a'));
+    vi.advanceTimersByTime(4999);
+    expect(inner.closed).toBe(false);
+    vi.advanceTimersByTime(2);
+    expect(inner.closed).toBe(true);
+    expect(errors[0]).toBeInstanceOf(IdleTimeoutError);
+  });
+
+  it('resets the timer on every audio chunk', async () => {
+    const inner = new FakeProvider();
+    const provider = withIdleTimeout(inner, 5);
+    const stream = await provider.start_stream({ diarize: false }, noopEvents);
+    vi.advanceTimersByTime(4000);
+    stream.send_audio(Buffer.from('a'));
+    vi.advanceTimersByTime(4000);
+    expect(inner.closed).toBe(false);
+    vi.advanceTimersByTime(1001);
+    expect(inner.closed).toBe(true);
+  });
+
+  it('does not fire after an explicit close', async () => {
+    const inner = new FakeProvider();
+    const provider = withIdleTimeout(inner, 5);
+    const errors: Error[] = [];
+    const stream = await provider.start_stream(
+      { diarize: false },
+      { ...noopEvents, onError: (e) => errors.push(e) },
+    );
+    stream.close();
+    vi.advanceTimersByTime(60_000);
+    expect(errors).toHaveLength(0);
+  });
+});
