+import { EventEmitter } from 'node:events';
+import { describe, expect, it } from 'vitest';
+import { AssemblyAIProvider, type WSLike } from './assemblyai.js';
+import { sttProviderContract, type ContractHarness } from './contract.js';
+
+class FakeWs extends EventEmitter implements WSLike {
+  binary: Buffer[] = [];
+  text: string[] = [];
+  closedFlag = false;
+  send(data: string | Buffer): void {
+    if (typeof data === 'string') this.text.push(data);
+    else this.binary.push(data);
+  }
+  close(): void {
+    this.closedFlag = true;
+    this.emit('close');
+  }
+}
+
+let socket: FakeWs;
+let openedUrl = '';
+
+function harness(): ContractHarness {
+  socket = new FakeWs();
+  openedUrl = '';
+  const provider = new AssemblyAIProvider('test-key', (url) => {
+    openedUrl = url;
+    queueMicrotask(() => socket.emit('open'));
+    return socket;
+  });
+  return {
+    provider,
+    emitInbound: (msg) => socket.emit('message', Buffer.from(JSON.stringify(msg))),
+    sentBinary: () => socket.binary,
+    sentText: () => socket.text,
+    closed: () => socket.closedFlag,
+  };
+}
+
+const turn = (over: Record<string, unknown>) => ({
+  type: 'Turn',
+  turn_order: 0,
+  end_of_turn: false,
+  turn_is_formatted: false,
+  transcript: 'hello',
+  words: [
+    { start: 100, end: 400, text: 'hello', confidence: 0.9, word_is_final: false },
+  ],
+  ...over,
+});
+
+sttProviderContract('assemblyai', harness, {
+  partial: turn({ transcript: 'hello' }),
+  final: turn({
+    end_of_turn: true,
+    turn_is_formatted: true,
+    transcript: 'hello world',
+    words: [
+      { start: 100, end: 400, text: 'hello', confidence: 0.9, word_is_final: true },
+      { start: 400, end: 800, text: 'world', confidence: 0.9, word_is_final: true },
+    ],
+  }),
+  ignored: { type: 'Begin', id: 'sess-1' },
+  partialText: 'hello',
+  finalText: 'hello world',
+});
+
+describe('AssemblyAIProvider', () => {
+  it('connects to the v3 streaming endpoint with pcm_s16le + format_turns', async () => {
+    const h = harness();
+    const stream = await h.provider.start_stream(
+      { diarize: false, keyterms: ['Devin'] },
+      { onPartial: () => {}, onFinal: () => {}, onError: () => {} },
+    );
+    expect(openedUrl).toContain('wss://streaming.assemblyai.com/v3/ws');
+    expect(openedUrl).toContain('sample_rate=16000');
+    expect(openedUrl).toContain('encoding=pcm_s16le');
+    expect(openedUrl).toContain('format_turns=true');
+    expect(openedUrl).toContain('keyterms_prompt=Devin');
+    stream.close();
+  });
+
+  it('emits the final only once for duplicated end_of_turn Turns', async () => {
+    const h = harness();
+    const finals: string[] = [];
+    const stream = await h.provider.start_stream(
+      { diarize: false },
+      {
+        onPartial: () => {},
+        onFinal: (s) => finals.push(s.text),
+        onError: () => {},
+      },
+    );
+    const unformatted = turn({ end_of_turn: true, turn_is_formatted: false, transcript: 'hello world' });
+    const formatted = turn({ end_of_turn: true, turn_is_formatted: true, transcript: 'Hello world.' });
+    h.emitInbound(unformatted);
+    h.emitInbound(formatted);
+    h.emitInbound(formatted);
+    expect(finals).toEqual(['Hello world.']);
+    stream.close();
+  });
+
+  it('sends Terminate on close and closes the socket', async () => {
+    const h = harness();
+    const stream = await h.provider.start_stream(
+      { diarize: false },
+      { onPartial: () => {}, onFinal: () => {}, onError: () => {} },
+    );
+    stream.close();
+    expect(socket.text).toContainEqual(JSON.stringify({ type: 'Terminate' }));
+    await new Promise((r) => setTimeout(r, 1100));
+    expect(socket.closedFlag).toBe(true);
+  });
+});
