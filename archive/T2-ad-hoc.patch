--- /dev/null
+++ b/server/config.ts
@@ -0,0 +1,64 @@
+import 'dotenv/config';
+import { z } from 'zod';
+
+const optionalKey = z.preprocess(
+  (v) => (typeof v === 'string' && v.trim() === '' ? undefined : v),
+  z.string().min(1).optional(),
+);
+
+const envSchema = z.object({
+  STT_PROVIDER: z.enum(['deepgram', 'assemblyai']).default('deepgram'),
+  DEEPGRAM_API_KEY: optionalKey,
+  ASSEMBLYAI_API_KEY: optionalKey,
+  STT_IDLE_TIMEOUT_S: z.coerce.number().int().positive().default(30),
+  LLM_BASE_URL: z.url().default('https://api.deepseek.com'),
+  LLM_API_KEY: optionalKey,
+  TRANSLATE_MODEL: z.string().min(1).default('deepseek-flash'),
+  ASSIST_MODEL: optionalKey,
+  LLM_FALLBACK_BASE_URL: optionalKey.pipe(z.url().optional()),
+  LLM_FALLBACK_API_KEY: optionalKey,
+  LLM_FALLBACK_MODEL: z.string().min(1).default('gpt-4.1-mini'),
+  DEFAULT_TARGET_LANG: z.string().min(1).default('vi'),
+  PORT: z.coerce.number().int().positive().default(3000),
+});
+
+export type Config = z.infer<typeof envSchema>;
+
+export function parseConfig(raw: Record<string, string | undefined>): Config {
+  const parsed = envSchema.safeParse(raw);
+  if (!parsed.success) {
+    const lines = parsed.error.issues
+      .map((i) => `  - ${i.path.join('.') || 'env'}: ${i.message}`)
+      .join('\n');
+    throw new Error(`Invalid environment configuration:\n${lines}`);
+  }
+  const env = parsed.data;
+
+  const missing: string[] = [];
+  if (env.STT_PROVIDER === 'deepgram' && !env.DEEPGRAM_API_KEY) {
+    missing.push('DEEPGRAM_API_KEY (required when STT_PROVIDER=deepgram)');
+  }
+  if (env.STT_PROVIDER === 'assemblyai' && !env.ASSEMBLYAI_API_KEY) {
+    missing.push('ASSEMBLYAI_API_KEY (required when STT_PROVIDER=assemblyai)');
+  }
+  if (!env.LLM_API_KEY) {
+    missing.push('LLM_API_KEY (required for translation)');
+  }
+  if (env.LLM_FALLBACK_BASE_URL && !env.LLM_FALLBACK_API_KEY) {
+    missing.push('LLM_FALLBACK_API_KEY (or unset LLM_FALLBACK_BASE_URL to disable fallback)');
+  }
+  if (missing.length > 0) {
+    throw new Error(
+      `Missing required env vars:\n${missing.map((m) => `  - ${m}`).join('\n')}\n` +
+        'Copy .env.example to .env and fill in the values.',
+    );
+  }
+  return env;
+}
+
+let cached: Config | undefined;
+
+export function loadConfig(): Config {
+  if (!cached) cached = parseConfig(process.env);
+  return cached;
+}
diff --git a/server/index.ts b/server/index.ts
new file mode 100644
index 0000000..b80700e
--- /dev/null
+++ b/server/index.ts
@@ -0,0 +1,98 @@
+import { existsSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import Fastify from 'fastify';
+import websocketPlugin from '@fastify/websocket';
+import staticPlugin from '@fastify/static';
+import { ZodError } from 'zod';
+import { loadConfig, type Config } from './config.js';
+import { registerWs } from './ws.js';
+import { registerSessionRoutes } from './session/routes.js';
+import { SessionManager, type SessionManagerDeps } from './session/manager.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const webDist = path.resolve(here, '../web/dist');
+
+export async function buildServer(
+  config: Config,
+  sessionDeps: SessionManagerDeps = {},
+  opts: { staticDir?: string } = {},
+) {
+  const staticDir = opts.staticDir ?? webDist;
+  const app = Fastify({ logger: true });
+  const sessions = new SessionManager(config, app.log, sessionDeps);
+
+  app.setErrorHandler((err: unknown, _req, reply) => {
+    const e = err as Error & { code?: string; statusCode?: number };
+    if (err instanceof ZodError) {
+      return reply.code(400).send({
+        error: 'invalid request',
+        issues: err.issues.map((i) => `${i.path.join('.')}: ${i.message}`),
+      });
+    }
+    const code = e.code;
+    const status =
+      code === 'SESSION_ACTIVE'
+        ? 409
+        : code === 'SESSION_NOT_FOUND'
+          ? 404
+          : code === 'PROVIDER_CONFIG'
+            ? 400
+            : (e.statusCode ?? 500);
+    if (status >= 500) app.log.error(err);
+    return reply
+      .code(status)
+      .send({ error: e.message, ...(code ? { code } : {}) });
+  });
+
+  await app.register(websocketPlugin);
+
+  if (existsSync(staticDir)) {
+    await app.register(staticPlugin, { root: staticDir });
+  }
+
+  registerWs(app, sessions);
+  registerSessionRoutes(app, sessions);
+
+  // SPA fallback: browser navigations to client-side routes (e.g.
+  // /sessions/:id) get index.html; everything else keeps the JSON 404 shape
+  // the frontend api() parses for `error`
+  app.setNotFoundHandler((req, reply) => {
+    const url = req.raw.url ?? '';
+    if (
+      existsSync(staticDir) &&
+      (req.method === 'GET' || req.method === 'HEAD') &&
+      String(req.headers.accept ?? '').includes('text/html') &&
+      !url.startsWith('/api') &&
+      !url.startsWith('/ws')
+    ) {
+      return reply.sendFile('index.html');
+    }
+    return reply.code(404).send({
+      statusCode: 404,
+      error: 'Not Found',
+      message: `Route ${req.method}:${url} not found`,
+    });
+  });
+
+  app.addHook('onClose', async () => {
+    await sessions.shutdown();
+  });
+
+  return app;
+}
+
+const isMain =
+  process.argv[1] !== undefined &&
+  import.meta.url === pathToFileURL(process.argv[1]).href;
+
+if (isMain) {
+  const config = loadConfig();
+  const app = await buildServer(config);
+  try {
+    await app.listen({ port: config.PORT, host: '127.0.0.1' });
+  } catch (err) {
+    app.log.error(err);
+    process.exit(1);
+  }
+}
