+  it('splices a translation into its own cue even after later cues land', async () => {
+    const w = await SessionWriter.create(dir, meta('2026-11-05-session-1000'));
+    await w.appendSegment(0, { text: 'Hello.', start_s: 2, end_s: 4.8 });
+    await w.appendSegment(1, { text: 'Hi there.', start_s: 5.1, end_s: 8.2 });
+    await w.appendTranslation(0, 'Xin chào.');
+    const srt = await fs.readFile(w.srtPath, 'utf8');
+    expect(srt).toBe(
+      '1\n00:00:02,000 --> 00:00:04,800\nHello.\nXin chào.\n\n' +
+        '2\n00:00:05,100 --> 00:00:08,200\nHi there.\n\n',
+    );
+  });
+
+  it('skips + logs a translation for a missing cue instead of writing', async () => {
