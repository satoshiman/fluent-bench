+import type { Translatable } from '../translate/translator.js';
+
+export interface AssistPoint {
+  en: string;
+  note: string;
+}
+
+export interface AssistResult {
+  question: string | null;
+  points: AssistPoint[];
+}
+
+export interface AnswerAssistant {
+  analyze(
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<AssistResult>;
+}
+
+export class AssistError extends Error {
+  readonly code = 'ASSIST_FAILED';
+  constructor(
+    message: string,
+    readonly cause?: unknown,
+  ) {
+    super(message);
+    this.name = 'AssistError';
+  }
+}
