+import { describe, expect, it } from 'vitest';
+import { groupSegments, speakerColorIndex } from './transcript-groups';
+import type { FinalEntry } from './use-live-session';
+import type { Segment } from './types';
+
+function entry(
+  index: number,
+  start_s: number,
+  end_s: number,
+  speaker?: string,
+): FinalEntry {
+  const segment: Segment = {
+    text: `seg ${index}`,
+    start_s,
+    end_s,
+    ...(speaker !== undefined ? { speaker } : {}),
+  };
+  return { index, segment };
+}
+
+describe('groupSegments', () => {
+  it('merges same-speaker finals into one paragraph', () => {
+    const paragraphs = groupSegments([
+      entry(0, 0, 2, 'Speaker 1'),
+      entry(1, 3, 5, 'Speaker 1'),
+      entry(2, 6, 8, 'Speaker 1'),
+    ]);
+    expect(paragraphs).toHaveLength(1);
+    expect(paragraphs[0]?.entries.map((e) => e.index)).toEqual([0, 1, 2]);
+    expect(paragraphs[0]?.start_s).toBe(0);
+    expect(paragraphs[0]?.end_s).toBe(8);
+    expect(paragraphs[0]?.speaker).toBe('Speaker 1');
+  });
+
+  it('merges same-speaker finals regardless of the silence between them', () => {
+    const paragraphs = groupSegments([
+      entry(0, 0, 2, 'Speaker 1'),
+      entry(1, 300, 310, 'Speaker 1'),
+    ]);
+    expect(paragraphs).toHaveLength(1);
+    expect(paragraphs[0]?.end_s).toBe(310);
+  });
+
+  it('starts a new paragraph on speaker change', () => {
+    const paragraphs = groupSegments([
+      entry(0, 0, 2, 'Speaker 1'),
+      entry(1, 2.5, 4, 'Speaker 2'),
+      entry(2, 5, 7, 'Speaker 1'),
+    ]);
+    expect(paragraphs).toHaveLength(3);
+    expect(paragraphs.map((p) => p.speaker)).toEqual([
+      'Speaker 1',
+      'Speaker 2',
+      'Speaker 1',
+    ]);
+  });
+
+  it('merges speakerless finals with each other but not with labeled ones', () => {
+    const paragraphs = groupSegments([
+      entry(0, 0, 2),
+      entry(1, 30, 35),
+      entry(2, 40, 42, 'Speaker 1'),
+      entry(3, 50, 52),
+    ]);
+    expect(paragraphs).toHaveLength(3);
+    expect(paragraphs[0]?.speaker).toBeUndefined();
+    expect(paragraphs[0]?.entries.map((e) => e.index)).toEqual([0, 1]);
+    expect(paragraphs[1]?.entries.map((e) => e.index)).toEqual([2]);
+    expect(paragraphs[2]?.entries.map((e) => e.index)).toEqual([3]);
+  });
+
+  it('preserves input order and never reorders entries', () => {
+    const paragraphs = groupSegments([
+      entry(0, 0, 2, 'Speaker 1'),
+      entry(1, 10, 12, 'Speaker 2'),
+    ]);
+    expect(paragraphs.flatMap((p) => p.entries.map((e) => e.index))).toEqual([
+      0, 1,
+    ]);
+  });
+});
+
+describe('speakerColorIndex', () => {
+  it('is deterministic for the same label', () => {
+    expect(speakerColorIndex('Speaker 1')).toBe(speakerColorIndex('Speaker 1'));
+  });
+
+  it('stays in range 0..5 for labeled and undefined inputs', () => {
+    for (const label of [
+      undefined,
+      '',
+      'Speaker 1',
+      'Speaker 2',
+      'Interviewer',
+      'A very long speaker label',
+    ]) {
+      const idx = speakerColorIndex(label);
+      expect(idx).toBeGreaterThanOrEqual(0);
+      expect(idx).toBeLessThanOrEqual(5);
+    }
+  });
+
+  it('maps undefined to slot 0', () => {
+    expect(speakerColorIndex(undefined)).toBe(0);
+  });
+});
