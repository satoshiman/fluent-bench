diff --git a/web/src/App.tsx b/web/src/App.tsx
new file mode 100644
index 0000000..b25c7ae
--- /dev/null
+++ b/web/src/App.tsx
@@ -0,0 +1,51 @@
+import { AudioLines, History, Radio } from 'lucide-react';
+import { NavLink, Outlet } from 'react-router';
+import { cn } from 'cn';
+import { buttonVariants } from '@/components/ui/button';
+
+export default function App() {
+  return (
+    <div className="flex h-screen flex-col">
+      <header className="border-b bg-background py-2">
+        <div className="mx-auto flex w-full max-w-4xl items-center gap-4 px-4">
+          <div className="flex items-center gap-2 font-semibold">
+            <AudioLines className="size-5 text-primary" />
+            fluent
+          </div>
+          <nav className="flex gap-1">
+            <NavLink
+              to="/"
+              end
+              className={({ isActive }) => navClass(isActive)}
+            >
+              <Radio data-icon="inline-start" />
+              Live
+            </NavLink>
+            <NavLink
+              to="/sessions"
+              className={({ isActive }) => navClass(isActive)}
+            >
+              <History data-icon="inline-start" />
+              Sessions
+            </NavLink>
+          </nav>
+        </div>
+      </header>
+      <main className="min-h-0 flex-1 overflow-auto">
+        <div className="mx-auto h-full w-full max-w-4xl p-4">
+          <Outlet />
+        </div>
+      </main>
+    </div>
+  );
+}
+
+function navClass(isActive: boolean) {
+  return cn(
+    buttonVariants({
+      variant: isActive ? 'secondary' : 'ghost',
+      size: 'sm',
+    }),
+    isActive && 'font-medium',
+  );
+}
diff --git a/web/src/audio/capture.ts b/web/src/audio/capture.ts
new file mode 100644
index 0000000..0cbc9fb
--- /dev/null
+++ b/web/src/audio/capture.ts
@@ -0,0 +1,239 @@
+import { PCM_PROCESSOR_SOURCE } from './processor-source';
+
+export interface CaptureHandle {
+  // pause tears down the audio graph and releases the mic, but keeps a tab
+  // share alive so resume() does not reopen the share picker. resume() throws
+  // if the handle was stopped; a revoked share falls back to a fresh picker.
+  pause: () => void;
+  resume: () => Promise<void>;
+  stop: () => void;
+  // silences the local mic without releasing it; other sources (tab audio)
+  // keep flowing. The flag persists across pause/resume because it is
+  // reapplied whenever the graph is rebuilt. No-op when no mic is present.
+  setMicMuted: (muted: boolean) => void;
+}
+
+export type CaptureOptions =
+  | { kind: 'mic' }
+  | { kind: 'device'; deviceId: string }
+  | { kind: 'tab'; includeMic: boolean };
+
+export interface InputDevice {
+  deviceId: string;
+  label: string;
+}
+
+const MIC_CONSTRAINTS: MediaTrackConstraints = {
+  channelCount: 1,
+  echoCancellation: true,
+  noiseSuppression: true,
+  autoGainControl: true,
+};
+
+// enumerateDevices hides labels until getUserMedia has run once; a quick
+// probe unlocks them so the picker can show real device names.
+export async function listInputDevices(): Promise<InputDevice[]> {
+  try {
+    const probe = await navigator.mediaDevices.getUserMedia({ audio: true });
+    for (const track of probe.getTracks()) track.stop();
+  } catch {
+    // permission denied: devices still enumerate, labels come back empty
+  }
+  const devices = await navigator.mediaDevices.enumerateDevices();
+  return devices
+    .filter((d) => d.kind === 'audioinput')
+    .map((d) => ({ deviceId: d.deviceId, label: d.label }));
+}
+
+function stopStreams(streams: MediaStream[]): void {
+  for (const stream of streams) {
+    for (const track of stream.getTracks()) track.stop();
+  }
+}
+
+// Capture + AudioWorklet -> 16kHz mono linear16 PCM chunks (ADR-006,
+// BDR-004). Multiple sources are connected into the same worklet input,
+// where Web Audio sums them; the worklet downmixes the result to mono.
+export async function startCapture(
+  opts: CaptureOptions,
+  onChunk: (buf: ArrayBuffer) => void,
+): Promise<CaptureHandle> {
+  let streams: MediaStream[] = [];
+  let stopped = false;
+  let ctx: AudioContext | undefined;
+  let node: AudioWorkletNode | undefined;
+  let sources: MediaStreamAudioSourceNode[] = [];
+  let mute: GainNode | undefined;
+  let micGain: GainNode | undefined;
+  let micMuted = false;
+  let moduleUrl: string | undefined;
+
+  const acquireMic = () =>
+    navigator.mediaDevices.getUserMedia({ audio: MIC_CONSTRAINTS });
+
+  async function acquireStreams(): Promise<MediaStream[]> {
+    const got: MediaStream[] = [];
+    try {
+      if (opts.kind === 'tab') {
+        // Chrome requires video:true even for audio-only share; the video
+        // track is kept alive (stopping it can end the share) but unused.
+        const display = await navigator.mediaDevices.getDisplayMedia({
+          video: true,
+          audio: {
+            echoCancellation: false,
+            noiseSuppression: false,
+            autoGainControl: false,
+          },
+        });
+        got.push(display);
+        if (display.getAudioTracks().length === 0) {
+          throw new Error(
+            'the shared stream has no audio track: pick a browser tab and enable "Share tab audio"',
+          );
+        }
+        if (opts.includeMic) {
+          // far-end constraints stay off on tab audio; the mic keeps echo
+          // cancellation so speaker bleed into the mic is reduced
+          got.push(await acquireMic());
+        }
+      } else {
+        const audio: MediaTrackConstraints =
+          opts.kind === 'device'
+            ? { ...MIC_CONSTRAINTS, deviceId: { exact: opts.deviceId } }
+            : MIC_CONSTRAINTS;
+        got.push(await navigator.mediaDevices.getUserMedia({ audio }));
+      }
+    } catch (err) {
+      stopStreams(got);
+      throw err;
+    }
+    return got;
+  }
+
+  async function buildGraph(): Promise<void> {
+    const context = new AudioContext();
+    ctx = context;
+    if (!moduleUrl) {
+      moduleUrl = URL.createObjectURL(
+        new Blob([PCM_PROCESSOR_SOURCE], { type: 'application/javascript' }),
+      );
+    }
+    try {
+      await context.audioWorklet.addModule(moduleUrl);
+    } catch (err) {
+      void context.close();
+      ctx = undefined;
+      throw err;
+    }
+
+    node = new AudioWorkletNode(context, 'pcm-processor');
+    sources = streams.map((s) => context.createMediaStreamSource(s));
+    // the graph must reach destination to run; a zero-gain node prevents feedback
+    mute = context.createGain();
+    mute.gain.value = 0;
+    // the mic stream is always the last source when present; it goes through
+    // its own gain so muting it leaves other sources (tab audio) untouched
+    const micIndex =
+      opts.kind === 'tab' ? (opts.includeMic ? streams.length - 1 : -1) : 0;
+    micGain = undefined;
+    for (const [i, source] of sources.entries()) {
+      if (i === micIndex) {
+        micGain = context.createGain();
+        micGain.gain.value = micMuted ? 0 : 1;
+        source.connect(micGain);
+        micGain.connect(node);
+      } else {
+        source.connect(node);
+      }
+    }
+    node.connect(mute);
+    mute.connect(context.destination);
+    node.port.onmessage = (e: MessageEvent<ArrayBuffer>) => onChunk(e.data);
+  }
+
+  function teardownGraph(): void {
+    if (!ctx) return;
+    if (node) node.port.onmessage = null;
+    for (const source of sources) source.disconnect();
+    node?.disconnect();
+    mute?.disconnect();
+    micGain?.disconnect();
+    micGain = undefined;
+    void ctx.close();
+    node = undefined;
+    sources = [];
+    mute = undefined;
+    ctx = undefined;
+  }
+
+  function revokeModuleUrl(): void {
+    if (moduleUrl) {
+      URL.revokeObjectURL(moduleUrl);
+      moduleUrl = undefined;
+    }
+  }
+
+  const handle: CaptureHandle = {
+    pause: () => {
+      if (stopped) return;
+      teardownGraph();
+      if (opts.kind === 'tab') {
+        // keep the display stream alive so resume does not reopen the share
+        // picker; release only the mic so its indicator goes out
+        const [display, ...rest] = streams;
+        stopStreams(rest);
+        streams = display ? [display] : [];
+      } else {
+        stopStreams(streams);
+        streams = [];
+      }
+    },
+    resume: async () => {
+      if (stopped) throw new Error('capture already stopped');
+      if (ctx) return; // already capturing (e.g. retry after a failed resume)
+      if (opts.kind === 'tab') {
+        const display = streams[0];
+        const alive =
+          display?.getTracks().some((t) => t.readyState === 'live') ?? false;
+        if (alive) {
+          streams = opts.includeMic ? [display!, await acquireMic()] : [display!];
+        } else {
+          // share was revoked while paused: the picker is the only way back
+          streams = await acquireStreams();
+        }
+      } else {
+        streams = await acquireStreams();
+      }
+      try {
+        await buildGraph();
+      } catch (err) {
+        stopStreams(streams);
+        streams = [];
+        throw err;
+      }
+    },
+    stop: () => {
+      if (stopped) return;
+      stopped = true;
+      teardownGraph();
+      stopStreams(streams);
+      streams = [];
+      revokeModuleUrl();
+    },
+    setMicMuted: (muted: boolean) => {
+      micMuted = muted;
+      if (micGain) micGain.gain.value = muted ? 0 : 1;
+    },
+  };
+
+  streams = await acquireStreams();
+  try {
+    await buildGraph();
+  } catch (err) {
+    stopStreams(streams);
+    streams = [];
+    revokeModuleUrl();
+    throw err;
+  }
+  return handle;
+}
diff --git a/web/src/audio/processor-source.ts b/web/src/audio/processor-source.ts
new file mode 100644
index 0000000..870f9bd
--- /dev/null
+++ b/web/src/audio/processor-source.ts
@@ -0,0 +1,51 @@
+// AudioWorklet processor source, loaded via Blob URL so it works identically
+// in dev and bundled builds. Downmixes every input channel to mono (tab
+// audio arrives stereo), then downsamples whatever the context delivers
+// (usually 48kHz) to 16kHz linear16 and posts Int16Array chunks.
+export const PCM_PROCESSOR_SOURCE = `
+class PCMProcessor extends AudioWorkletProcessor {
+  constructor() {
+    super();
+    this.targetRate = 16000;
+    this.ratio = sampleRate / this.targetRate;
+    this.pos = 0;
+    this.buf = [];
+    this.outSize = 4096;
+  }
+  process(inputs) {
+    const input = inputs[0];
+    let ch = input && input[0];
+    if (input && input.length > 1 && ch && ch.length) {
+      const mono = new Float32Array(ch.length);
+      for (let c = 0; c < input.length; c++) {
+        const src = input[c];
+        for (let i = 0; i < ch.length; i++) mono[i] += src[i] / input.length;
+      }
+      ch = mono;
+    }
+    if (ch && ch.length) {
+      const last = ch[ch.length - 1];
+      while (this.pos < ch.length) {
+        const i = Math.floor(this.pos);
+        const f = this.pos - i;
+        const a = ch[i];
+        const b = i + 1 < ch.length ? ch[i + 1] : last;
+        this.buf.push(a * (1 - f) + b * f);
+        this.pos += this.ratio;
+      }
+      this.pos -= ch.length;
+      while (this.buf.length >= this.outSize) {
+        const frame = new Int16Array(this.outSize);
+        for (let i = 0; i < this.outSize; i++) {
+          const s = Math.max(-1, Math.min(1, this.buf[i]));
+          frame[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+        }
+        this.buf = this.buf.slice(this.outSize);
+        this.port.postMessage(frame.buffer, [frame.buffer]);
+      }
+    }
+    return true;
+  }
+}
+registerProcessor('pcm-processor', PCMProcessor);
+`;
