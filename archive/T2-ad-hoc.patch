+    const log = { warn: (msg: string) => warnings.push(msg) };
+    const w = await SessionWriter.create(
+      dir,
+      meta('2026-11-05-session-1000'),
+      log,
+    );
+    await w.appendSegment(0, { text: 'Hello.', start_s: 0, end_s: 1 });
