+import { describe, expect, it } from 'vitest';
+import {
+  makeTranslator,
+  OpenAICompatTranslator,
+  renderPrompt,
+  type LLMEndpoint,
+} from './openai-compat.js';
+import { TranslationError } from './translator.js';
+import { parseConfig } from '../config.js';
+import type OpenAI from 'openai';
+
+const endpoint = (url: string, model = 'm'): LLMEndpoint => ({
+  baseURL: url,
+  apiKey: 'k',
+  model,
+});
+
+function fakeClient(behavior: Record<string, 'ok' | 'fail'>) {
+  const calls: string[] = [];
+  const factory = (ep: LLMEndpoint) =>
+    ({
+      chat: {
+        completions: {
+          create: async () => {
+            calls.push(ep.baseURL);
+            if (behavior[ep.baseURL] === 'fail') {
+              throw new Error(`boom from ${ep.baseURL}`);
+            }
+            return {
+              choices: [{ message: { content: `translated via ${ep.baseURL}` } }],
+            };
+          },
+        },
+      },
+    }) as unknown as Pick<OpenAI, 'chat'>;
+  return { calls, factory };
+}
+
+describe('OpenAICompatTranslator', () => {
+  const segment = { text: 'How are you?', speaker: 'Speaker 1' };
+
+  it('uses the primary endpoint on success', async () => {
+    const { calls, factory } = fakeClient({ 'https://p': 'ok' });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('translated via https://p');
+    expect(calls).toEqual(['https://p']);
+  });
+
+  it('retries once on the fallback when the primary errors', async () => {
+    const { calls, factory } = fakeClient({ 'https://p': 'fail', 'https://f': 'ok' });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('translated via https://f');
+    expect(calls).toEqual(['https://p', 'https://f']);
+  });
+
+  it('throws TranslationError when primary fails and no fallback exists', async () => {
+    const { factory } = fakeClient({ 'https://p': 'fail' });
+    const t = new OpenAICompatTranslator(endpoint('https://p'), undefined, factory);
+    await expect(t.translate(segment, [], 'vi')).rejects.toBeInstanceOf(
+      TranslationError,
+    );
+  });
+
+  it('throws when both primary and fallback fail', async () => {
+    const { calls, factory } = fakeClient({ 'https://p': 'fail', 'https://f': 'fail' });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    await expect(t.translate(segment, [], 'vi')).rejects.toBeInstanceOf(
+      TranslationError,
+    );
+    expect(calls).toEqual(['https://p', 'https://f']);
+  });
+
+  const respondWith = (content: string) =>
+    (() =>
+      ({
+        chat: {
+          completions: {
+            create: async () => ({ choices: [{ message: { content } }] }),
+          },
+        },
+      }) as unknown as Pick<OpenAI, 'chat'>);
+
+  it('strips an echoed speaker label from the response', async () => {
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      undefined,
+      respondWith('[Speaker 1] Bạn có khỏe không?'),
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('Bạn có khỏe không?');
+  });
+
+  it('strips a generic speaker tag echoed from context labels', async () => {
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      undefined,
+      respondWith('[Speaker 2] Bạn có khỏe không?'),
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('Bạn có khỏe không?');
+  });
+
+  it('keeps a leading bracket that is not a speaker tag', async () => {
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      undefined,
+      respondWith('[inaudible] Bạn có khỏe không?'),
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('[inaudible] Bạn có khỏe không?');
+  });
+
+  it('treats a label-only response as empty', async () => {
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      undefined,
+      respondWith('[Speaker 1]'),
+    );
+    await expect(t.translate(segment, [], 'vi')).rejects.toBeInstanceOf(
+      TranslationError,
+    );
+  });
+});
+
+describe('renderPrompt', () => {
+  it('labels the segment and context with speakers and target language', () => {
+    const out = renderPrompt(
+      { text: 'How are you?', speaker: 'Speaker 2' },
+      [{ text: 'Hello', speaker: 'Speaker 1' }, { text: 'Hi' }],
+      'Vietnamese',
+    );
+    expect(out).toContain('Target language: Vietnamese');
+    expect(out).toContain('[Speaker 1] Hello');
+    expect(out).toContain('Hi');
+    expect(out).toContain('[Speaker 2] How are you?');
+  });
+});
+
+describe('makeTranslator', () => {
+  it('builds endpoints from env config with DeepSeek non-thinking mode', async () => {
+    const seen: LLMEndpoint[] = [];
+    const factory = (ep: LLMEndpoint) => {
+      seen.push(ep);
+      return {
+        chat: {
+          completions: {
+            create: async () => ({ choices: [{ message: { content: 'ok' } }] }),
+          },
+        },
+      } as unknown as Pick<OpenAI, 'chat'>;
+    };
+    const config = parseConfig({
+      STT_PROVIDER: 'deepgram',
+      DEEPGRAM_API_KEY: 'dg',
+      LLM_API_KEY: 'sk',
+      LLM_BASE_URL: 'https://api.deepseek.com',
+      TRANSLATE_MODEL: 'deepseek-flash',
+      LLM_FALLBACK_BASE_URL: 'https://api.openai.com/v1',
+      LLM_FALLBACK_API_KEY: 'sk-fb',
+      LLM_FALLBACK_MODEL: 'gpt-4.1-mini',
+    });
+    const t = makeTranslator(config, factory);
+    const out = await t.translate({ text: 'hi' }, [], 'vi');
+    expect(out).toBe('ok');
+  });
+});
diff --git a/server/translate/openai-compat.ts b/server/translate/openai-compat.ts
new file mode 100644
index 0000000..3b05342
--- /dev/null
+++ b/server/translate/openai-compat.ts
@@ -0,0 +1,161 @@
+import OpenAI from 'openai';
+import type { Config } from '../config.js';
+import {
+  TranslationError,
+  type Translatable,
+  type Translator,
+} from './translator.js';
+
+export interface LLMEndpoint {
+  baseURL: string;
+  apiKey: string;
+  model: string;
+  extraBody?: Record<string, unknown>;
+  timeoutMs?: number;
+}
+
+type ChatClient = Pick<OpenAI, 'chat'>;
+export type ClientFactory = (endpoint: LLMEndpoint) => ChatClient;
+
+const DEFAULT_TIMEOUT_MS = 8_000;
+
+export const defaultClientFactory: ClientFactory = (endpoint) =>
+  new OpenAI({
+    baseURL: endpoint.baseURL,
+    apiKey: endpoint.apiKey,
+    timeout: endpoint.timeoutMs ?? DEFAULT_TIMEOUT_MS,
+    maxRetries: 0,
+  });
+
+// ADR-003: one OpenAI-compatible client shape serves DeepSeek (primary) and
+// OpenAI (fallback); env vars repoint it without code changes.
+export class OpenAICompatTranslator implements Translator {
+  constructor(
+    private readonly primary: LLMEndpoint,
+    private readonly fallback: LLMEndpoint | undefined,
+    private readonly clientFactory: ClientFactory = defaultClientFactory,
+  ) {}
+
+  async translate(
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<string> {
+    try {
+      return await this.request(this.primary, segment, context, targetLang);
+    } catch (err) {
+      if (!this.fallback) {
+        throw new TranslationError(
+          `primary translation failed and no fallback configured: ${msg(err)}`,
+          err,
+        );
+      }
+      try {
+        return await this.request(this.fallback, segment, context, targetLang);
+      } catch (fallbackErr) {
+        throw new TranslationError(
+          `primary and fallback translation failed: ${msg(fallbackErr)}`,
+          fallbackErr,
+        );
+      }
+    }
+  }
+
+  private async request(
+    endpoint: LLMEndpoint,
+    segment: Translatable,
+    context: readonly Translatable[],
+    targetLang: string,
+  ): Promise<string> {
+    const client = this.clientFactory(endpoint);
+    const prompt = renderPrompt(segment, context, targetLang);
+    const body: Record<string, unknown> = {
+      model: endpoint.model,
+      messages: [
+        {
+          role: 'system',
+          content:
+            'You are a live translation engine for meeting transcripts. ' +
+            'Translate the final segment into the target language. Output only ' +
+            'the translated text: no labels, no quotes, no commentary.',
+        },
+        { role: 'user', content: prompt },
+      ],
+      temperature: 0.2,
+      ...endpoint.extraBody,
+    };
+    const res = (await client.chat.completions.create(
+      body as never,
+    )) as OpenAI.ChatCompletion;
+    const text = res.choices[0]?.message?.content?.trim();
+    const cleaned = text ? stripSpeakerLabel(text, segment.speaker) : '';
+    if (!cleaned) {
+      throw new TranslationError('empty translation response');
+    }
+    return cleaned;
+  }
+}
+
+// The prompt tags segments as "[Speaker N]"; models occasionally echo the
+// tag into the output despite the no-labels instruction. Strip a leading
+// bracket only when it is a speaker tag - the segment's own label or a
+// generic "Speaker ..." tag - never legitimate bracketed text.
+export function stripSpeakerLabel(text: string, speaker?: string): string {
+  const m = /^\[([^\]\n]{1,60})\]\s*/.exec(text);
+  if (!m) return text;
+  const label = m[1]!.trim();
+  const isSpeakerTag =
+    (speaker != null && label.toLowerCase() === speaker.toLowerCase()) ||
+    /^speaker\b/i.test(label);
+  return isSpeakerTag ? text.slice(m[0].length).trimStart() : text;
+}
+
+export function renderPrompt(
+  segment: Translatable,
+  context: readonly Translatable[],
+  targetLang: string,
+): string {
+  const lines: string[] = [`Target language: ${targetLang}`];
+  if (context.length > 0) {
+    lines.push('', 'Context (already translated, for consistency only):');
+    for (const seg of context) {
+      lines.push(seg.speaker ? `[${seg.speaker}] ${seg.text}` : seg.text);
+    }
+  }
+  lines.push(
+    '',
+    'Segment to translate:',
+    segment.speaker ? `[${segment.speaker}] ${segment.text}` : segment.text,
+  );
+  return lines.join('\n');
+}
+
+// Non-thinking mode where the provider supports it (ADR-003): DeepSeek
+// accepts an explicit thinking toggle; harmless to omit for providers that
+// do not expose one.
+export function makeTranslator(
+  config: Config,
+  clientFactory?: ClientFactory,
+): Translator {
+  const primary: LLMEndpoint = {
+    baseURL: config.LLM_BASE_URL,
+    apiKey: config.LLM_API_KEY ?? '',
+    model: config.TRANSLATE_MODEL,
+  };
+  if (/deepseek/i.test(config.LLM_BASE_URL)) {
+    primary.extraBody = { thinking: { type: 'disabled' } };
+  }
+  const fallback: LLMEndpoint | undefined =
+    config.LLM_FALLBACK_BASE_URL && config.LLM_FALLBACK_API_KEY
+      ? {
+          baseURL: config.LLM_FALLBACK_BASE_URL,
+          apiKey: config.LLM_FALLBACK_API_KEY,
+          model: config.LLM_FALLBACK_MODEL,
+        }
+      : undefined;
+  return new OpenAICompatTranslator(primary, fallback, clientFactory ?? defaultClientFactory);
+}
+
+function msg(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
