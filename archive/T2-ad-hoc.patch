@@ -0,0 +1,48 @@
+import type { Config } from '../config.js';
+import { AssemblyAIProvider } from './assemblyai.js';
+import { DeepgramProvider } from './deepgram.js';
+import { withIdleTimeout } from './idle-timeout.js';
+import type { STTProvider } from './provider.js';
+
+export class ProviderConfigError extends Error {
+  readonly code = 'PROVIDER_CONFIG';
+}
+
+// ADR-002: diarization needs Deepgram; with diarization off the designated
+// low-cost path is AssemblyAI when its key is configured.
+export function createSTTProvider(config: Config, diarize: boolean): STTProvider {
+  const provider = resolveProviderName(config, diarize);
+  if (provider === 'assemblyai') {
+    if (!config.ASSEMBLYAI_API_KEY) {
+      throw new ProviderConfigError(
+        'ASSEMBLYAI_API_KEY is required for this session configuration',
+      );
+    }
+    return withIdleTimeout(
+      new AssemblyAIProvider(config.ASSEMBLYAI_API_KEY),
+      config.STT_IDLE_TIMEOUT_S,
+    );
+  }
+  if (!config.DEEPGRAM_API_KEY) {
+    throw new ProviderConfigError(
+      'DEEPGRAM_API_KEY is required for this session configuration',
+    );
+  }
+  return withIdleTimeout(
+    new DeepgramProvider(config.DEEPGRAM_API_KEY),
+    config.STT_IDLE_TIMEOUT_S,
+  );
+}
+
+function resolveProviderName(config: Config, diarize: boolean): 'deepgram' | 'assemblyai' {
+  if (diarize) {
+    if (config.STT_PROVIDER === 'assemblyai') {
+      throw new ProviderConfigError(
+        'Diarization requires Deepgram; set STT_PROVIDER=deepgram or start the session with diarization off',
+      );
+    }
+    return 'deepgram';
+  }
+  if (config.STT_PROVIDER === 'assemblyai') return 'assemblyai';
+  return config.ASSEMBLYAI_API_KEY ? 'assemblyai' : 'deepgram';
+}
