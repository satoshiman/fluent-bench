@@ -0,0 +1,234 @@
+import {
+  useCallback,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from 'react';
+import { useNavigate, useParams } from 'react-router';
+import { ArrowLeft, CircleHelp, Clock, ScrollText } from 'lucide-react';
+import { toast } from 'sonner';
+import { cn } from 'cn';
+import { SessionAudioPlayer } from '@/components/audio-player';
+import { AssistEntries } from '@/components/assist';
+import { SpeakerChip } from '@/components/transcript';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
+import { Skeleton } from '@/components/ui/skeleton';
+import { sessionsApi } from '@/lib/api';
+import { parseAssist } from '@/lib/parse-assist';
+import { activeCueIndex, parseSrt } from '@/lib/parse-srt';
+import { speakerColorIndex } from '@/lib/transcript-groups';
+import type { StoredSession } from '@/lib/types';
+
+function fmtDuration(s: number): string {
+  const t = Math.round(s);
+  const m = Math.floor(t / 60);
+  const sec = t % 60;
+  const h = Math.floor(m / 60);
+  return h > 0
+    ? `${h}:${String(m % 60).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
+    : `${m}:${String(sec).padStart(2, '0')}`;
+}
+
+function fmtClock(s: number): string {
+  const t = Math.max(0, Math.round(s));
+  const mm = String(Math.floor(t / 60)).padStart(2, '0');
+  const ss = String(t % 60).padStart(2, '0');
+  return `${mm}:${ss}`;
+}
+
+export function ReviewPage() {
+  const { id = '' } = useParams<{ id: string }>();
+  const navigate = useNavigate();
+  const [session, setSession] = useState<StoredSession | null>(null);
+  const audioRef = useRef<HTMLAudioElement | null>(null);
+  const cardRefs = useRef<Array<HTMLElement | null>>([]);
+  const [activeIdx, setActiveIdx] = useState(-1);
+  const [follow, setFollow] = useState(true);
+
+  useEffect(() => {
+    sessionsApi
+      .get(id)
+      .then(setSession)
+      .catch((err: unknown) =>
+        toast.error(
+          err instanceof Error ? err.message : 'failed to load session',
+        ),
+      );
+  }, [id]);
+
+  // Speaker prefixes are only stripped when they match a known name:
+  // frontmatter labels and the renamed display names alike (ADR-007).
+  const knownSpeakers = useMemo(() => {
+    const names = new Set<string>();
+    for (const [label, name] of Object.entries(session?.meta.speakers ?? {})) {
+      names.add(label);
+      names.add(name);
+    }
+    return names;
+  }, [session]);
+
+  const cues = useMemo(
+    () => (session ? parseSrt(session.srt, knownSpeakers) : []),
+    [session, knownSpeakers],
+  );
+  const assists = useMemo(
+    () => (session ? parseAssist(session.assist) : []),
+    [session],
+  );
+
+  // Seek-bar ticks: one per cue start position, oldest first.
+  const marks = useMemo(() => cues.map((c) => c.start_s), [cues]);
+
+  // Playback position -> active cue highlight (+ follow scroll).
+  const onTime = useCallback(
+    (t: number) => setActiveIdx(activeCueIndex(marks, t)),
+    [marks],
+  );
+
+  useEffect(() => {
+    if (!follow || activeIdx < 0) return;
+    cardRefs.current[activeIdx]?.scrollIntoView({
+      block: 'nearest',
+      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        ? 'auto'
+        : 'smooth',
+    });
+  }, [activeIdx, follow]);
+
+  if (!session) {
+    return (
+      <div className="flex flex-col gap-3">
+        <Skeleton className="h-8 w-64" />
+        <Skeleton className="h-96 w-full" />
+      </div>
+    );
+  }
+
+  const { meta } = session;
+
+  // cue starts are cumulative WAV positions (PLAN-010), so a click seeks the
+  // recording to the start of that segment
+  const seek = (seconds: number) => {
+    const audio = audioRef.current;
+    if (!audio) return;
+    audio.currentTime = seconds;
+    void audio.play();
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex flex-wrap items-center gap-2">
+        <Button variant="ghost" size="sm" onClick={() => navigate('/sessions')}>
+          <ArrowLeft data-icon="inline-start" />
+          Back
+        </Button>
+        <Badge variant="secondary" className="font-mono">
+          {meta.id}
+        </Badge>
+        <Badge variant="outline">
+          {meta.source_lang} → {meta.target_lang}
+        </Badge>
+        <Badge variant="outline">{meta.stt_provider}</Badge>
+        {meta.diarization ? <Badge variant="outline">diarization</Badge> : null}
+        {meta.duration_s != null ? (
+          <Badge variant="outline" className="font-mono">
+            <Clock data-icon="inline-start" />
+            {fmtDuration(meta.duration_s)}
+          </Badge>
+        ) : null}
+        {meta.audio_file ? (
+          <Badge variant="secondary">rec</Badge>
+        ) : null}
+        {Object.entries(meta.speakers).map(([label, name]) => (
+          <Badge key={label} variant="secondary">
+            {label}: {name}
+          </Badge>
+        ))}
+      </div>
+      {meta.audio_file ? (
+        <SessionAudioPlayer
+          src={sessionsApi.audioUrl(meta.id)}
+          marks={marks}
+          audioRef={audioRef}
+          follow={follow}
+          onToggleFollow={() => setFollow((f) => !f)}
+          onTime={onTime}
+        />
+      ) : null}
+      <Card>
+        <CardHeader>
+          <CardTitle className="flex items-center gap-2">
+            <ScrollText className="size-4" />
+            Transcript
+          </CardTitle>
+        </CardHeader>
+        <CardContent>
+          {cues.length === 0 ? (
+            <p className="text-sm text-muted-foreground">No transcript.</p>
+          ) : (
+            <div className="flex flex-col gap-1">
+              {cues.map((cue, i) => (
+                <div
+                  key={cue.index}
+                  ref={(el) => {
+                    cardRefs.current[i] = el;
+                  }}
+                  role="button"
+                  tabIndex={0}
+                  aria-label={`Play from ${fmtClock(cue.start_s)}`}
+                  onClick={() => seek(cue.start_s)}
+                  onKeyDown={(e) => {
+                    if (e.key === 'Enter' || e.key === ' ') {
+                      e.preventDefault();
+                      seek(cue.start_s);
+                    }
+                  }}
+                  style={{
+                    borderLeftColor: `var(--speaker-${speakerColorIndex(cue.speaker) + 1})`,
+                  }}
+                  className={cn(
+                    'flex cursor-pointer flex-col gap-1.5 rounded-md border-l-2 py-2 pl-3 pr-2 outline-none transition-colors',
+                    'hover:bg-muted/50 focus-visible:ring-2 focus-visible:ring-ring/50',
+                    i === activeIdx && 'bg-primary/10',
+                  )}
+                >
+                  <div className="flex items-center gap-2">
+                    <span className="rounded bg-muted px-1.5 py-0.5 font-mono text-xs tabular-nums text-muted-foreground">
+                      {fmtClock(cue.start_s)}
+                    </span>
+                    {cue.speaker !== undefined &&
+                    !(cue.speaker in meta.speakers) ? (
+                      <SpeakerChip label={cue.speaker} />
+                    ) : null}
+                  </div>
+                  <p className="text-sm leading-relaxed">{cue.source}</p>
+                  {cue.translation ? (
+                    <p className="text-xs leading-relaxed text-primary">
+                      {cue.translation}
+                    </p>
+                  ) : null}
+                </div>
+              ))}
+            </div>
+          )}
+        </CardContent>
+      </Card>
+      {assists.length > 0 ? (
+        <Card>
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <CircleHelp className="size-4" />
+              Assist
+            </CardTitle>
+          </CardHeader>
+          <CardContent>
+            <AssistEntries entries={assists} />
+          </CardContent>
+        </Card>
+      ) : null}
+    </div>
+  );
+}
diff --git a/web/src/pages/Sessions.tsx b/web/src/pages/Sessions.tsx
new file mode 100644
index 0000000..e62ce27
--- /dev/null
+++ b/web/src/pages/Sessions.tsx
@@ -0,0 +1,154 @@
+import { useEffect, useState } from 'react';
+import { useNavigate } from 'react-router';
+import { BookOpen, History, Radio } from 'lucide-react';
+import { toast } from 'sonner';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
+import {
+  Empty,
+  EmptyDescription,
+  EmptyHeader,
+  EmptyMedia,
+  EmptyTitle,
+} from '@/components/ui/empty';
+import { Skeleton } from '@/components/ui/skeleton';
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from '@/components/ui/table';
+import { LiveDot } from '@/components/transcript';
+import { sessionsApi } from '@/lib/api';
+import type { SessionSummary } from '@/lib/types';
+
+function fmtDur(s: number | null): string {
+  if (s == null) return '…';
+  const m = Math.floor(s / 60);
+  const sec = Math.round(s % 60);
+  return m > 0 ? `${m}m ${sec}s` : `${sec}s`;
+}
+
+export function SessionsPage() {
+  const navigate = useNavigate();
+  const [sessions, setSessions] = useState<SessionSummary[] | null>(null);
+  const [activeId, setActiveId] = useState<string | null>(null);
+
+  useEffect(() => {
+    sessionsApi
+      .list()
+      .then((res) => {
+        setSessions(res.sessions);
+        setActiveId(res.active?.id ?? null);
+      })
+      .catch((err: unknown) =>
+        toast.error(
+          err instanceof Error ? err.message : 'failed to load sessions',
+        ),
+      );
+  }, []);
+
+  if (sessions === null) {
+    return (
+      <div className="flex flex-col gap-3">
+        <Skeleton className="h-8 w-48" />
+        <Skeleton className="h-64 w-full" />
+      </div>
+    );
+  }
+
+  if (sessions.length === 0) {
+    return (
+      <Empty className="mt-20 border">
+        <EmptyHeader>
+          <EmptyMedia variant="icon">
+            <BookOpen />
+          </EmptyMedia>
+          <EmptyTitle>No sessions yet</EmptyTitle>
+          <EmptyDescription>
+            Start a live session and the Markdown transcript will appear here.
+          </EmptyDescription>
+        </EmptyHeader>
+      </Empty>
+    );
+  }
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle className="flex items-center gap-2">
+          <History className="size-4" />
+          Sessions
+        </CardTitle>
+      </CardHeader>
+      <CardContent>
+        <Table>
+          <TableHeader>
+            <TableRow>
+              <TableHead>Session</TableHead>
+              <TableHead>Started</TableHead>
+              <TableHead>Duration</TableHead>
+              <TableHead>Languages</TableHead>
+              <TableHead>STT</TableHead>
+              <TableHead className="text-right">Segments</TableHead>
+              <TableHead />
+            </TableRow>
+          </TableHeader>
+          <TableBody>
+            {sessions.map((s) => (
+              <TableRow key={s.id}>
+                <TableCell className="font-mono text-xs">
+                  {s.id}
+                  {s.id === activeId ? (
+                    <Badge variant="secondary" className="ml-2">
+                      <LiveDot />
+                      live
+                    </Badge>
+                  ) : null}
+                </TableCell>
+                <TableCell className="text-xs">
+                  {s.started_at
+                    ? new Date(s.started_at).toLocaleString()
+                    : '—'}
+                </TableCell>
+                <TableCell className="text-xs">{fmtDur(s.duration_s)}</TableCell>
+                <TableCell className="text-xs">
+                  {s.source_lang} → {s.target_lang}
+                </TableCell>
+                <TableCell className="text-xs">
+                  {s.stt_provider}
+                  {s.diarization ? ' +diar' : ''}
+                </TableCell>
+                <TableCell className="text-right text-xs">
+                  {s.segments}
+                </TableCell>
+                <TableCell className="text-right">
+                  {s.id === activeId ? (
+                    <Button
+                      variant="ghost"
+                      size="sm"
+                      onClick={() => navigate('/')}
+                    >
+                      <Radio data-icon="inline-start" />
+                      Live
+                    </Button>
+                  ) : null}
+                  <Button
+                    variant="outline"
+                    size="sm"
+                    onClick={() => navigate(`/sessions/${s.id}`)}
+                  >
+                    Review
+                  </Button>
+                </TableCell>
+              </TableRow>
+            ))}
+          </TableBody>
+        </Table>
+      </CardContent>
+    </Card>
+  );
+}
