@@ -0,0 +1,157 @@
+import { DeepgramClient } from '@deepgram/sdk';
+import type {
+  Segment,
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+export interface DgSocketLike {
+  on(event: 'open' | 'close', cb: () => void): void;
+  on(event: 'message', cb: (msg: unknown) => void): void;
+  on(event: 'error', cb: (err: Error) => void): void;
+  connect(): void;
+  sendMedia(chunk: ArrayBufferView): void;
+  sendCloseStream(msg: { type: string }): void;
+  close(): void;
+  readyState?: number;
+}
+
+export type DgConnect = (args: Record<string, unknown>) => Promise<DgSocketLike>;
+
+interface DgResultsMessage {
+  type?: string;
+  is_final?: boolean;
+  start?: number;
+  duration?: number;
+  channel?: {
+    alternatives?: Array<{
+      transcript?: string;
+      words?: Array<{ speaker?: number; start?: number; end?: number }>;
+    }>;
+  };
+}
+
+export class DeepgramProvider implements STTProvider {
+  readonly name = 'deepgram';
+  readonly supports_diarization = true;
+
+  constructor(
+    private readonly apiKey: string,
+    private readonly connectFn?: DgConnect,
+  ) {}
+
+  async start_stream(opts: StreamOptions, events: StreamEvents): Promise<STTStream> {
+    const connect =
+      this.connectFn ??
+      (async (args: Record<string, unknown>) => {
+        const client = new DeepgramClient({ apiKey: this.apiKey });
+        const connectArgs = {
+          ...args,
+          Authorization: `Token ${this.apiKey}`,
+          reconnectAttempts: 0,
+        } as Parameters<typeof client.listen.v1.connect>[0];
+        const socket = await client.listen.v1.connect(connectArgs);
+        return socket as unknown as DgSocketLike;
+      });
+
+    const socket = await connect({
+      model: opts.model ?? 'nova-3',
+      language: opts.language ?? 'en',
+      encoding: 'linear16',
+      sample_rate: opts.sampleRate ?? 16000,
+      channels: 1,
+      interim_results: true,
+      smart_format: true,
+      endpointing: 300,
+      diarize: opts.diarize,
+      ...(opts.keyterms && opts.keyterms.length > 0
+        ? { keyterm: opts.keyterms }
+        : {}),
+    });
+
+    socket.on('message', (msg) => this.handleResults(msg, events));
+    socket.on('error', (err) => events.onError(toError(err)));
+    socket.on('close', () => events.onClose?.());
+
+    // connect() resolves before the handshake finishes, so early audio must
+    // wait for 'open' (bounded buffer). sendMedia throws synchronously when
+    // the socket is not open; lifecycle errors arrive via error/close events.
+    const READY_OPEN = 1;
+    const READY_CONNECTING = 0;
+    const MAX_BUFFERED = 64;
+    const preOpen: Buffer[] = [];
+    let sendFailed = false;
+
+    socket.on('open', () => {
+      for (const c of preOpen) {
+        try {
+          socket.sendMedia(c);
+        } catch {
+          break;
+        }
+      }
+      preOpen.length = 0;
+    });
+
+    // SDK 5.17 creates the underlying socket with startClosed: the object
+    // returned by listen.v1.connect() never opens until connect() is called.
+    // Handlers are attached above so nothing is missed once it opens.
+    socket.connect();
+
+    return {
+      send_audio: (chunk: Buffer) => {
+        if (sendFailed) return;
+        const rs = socket.readyState;
+        if (rs === READY_CONNECTING) {
+          if (preOpen.length < MAX_BUFFERED) preOpen.push(chunk);
+          return;
+        }
+        if (rs !== undefined && rs !== READY_OPEN) return;
+        try {
+          socket.sendMedia(chunk);
+        } catch (err) {
+          sendFailed = true;
+          events.onError(toError(err));
+          try {
+            socket.close();
+          } catch {
+            // already closed
+          }
+        }
+      },
+      close: () => {
+        try {
+          socket.sendCloseStream({ type: 'CloseStream' });
+        } catch {
+          // socket may already be gone; close below covers it
+        }
+        socket.close();
+      },
+    };
+  }
+
+  private handleResults(msg: unknown, events: StreamEvents): void {
+    const m = msg as DgResultsMessage;
+    if (!m || m.type !== 'Results') return;
+    const alt = m.channel?.alternatives?.[0];
+    const text = alt?.transcript?.trim() ?? '';
+    if (!text) return;
+
+    const seg: Segment = {
+      text,
+      start_s: m.start ?? 0,
+      end_s: (m.start ?? 0) + (m.duration ?? 0),
+    };
+    const speakerIdx = alt?.words?.find((w) => w.speaker != null)?.speaker;
+    if (speakerIdx != null) seg.speaker = `Speaker ${speakerIdx + 1}`;
+
+    if (m.is_final) events.onFinal(seg);
+    else events.onPartial(seg);
+  }
+}
+
+function toError(err: unknown): Error {
+  return err instanceof Error ? err : new Error(String(err));
+}
