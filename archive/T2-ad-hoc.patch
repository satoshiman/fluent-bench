+import type { FinalEntry } from './use-live-session';
+
+export interface TranscriptParagraph {
+  speaker?: string;
+  start_s: number;
+  end_s: number;
+  entries: FinalEntry[];
+}
+
+export function groupSegments(
+  finals: FinalEntry[],
+): TranscriptParagraph[] {
+  const paragraphs: TranscriptParagraph[] = [];
+  for (const entry of finals) {
+    const paragraph = paragraphs[paragraphs.length - 1];
+    const last = paragraph?.entries[paragraph.entries.length - 1];
+    if (
+      paragraph &&
+      last &&
+      last.segment.speaker === entry.segment.speaker
+    ) {
+      paragraph.entries.push(entry);
+      paragraph.end_s = entry.segment.end_s;
+    } else {
+      paragraphs.push({
+        ...(entry.segment.speaker !== undefined
+          ? { speaker: entry.segment.speaker }
+          : {}),
+        start_s: entry.segment.start_s,
+        end_s: entry.segment.end_s,
+        entries: [entry],
+      });
+    }
+  }
+  return paragraphs;
+}
+
+export function speakerColorIndex(label: string | undefined): number {
+  if (label === undefined) return 0;
+  let sum = 0;
+  for (let i = 0; i < label.length; i++) {
+    sum += label.charCodeAt(i);
+  }
+  return sum % 6;
+}
