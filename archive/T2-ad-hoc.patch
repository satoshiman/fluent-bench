+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { WavRecorder } from './wav-recorder.js';
+
+let dir: string;
+
+beforeEach(async () => {
+  dir = await fs.mkdtemp(path.join(os.tmpdir(), 'fluent-wav-'));
+});
+afterEach(async () => {
+  await fs.rm(dir, { recursive: true, force: true });
+});
+
+const wavPath = () => path.join(dir, 'clip.wav');
+
+describe('WavRecorder', () => {
+  it('writes a canonical 16kHz mono s16 WAV with patched sizes', async () => {
+    const rec = await WavRecorder.create(wavPath());
+    const payload = Buffer.alloc(3200, 0x5a);
+    await rec.append(payload.subarray(0, 2000));
+    await rec.append(payload.subarray(2000));
+    expect(rec.bytesWritten).toBe(3200);
+    await rec.finalize();
+
+    const buf = await fs.readFile(wavPath());
+    expect(buf.length).toBe(44 + 3200);
+    expect(buf.subarray(0, 4).toString('ascii')).toBe('RIFF');
+    expect(buf.readUInt32LE(4)).toBe(36 + 3200);
+    expect(buf.subarray(8, 12).toString('ascii')).toBe('WAVE');
+    expect(buf.subarray(12, 16).toString('ascii')).toBe('fmt ');
+    expect(buf.readUInt16LE(20)).toBe(1); // PCM
+    expect(buf.readUInt16LE(22)).toBe(1); // mono
+    expect(buf.readUInt32LE(24)).toBe(16000);
+    expect(buf.readUInt32LE(28)).toBe(32000); // byteRate
+    expect(buf.readUInt16LE(32)).toBe(2); // blockAlign
+    expect(buf.readUInt16LE(34)).toBe(16);
+    expect(buf.subarray(36, 40).toString('ascii')).toBe('data');
+    expect(buf.readUInt32LE(40)).toBe(3200);
+    expect(buf.subarray(44)).toEqual(payload);
+  });
+
+  it('serializes concurrent appends in arrival order', async () => {
+    const rec = await WavRecorder.create(wavPath());
+    const a = Buffer.alloc(100, 0x01);
+    const b = Buffer.alloc(50, 0x02);
+    await Promise.all([rec.append(a), rec.append(b)]);
+    await rec.finalize();
+    const buf = await fs.readFile(wavPath());
+    expect(buf.subarray(44, 144)).toEqual(a);
+    expect(buf.subarray(144)).toEqual(b);
+  });
+
+  it('finalize is idempotent', async () => {
+    const rec = await WavRecorder.create(wavPath());
+    await rec.append(Buffer.alloc(10, 0x07));
+    await rec.finalize();
+    await rec.finalize();
+    const buf = await fs.readFile(wavPath());
+    expect(buf.readUInt32LE(40)).toBe(10);
+  });
+
+  it('abort closes the file and removes it', async () => {
+    const rec = await WavRecorder.create(wavPath());
+    await rec.append(Buffer.alloc(10, 0x07));
+    await rec.abort();
+    await expect(fs.access(wavPath())).rejects.toThrow();
+  });
+
+  it('refuses to clobber an existing file', async () => {
+    await fs.writeFile(wavPath(), 'occupied');
+    await expect(WavRecorder.create(wavPath())).rejects.toThrow();
+  });
+});
