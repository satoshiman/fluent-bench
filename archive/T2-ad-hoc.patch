+
+describe('parseSrtTimestamp', () => {
+  it('parses HH:MM:SS,mmm', () => {
+    expect(parseSrtTimestamp('00:00:02,000')).toBe(2);
+    expect(parseSrtTimestamp('00:00:04,800')).toBe(4.8);
+    expect(parseSrtTimestamp('01:02:05,250')).toBe(3725.25);
+  });
+
+  it('returns null for non-timestamps', () => {
+    expect(parseSrtTimestamp('00:02')).toBeNull();
+    expect(parseSrtTimestamp('abc')).toBeNull();
+    expect(parseSrtTimestamp('00:00:02.000')).toBeNull();
+  });
+});
+
+describe('parseSrt', () => {
+  it('parses a single cue without translation', () => {
+    const cues = parseSrt(
+      '1\n00:00:02,000 --> 00:00:04,800\nHello.\n\n',
+      KNOWN,
+    );
+    expect(cues).toEqual([
+      {
+        index: 0,
+        start_s: 2,
+        end_s: 4.8,
+        source: 'Hello.',
+        translation: null,
+      },
+    ]);
+  });
+
+  it('parses multiple cues with speaker prefix and translation', () => {
+    const srt = [
+      '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\nXin chào.',
+      '2\n00:00:05,100 --> 00:00:08,200\nInterviewer: Hi there.',
+      '3\n00:00:09,000 --> 00:00:10,000\nPlain text.',
+      '',
+    ].join('\n\n');
+    const cues = parseSrt(srt, KNOWN);
+    expect(cues).toHaveLength(3);
+    expect(cues[0]).toMatchObject({
+      index: 0,
+      speaker: 'Speaker 1',
+      source: 'Hello.',
+      translation: 'Xin chào.',
+    });
+    expect(cues[1]).toMatchObject({
+      index: 1,
+      speaker: 'Interviewer',
+      source: 'Hi there.',
+      translation: null,
+    });
+    expect(cues[2]).toMatchObject({
+      index: 2,
+      source: 'Plain text.',
+    });
+    expect(cues[2]?.speaker).toBeUndefined();
+  });
+
+  it('keeps an unknown `Name: ` prefix inside source', () => {
+    const cues = parseSrt(
+      '1\n00:00:00,000 --> 00:00:01,000\nStranger: hello\n\n',
+      KNOWN,
+    );
+    expect(cues[0]?.speaker).toBeUndefined();
+    expect(cues[0]?.source).toBe('Stranger: hello');
+  });
+
+  it('keeps text containing colons that is not a speaker prefix', () => {
+    const cues = parseSrt(
+      '1\n00:00:00,000 --> 00:00:01,000\nNote: 12:30 is late\n\n',
+      KNOWN,
+    );
+    expect(cues[0]?.speaker).toBeUndefined();
+    expect(cues[0]?.source).toBe('Note: 12:30 is late');
+  });
+
+  it('handles empty and malformed input', () => {
+    expect(parseSrt('', KNOWN)).toEqual([]);
+    expect(parseSrt('no cues here', KNOWN)).toEqual([]);
+    expect(
+      parseSrt('1\nnot-a-timestamp\nHello.\n\n', KNOWN),
+    ).toEqual([]);
+  });
+});
+
+describe('activeCueIndex', () => {
+  const starts = [0, 5, 13, 42];
+
+  it('picks the last cue whose start is <= t', () => {
+    expect(activeCueIndex(starts, 0)).toBe(0);
+    expect(activeCueIndex(starts, 4.9)).toBe(0);
+    expect(activeCueIndex(starts, 5)).toBe(1);
+    expect(activeCueIndex(starts, 20)).toBe(2);
+    expect(activeCueIndex(starts, 999)).toBe(3);
+  });
+
+  it('returns -1 before the first cue and for empty input', () => {
+    expect(activeCueIndex(starts, -1)).toBe(-1);
+    expect(activeCueIndex([], 10)).toBe(-1);
+  });
+});
diff --git a/web/src/lib/parse-srt.ts b/web/src/lib/parse-srt.ts
new file mode 100644
index 0000000..b9c3b9c
--- /dev/null
+++ b/web/src/lib/parse-srt.ts
@@ -0,0 +1,80 @@
+// Parses the bilingual .srt session artifact (ADR-007): numbered cues,
+// `HH:MM:SS,mmm --> HH:MM:SS,mmm`, first text line = source (with optional
+// `Name: ` speaker prefix), second text line = translation.
+export interface TranscriptCue {
+  index: number;
+  start_s: number;
+  end_s: number;
+  speaker?: string;
+  source: string;
+  translation: string | null;
+}
+
+export function parseSrtTimestamp(text: string): number | null {
+  const m = /^(\d{2}):(\d{2}):(\d{2}),(\d{3})$/.exec(text.trim());
+  if (!m) return null;
+  return (
+    Number(m[1]) * 3600 +
+    Number(m[2]) * 60 +
+    Number(m[3]) +
+    Number(m[4]) / 1000
+  );
+}
+
+// A leading `NAME: ` is stripped into `speaker` only when NAME is a known
+// speaker (frontmatter keys + values). Anything else stays part of `source`,
+// so real text containing colons is never misparsed.
+export function parseSrt(
+  text: string,
+  knownSpeakers: ReadonlySet<string>,
+): TranscriptCue[] {
+  const cues: TranscriptCue[] = [];
+  for (const block of text.split(/\n{2,}/)) {
+    if (block.trim() === '') continue;
+    const lines = block.split('\n');
+    const num = Number(lines[0]?.trim());
+    if (!Number.isInteger(num) || num < 1) continue;
+    const ts = /^(\S+) --> (\S+)$/.exec(lines[1]?.trim() ?? '');
+    if (!ts) continue;
+    const start_s = parseSrtTimestamp(ts[1]!);
+    const end_s = parseSrtTimestamp(ts[2]!);
+    if (start_s == null || end_s == null) continue;
+    const first = lines[2] ?? '';
+    let speaker: string | undefined;
+    let source = first;
+    const prefix = /^(.+?): /.exec(first);
+    if (prefix && knownSpeakers.has(prefix[1]!)) {
+      speaker = prefix[1]!;
+      source = first.slice(prefix[0].length);
+    }
+    const translation =
+      lines.length > 3 ? lines.slice(3).join('\n') : null;
+    cues.push({
+      index: num - 1,
+      start_s,
+      end_s,
+      ...(speaker !== undefined ? { speaker } : {}),
+      source,
+      translation,
+    });
+  }
+  return cues;
+}
+
+// Index of the cue a playback position falls into: the last start <= t
+// (small epsilon absorbs timestamp rounding), or -1 before the first one.
+export function activeCueIndex(starts: number[], t: number): number {
+  let lo = 0;
+  let hi = starts.length - 1;
+  let ans = -1;
+  while (lo <= hi) {
+    const mid = (lo + hi) >> 1;
+    if (starts[mid]! <= t + 0.01) {
+      ans = mid;
+      lo = mid + 1;
+    } else {
+      hi = mid - 1;
+    }
+  }
+  return ans;
+}
