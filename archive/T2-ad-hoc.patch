+  // feed on every final is the heaviest part of the strip
+  const [transcriptOn, setTranscriptOn] = useState(true);
+  // toggling assist on jumps to its tab; toggling off leaves the view alone
+  const [prevAssistActive, setPrevAssistActive] = useState(props.assistActive);
+  if (props.assistActive !== prevAssistActive) {
+    setPrevAssistActive(props.assistActive);
