+describe('session export', () => {
+  it('serves the stored bilingual transcript as a .vtt attachment', async () => {
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/sessions',
+      payload: { diarize: true },
+    });
+    expect(res.statusCode).toBe(201);
+    const info = res.json() as { id: string };
+
+    const { ws, messages } = connectWs();
+    await vi.waitFor(() => expect(messages.length).toBeGreaterThan(0));
+
+    // the translation broadcast fires after the .srt splice lands on disk
+    provider.emitFinal({ text: 'Hello.', speaker: 'Speaker 1', start_s: 1, end_s: 2 });
+    await vi.waitFor(() =>
+      expect(messages.some((m) => m.type === 'translation')).toBe(true),
+    );
+    await app.inject({ method: 'POST', url: `/api/sessions/${info.id}/stop` });
+
+    const vtt = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export?format=vtt`,
+    });
+    expect(vtt.statusCode).toBe(200);
+    expect(vtt.headers['content-type']).toContain('text/vtt');
+    expect(vtt.headers['content-disposition']).toBe(
+      `attachment; filename="${info.id}.vtt"`,
+    );
+    expect(vtt.body.startsWith('WEBVTT\n\n')).toBe(true);
+    expect(vtt.body).toMatch(
+      /\d{2}:\d{2}:\d{2}\.\d{3} --> \d{2}:\d{2}:\d{2}\.\d{3}/,
+    );
+    // same content as the .srt: speaker-prefixed source + translation
+    expect(vtt.body).toContain('Speaker 1: Hello.');
+    expect(vtt.body).toContain('XIN CHÀO');
+    expect(vtt.body).not.toMatch(/\d{2}:\d{2}:\d{2},\d{3}/);
+    ws.close();
+  });
+
+  it('404s for an unknown session id', async () => {
+    const res = await app.inject({
+      method: 'GET',
+      url: '/api/sessions/nope-1/export?format=vtt',
+    });
+    expect(res.statusCode).toBe(404);
+  });
+
+  it('400s for an unsupported or missing format', async () => {
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/sessions',
+      payload: {},
+    });
+    const info = res.json() as { id: string };
+    await app.inject({ method: 'POST', url: `/api/sessions/${info.id}/stop` });
+
+    const bad = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export?format=txt`,
+    });
+    expect(bad.statusCode).toBe(400);
+
+    const missing = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export`,
+    });
+    expect(missing.statusCode).toBe(400);
+  });
+});
+
