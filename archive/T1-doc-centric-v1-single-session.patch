@@ -0,0 +1,42 @@
+import { describe, expect, it } from 'vitest';
+import { srtToVtt } from './vtt.js';
+
+describe('srtToVtt', () => {
+  const srt = [
+    '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\nXin chào.',
+    '2\n00:00:05,100 --> 00:00:08,200\nHi there.',
+    '',
+  ].join('\n\n');
+
+  it('emits a WEBVTT header and dot-separated cue timings', () => {
+    expect(srtToVtt(srt)).toBe(
+      [
+        'WEBVTT',
+        '',
+        '1\n00:00:02.000 --> 00:00:04.800\nSpeaker 1: Hello.\nXin chào.',
+        '',
+        '2\n00:00:05.100 --> 00:00:08.200\nHi there.',
+        '',
+      ].join('\n'),
+    );
+  });
+
+  it('keeps cue numbers as identifiers and translation lines as payload', () => {
+    const vtt = srtToVtt(srt);
+    expect(vtt).not.toMatch(/\d{2},\d{3}/);
+    expect(vtt).toContain('\n1\n');
+    expect(vtt).toContain('Xin chào.');
+  });
+
+  it('returns a header-only document for an empty transcript', () => {
+    expect(srtToVtt('')).toBe('WEBVTT\n');
+    expect(srtToVtt('\n\n')).toBe('WEBVTT\n');
+  });
+
+  it('escapes & < > in cue payload text', () => {
+    const vtt = srtToVtt(
+      '1\n00:00:00,000 --> 00:00:01,000\na < b & c > d\n\n',
+    );
+    expect(vtt).toContain('a &lt; b &amp; c &gt; d');
+  });
+});
diff --git a/server/session/vtt.ts b/server/session/vtt.ts
new file mode 100644
index 0000000..caa4b45
--- /dev/null
+++ b/server/session/vtt.ts
@@ -0,0 +1,29 @@
+// WebVTT rendering of the stored bilingual .srt (ADR-007). The .srt remains
+// the canonical artifact; export re-renders the same cue content in WebVTT
+// syntax for players that only accept .vtt: WEBVTT header, `.` decimal
+// separator in cue timings, cue numbers kept as cue identifiers.
+
+function escapeVttText(text: string): string {
+  return text
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+export function srtToVtt(srt: string): string {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const cues = blocks.map((block) =>
+    block
+      .split('\n')
+      .map((line, i) => {
+        // `HH:MM:SS,mmm` -> `HH:MM:SS.mmm` on the timing line only; text
+        // lines are payload, where & < > must be escaped in WebVTT. Line 0
+        // is the cue number, carried over as the cue identifier verbatim.
+        if (line.includes(' --> ')) return line.replace(/,/g, '.');
+        return i === 0 ? line : escapeVttText(line);
+      })
+      .join('\n'),
+  );
+  const body = cues.join('\n\n');
+  return body === '' ? 'WEBVTT\n' : `WEBVTT\n\n${body}\n`;
+}
