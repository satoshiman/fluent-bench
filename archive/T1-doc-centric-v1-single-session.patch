 const startSchema = z.object({
   targetLang: z.string().min(1).max(60).optional(),
@@ -75,6 +76,28 @@ export function registerSessionRoutes(
     return stored;
   });
 
+  // Transcript export: the stored bilingual .srt re-rendered as WebVTT.
+  // Session existence is checked before the format value so an unknown id
+  // is a 404 regardless of the query string.
+  app.get('/api/sessions/:id/export', async (req, reply) => {
+    const { id } = req.params as { id: string };
+    const stored = await readSession(sessions.dir, id);
+    if (!stored) {
+      return reply.code(404).send({ error: `session not found: ${id}` });
+    }
+    const { format } = req.query as { format?: string };
+    if (format !== 'vtt') {
+      return reply
+        .code(400)
+        .send({ error: `unsupported export format: ${format ?? 'missing'}` });
+    }
+    const filename = `${id.replace(/[^\w.-]+/g, '_')}.vtt`;
+    return reply
+      .header('Content-Type', 'text/vtt; charset=utf-8')
+      .header('Content-Disposition', `attachment; filename="${filename}"`)
+      .send(srtToVtt(stored.srt));
+  });
+
   // Optional session audio (PLAN-010): only sessions whose frontmatter
   // carries `audio_file` have a WAV to serve. Single-range support is all
   // the <audio> element needs for seek.
