@@ -0,0 +1,122 @@
+import { describe, expect, it } from 'vitest';
+import { isTransientLlmError, withRetry, type LlmRetryOptions } from './retry.js';
+
+const noSleep = () => Promise.resolve();
+
+function trackingSleep() {
+  const delays: number[] = [];
+  const sleep = async (ms: number) => {
+    delays.push(ms);
+  };
+  return { delays, sleep };
+}
+
+describe('isTransientLlmError', () => {
+  it('treats 429 and 5xx as transient', () => {
+    expect(isTransientLlmError({ status: 429 })).toBe(true);
+    expect(isTransientLlmError({ status: 500 })).toBe(true);
+    expect(isTransientLlmError({ status: 503 })).toBe(true);
+  });
+
+  it('treats other statuses as non-transient', () => {
+    expect(isTransientLlmError({ status: 400 })).toBe(false);
+    expect(isTransientLlmError({ status: 401 })).toBe(false);
+    expect(isTransientLlmError({ status: 404 })).toBe(false);
+    expect(isTransientLlmError({ status: 200 })).toBe(false);
+  });
+
+  it('treats failures without a numeric status as transient (network)', () => {
+    expect(isTransientLlmError(new Error('socket hang up'))).toBe(true);
+    expect(isTransientLlmError({ status: undefined })).toBe(true);
+    expect(isTransientLlmError({ status: '500' })).toBe(true);
+  });
+});
+
+describe('withRetry', () => {
+  const options = (extra?: LlmRetryOptions): LlmRetryOptions => ({
+    sleep: noSleep,
+    ...extra,
+  });
+
+  it('resolves on first success without sleeping', async () => {
+    const { delays, sleep } = trackingSleep();
+    let calls = 0;
+    const out = await withRetry(
+      async () => {
+        calls++;
+        return 'ok';
+      },
+      isTransientLlmError,
+      { sleep },
+    );
+    expect(out).toBe('ok');
+    expect(calls).toBe(1);
+    expect(delays).toEqual([]);
+  });
+
+  it('retries a transient failure then succeeds with doubling delays', async () => {
+    const { delays, sleep } = trackingSleep();
+    let calls = 0;
+    const out = await withRetry(
+      async () => {
+        calls++;
+        if (calls <= 2) throw Object.assign(new Error('bad'), { status: 500 });
+        return 'ok';
+      },
+      isTransientLlmError,
+      { sleep, random: () => 0.5 },
+    );
+    expect(out).toBe('ok');
+    expect(calls).toBe(3);
+    expect(delays).toEqual([500, 1000]);
+  });
+
+  it('rethrows non-retryable failures immediately', async () => {
+    const { delays, sleep } = trackingSleep();
+    const err = Object.assign(new Error('nope'), { status: 400 });
+    let calls = 0;
+    await expect(
+      withRetry(
+        async () => {
+          calls++;
+          throw err;
+        },
+        isTransientLlmError,
+        { sleep },
+      ),
+    ).rejects.toBe(err);
+    expect(calls).toBe(1);
+    expect(delays).toEqual([]);
+  });
+
+  it('exhausts after the configured attempts and rethrows the last error', async () => {
+    const last = Object.assign(new Error('last'), { status: 503 });
+    let calls = 0;
+    await expect(
+      withRetry(
+        async () => {
+          calls++;
+          throw calls === 3 ? last : Object.assign(new Error('x'), { status: 500 });
+        },
+        isTransientLlmError,
+        options({ attempts: 3 }),
+      ),
+    ).rejects.toBe(last);
+    expect(calls).toBe(3);
+  });
+
+  it('never retries with attempts: 1', async () => {
+    let calls = 0;
+    await expect(
+      withRetry(
+        async () => {
+          calls++;
+          throw Object.assign(new Error('x'), { status: 500 });
+        },
+        isTransientLlmError,
+        options({ attempts: 1 }),
+      ),
+    ).rejects.toThrow('x');
+    expect(calls).toBe(1);
+  });
+});
