     )) as OpenAI.ChatCompletion;
     const text = res.choices[0]?.message?.content?.trim();
     const cleaned = text ? stripSpeakerLabel(text, segment.speaker) : '';
@@ -159,3 +184,39 @@ export function makeTranslator(
 function msg(err: unknown): string {
   return err instanceof Error ? err.message : String(err);
 }
+
+// Walks the cause chain: SDK connection errors, retryable HTTP statuses,
+// and raw network error codes (incl. undici causes under fetch TypeErrors).
+function isTransientError(err: unknown): boolean {
+  let cur: unknown = err;
+  for (let depth = 0; cur && depth < 5; depth += 1) {
+    if (cur instanceof OpenAI.APIConnectionError) return true;
+    if (cur instanceof OpenAI.APIError) {
+      const status = cur.status ?? 0;
+      return status >= 500 || RETRYABLE_STATUSES.has(status);
+    }
+    const code = (cur as { code?: unknown }).code;
+    if (typeof code === 'string' && RETRYABLE_CODES.has(code)) return true;
+    cur = (cur as { cause?: unknown }).cause;
+  }
+  return false;
+}
+
+async function withRetry<T>(fn: () => Promise<T>): Promise<T> {
+  for (let attempt = 1; ; attempt += 1) {
+    try {
+      return await fn();
+    } catch (err) {
+      if (attempt >= REQUEST_ATTEMPTS || !isTransientError(err)) throw err;
+      const backoff = Math.min(
+        RETRY_BASE_DELAY_MS * 2 ** (attempt - 1),
+        RETRY_MAX_DELAY_MS,
+      );
+      await sleep(backoff * (0.5 + Math.random()));
+    }
+  }
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((r) => setTimeout(r, ms));
+}
