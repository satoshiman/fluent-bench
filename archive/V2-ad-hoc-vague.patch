     baseURL: endpoint.baseURL,
@@ -84,8 +109,8 @@ export class OpenAICompatTranslator implements Translator {
       temperature: 0.2,
       ...endpoint.extraBody,
     };
-    const res = (await client.chat.completions.create(
-      body as never,
+    const res = (await withRetry(() =>
