 const DEFAULT_TIMEOUT_MS = 8_000;
 
+// Transient network failures get a few quick retries on the same endpoint
+// before the fallback is burned. The OpenAI client keeps maxRetries: 0 so
+// this is the only retry layer; the manager retries whole translations on
+// a slower cadence on top of it.
+const REQUEST_ATTEMPTS = 3;
+const RETRY_BASE_DELAY_MS = 250;
+const RETRY_MAX_DELAY_MS = 2_000;
+
+const RETRYABLE_STATUSES = new Set([408, 409, 425, 429]);
+const RETRYABLE_CODES = new Set([
+  'ECONNRESET',
+  'ECONNREFUSED',
+  'ECONNABORTED',
+  'ETIMEDOUT',
+  'EAI_AGAIN',
+  'ENOTFOUND',
+  'ENETUNREACH',
+  'EHOSTUNREACH',
+  'EPIPE',
+  'UND_ERR_CONNECT_TIMEOUT',
+  'UND_ERR_HEADERS_TIMEOUT',
+  'UND_ERR_BODY_TIMEOUT',
+  'UND_ERR_SOCKET',
+]);
+
 export const defaultClientFactory: ClientFactory = (endpoint) =>
