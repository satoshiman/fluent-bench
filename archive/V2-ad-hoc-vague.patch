+  // Each URL fails `times` times with the error factory, then succeeds.
+  function flakyClient(
+    failures: Record<string, { times: number; error: () => unknown }>,
+  ) {
+    const calls: string[] = [];
+    const remaining = new Map(
+      Object.entries(failures).map(([url, f]) => [url, { ...f }]),
+    );
+    const factory = (ep: LLMEndpoint) =>
+      ({
+        chat: {
+          completions: {
+            create: async () => {
+              calls.push(ep.baseURL);
+              const f = remaining.get(ep.baseURL);
+              if (f && f.times > 0) {
+                f.times -= 1;
+                throw f.error();
+              }
+              return {
+                choices: [
+                  { message: { content: `translated via ${ep.baseURL}` } },
+                ],
+              };
+            },
+          },
+        },
+      }) as unknown as Pick<OpenAI, 'chat'>;
+    return { calls, factory };
+  }
+
+  it('retries a transient network error on the same endpoint', async () => {
+    const { calls, factory } = flakyClient({
+      'https://p': {
+        times: 2,
+        error: () =>
+          Object.assign(new Error('socket hang up'), { code: 'ECONNRESET' }),
+      },
+    });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('translated via https://p');
+    expect(calls).toEqual(['https://p', 'https://p', 'https://p']);
+  });
+
+  it('retries SDK connection and 5xx errors before falling back', async () => {
+    const { calls, factory } = flakyClient({
+      'https://p': {
+        times: Infinity,
+        error: () =>
+          calls.length % 2 === 0
+            ? new OpenAI.APIConnectionError({ message: 'connection failed' })
+            : new OpenAI.APIError(500, {}, 'oops', new Headers()),
+      },
+    });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    const out = await t.translate(segment, [], 'vi');
+    expect(out).toBe('translated via https://f');
+    expect(calls).toEqual([
+      'https://p',
+      'https://p',
+      'https://p',
+      'https://f',
+    ]);
+  });
+
+  it('gives up on an endpoint after exhausting transient retries', async () => {
+    const err = () =>
+      Object.assign(new Error('timed out'), { code: 'ETIMEDOUT' });
+    const { calls, factory } = flakyClient({
+      'https://p': { times: Infinity, error: err },
+      'https://f': { times: Infinity, error: err },
+    });
+    const t = new OpenAICompatTranslator(
+      endpoint('https://p'),
+      endpoint('https://f'),
+      factory,
+    );
+    await expect(t.translate(segment, [], 'vi')).rejects.toBeInstanceOf(
+      TranslationError,
+    );
+    expect(calls).toEqual([
+      'https://p',
+      'https://p',
+      'https://p',
+      'https://f',
+      'https://f',
+      'https://f',
+    ]);
+  });
+
