+// Rewrites cue `index + 1` in place: the end timestamp becomes
+// formatSrtTimestamp(endS) and ` ` + oneLine(text) is appended to the
+// first text line (the source line). A translation line already present
+// is preserved untouched. Returns the updated document, or null when the
+// cue is missing.
+export function extendCue(
+  srt: string,
+  index: number,
+  endS: number,
+  text: string,
+): string | null {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const target = String(index + 1);
+  for (let i = 0; i < blocks.length; i++) {
+    const lines = blocks[i]!.split('\n');
+    if (lines[0]?.trim() !== target) continue;
+    const stamp = lines[1];
+    if (!stamp?.includes(' --> ')) continue;
+    lines[1] = `${stamp.split(' --> ')[0]} --> ${formatSrtTimestamp(endS)}`;
+    if (lines[2] !== undefined) {
+      lines[2] = `${lines[2]} ${oneLine(text)}`;
+    }
+    blocks[i] = lines.join('\n');
+    return `${blocks.join('\n\n')}\n\n`;
+  }
+  return null;
+}
+
+// Sets the translation (last text line) of cue `index + 1`: replaces the
+// existing second text line when present, otherwise appends it. Returns
+// the updated document, or null when the cue is missing.
+export function setCueTranslation(
+  srt: string,
+  index: number,
+  text: string,
+): string | null {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const target = String(index + 1);
+  for (let i = 0; i < blocks.length; i++) {
+    const lines = blocks[i]!.split('\n');
+    if (lines[0]?.trim() !== target) continue;
+    if (!lines[1]?.includes(' --> ')) continue;
+    if (lines.length > 3) {
+      lines[lines.length - 1] = oneLine(text);
+    } else {
+      lines.push(oneLine(text));
+    }
+    blocks[i] = lines.join('\n');
+    return `${blocks.join('\n\n')}\n\n`;
+  }
+  return null;
+}
