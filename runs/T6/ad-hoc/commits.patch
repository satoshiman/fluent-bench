--- a/server/session/srt.ts
+++ b/server/session/srt.ts
@@ -37,6 +37,54 @@ export function formatCue(
   ].join('\n');
 }
 
+// Merges `text` into the last cue (same-speaker run folding): the cue's end
+// timestamp stretches to `end_s` and the source line gains the text,
+// space-joined. Lines after the source (a landed translation) survive
+// untouched. Returns null when the file holds no cue to merge into.
+export function mergeCueText(
+  srt: string,
+  end_s: number,
+  text: string,
+): string | null {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const last = blocks[blocks.length - 1];
+  if (last === undefined) return null;
+  const lines = last.split('\n');
+  const ts = /^(\S+) --> \S+$/.exec(lines[1]?.trim() ?? '');
+  if (!ts || lines.length < 3) return null;
+  lines[1] = `${ts[1]} --> ${formatSrtTimestamp(end_s)}`;
+  lines[2] = `${lines[2]} ${oneLine(text)}`;
+  blocks[blocks.length - 1] = lines.join('\n');
+  return `${blocks.join('\n\n')}\n\n`;
+}
+
+// Upserts cue `cueNumber`'s translation line: pushes `text` when the cue has
+// none yet, else space-joins it onto the existing line. Used when segments
+// folded into one cue each land their own translation so the merged cue
+// collects them in order, mirroring the source text. Returns null when the
+// cue is missing.
+export function upsertTranslationLine(
+  srt: string,
+  cueNumber: number,
+  text: string,
+): string | null {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  const target = String(cueNumber);
+  for (let i = 0; i < blocks.length; i++) {
+    const lines = blocks[i]!.split('\n');
+    if (lines[0]?.trim() !== target) continue;
+    if (!lines[1]?.includes(' --> ')) continue;
+    if (lines.length > 3) {
+      lines[lines.length - 1] = `${lines[lines.length - 1]} ${oneLine(text)}`;
+    } else {
+      lines.push(oneLine(text));
+    }
+    blocks[i] = lines.join('\n');
+    return `${blocks.join('\n\n')}\n\n`;
+  }
+  return null;
+}
+
 // Inserts `text` as the last text line of cue `index + 1`. Returns null when
 // the cue is missing or already carries a second text line (a landed
 // translation); the caller logs and skips the write.
