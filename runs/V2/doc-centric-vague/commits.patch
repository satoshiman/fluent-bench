+export interface RetryPolicy {
+  attempts: number; // total tries per endpoint, minimum 1
+  baseDelayMs: number;
+  maxDelayMs: number;
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export const DEFAULT_RETRY_POLICY: RetryPolicy = {
+  attempts: 3,
+  baseDelayMs: 250,
+  maxDelayMs: 2_000,
+};
+
+const sleep = (ms: number): Promise<void> =>
+  new Promise((resolve) => setTimeout(resolve, ms));
+
+// Check order matters: APIConnectionError is an APIError subclass whose
+// status is undefined, so it must be tested before the generic APIError
+// branch. APIUserAbortError (also status undefined) falls through to
+// non-retryable: a deliberate abort is never retried.
+export function isRetryableTranslationError(err: unknown): boolean {
+  if (err instanceof OpenAI.APIConnectionError) return true;
+  if (err instanceof OpenAI.APIError) {
+    const status = err.status;
+    return (
+      status === 408 ||
+      status === 409 ||
+      status === 429 ||
+      (status != null && status >= 500)
+    );
+  }
+  if (err instanceof TranslationError) return false;
+  return true;
+}
