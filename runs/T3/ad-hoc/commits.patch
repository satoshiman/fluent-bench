+import { EventEmitter } from 'node:events';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { DeepgramProvider, type DgSocketLike } from './deepgram.js';
+import {
+  SttReconnectError,
+  withReconnect,
+  type ReconnectOptions,
+} from './reconnect.js';
+import { stubEvents } from './contract.js';
+import type {
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+class FakeDgSocket extends EventEmitter implements DgSocketLike {
+  binary: Buffer[] = [];
+  json: unknown[] = [];
+  closedFlag = false;
+  readyState?: number;
+  connect(): void {}
+  sendMedia(chunk: ArrayBufferView): void {
+    this.binary.push(
+      Buffer.from(chunk.buffer as ArrayBuffer, chunk.byteOffset, chunk.byteLength),
+    );
+  }
+  sendCloseStream(msg: { type: string }): void {
+    this.json.push(msg);
+  }
+  close(): void {
+    this.closedFlag = true;
+    this.emit('close');
+  }
+}
+
+// DeepgramProvider + mocked socket: no client construction, no network.
+function dgHarness(
+  reconnectOpts: ReconnectOptions = {},
+  onSocket?: (s: FakeDgSocket) => void,
+) {
+  const sockets: FakeDgSocket[] = [];
+  const inner = new DeepgramProvider('test-key', async () => {
+    const s = new FakeDgSocket();
+    sockets.push(s);
+    onSocket?.(s);
+    return s;
+  });
+  const provider = withReconnect(inner, {
+    baseDelayMs: 2,
+    rng: () => 0,
+    ...reconnectOpts,
+  });
+  return { provider, sockets };
+}
+
+describe('withReconnect', () => {
+  afterEach(() => vi.useRealTimers());
+
+  it('reopens the stream on unexpected socket close and keeps the session alive', async () => {
+    const { provider, sockets } = dgHarness();
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    stream.send_audio(Buffer.from('a'));
+    sockets[0]!.emit('close');
+
+    await vi.waitFor(() => expect(sockets).toHaveLength(2));
+    stream.send_audio(Buffer.from('b'));
+    expect(sockets[1]!.binary.map(String)).toContain('b');
+    // the logical stream never surfaced a close
+    expect(events.closedCount).toBe(0);
+    stream.close();
+  });
+
+  it('buffers audio sent while disconnected and flushes it on reconnect', async () => {
+    const { provider, sockets } = dgHarness({ baseDelayMs: 50 });
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    sockets[0]!.emit('close');
+    stream.send_audio(Buffer.from('during-1'));
+    stream.send_audio(Buffer.from('during-2'));
+    expect(sockets[0]!.binary).toHaveLength(0);
+
+    await vi.waitFor(() => expect(sockets).toHaveLength(2));
+    await vi.waitFor(() =>
+      expect(sockets[1]!.binary.map(String)).toEqual([
+        'during-1',
+        'during-2',
+      ]),
+    );
+    stream.send_audio(Buffer.from('live'));
+    expect(sockets[1]!.binary.map(String)).toContain('live');
+    stream.close();
+  });
+
+  it('reconnects on socket error, forwards the error, and tears the dead socket down', async () => {
+    const { provider, sockets } = dgHarness();
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    sockets[0]!.emit('error', new Error('boom'));
+
+    await vi.waitFor(() => expect(sockets).toHaveLength(2));
+    expect(events.errors[0]?.message).toBe('boom');
+    expect(sockets[0]!.closedFlag).toBe(true);
+    expect(events.closedCount).toBe(0);
+    stream.close();
+  });
+
+  it('does not reconnect after a deliberate close()', async () => {
+    const { provider, sockets } = dgHarness();
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    stream.close();
+    await new Promise((r) => setTimeout(r, 60));
+
+    expect(sockets).toHaveLength(1);
+    expect(sockets[0]!.closedFlag).toBe(true);
+    expect(events.closedCount).toBe(1);
+  });
+
+  it('cancels a pending reconnect when close() lands mid-backoff', async () => {
+    const { provider, sockets } = dgHarness({ baseDelayMs: 40 });
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    sockets[0]!.emit('close');
+    stream.close();
+    await new Promise((r) => setTimeout(r, 80));
+
+    expect(sockets).toHaveLength(1);
+    expect(events.closedCount).toBe(1);
+  });
+
+  it('retries with exponential backoff before each attempt', async () => {
+    vi.useFakeTimers();
+    const { provider, sockets } = dgHarness({
+      baseDelayMs: 1_000,
+      rng: () => 0,
+    });
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    sockets[0]!.emit('close');
+    // rng() = 0 -> attempt 1 lands at exactly half the 1s base
+    await vi.advanceTimersByTimeAsync(499);
+    expect(sockets).toHaveLength(1);
+    await vi.advanceTimersByTimeAsync(2);
+    expect(sockets).toHaveLength(2);
+
+    sockets[1]!.emit('close');
+    await vi.advanceTimersByTimeAsync(999);
+    expect(sockets).toHaveLength(2);
+    await vi.advanceTimersByTimeAsync(2);
+    expect(sockets).toHaveLength(3);
+
+    sockets[2]!.emit('close');
+    await vi.advanceTimersByTimeAsync(1999);
+    expect(sockets).toHaveLength(3);
+    await vi.advanceTimersByTimeAsync(2);
+    expect(sockets).toHaveLength(4);
+    stream.close();
+  });
+
+  it('surfaces STT_RECONNECT_FAILED and closes after 5 exhausted attempts', async () => {
+    // every socket the provider opens drops immediately
+    const { provider, sockets } = dgHarness({ baseDelayMs: 2 }, (s) =>
+      setTimeout(() => s.emit('close'), 0),
+    );
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+
+    await vi.waitFor(() =>
+      expect(
+        events.errors.some(
+          (e) =>
+            e instanceof SttReconnectError &&
+            e.code === 'STT_RECONNECT_FAILED',
+        ),
+      ).toBe(true),
+    );
+
+    // initial connect + 5 reconnect attempts
+    expect(sockets).toHaveLength(6);
+    expect(events.closedCount).toBe(1);
+    stream.close();
+  });
+
+  it('counts failed reconnect opens toward the attempt limit', async () => {
+    // first connect works; every reconnect throws instead of opening a socket
+    let calls = 0;
+    let firstEvents: StreamEvents | undefined;
+    const flaky: STTProvider = {
+      name: 'flaky',
+      supports_diarization: false,
+      start_stream(_o: StreamOptions, ev: StreamEvents): Promise<STTStream> {
+        calls += 1;
+        if (calls === 1) {
+          firstEvents = ev;
+          return Promise.resolve({
+            send_audio: () => {},
+            close: () => ev.onClose?.(),
+          });
+        }
+        return Promise.reject(new Error('connect failed'));
+      },
+    };
+    const provider = withReconnect(flaky, { baseDelayMs: 2, rng: () => 0 });
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: false }, events);
+
+    // unexpected drop reported by the dead stream itself
+    firstEvents?.onClose?.();
+
+    await vi.waitFor(() =>
+      expect(
+        events.errors.some((e) => e instanceof SttReconnectError),
+      ).toBe(true),
+    );
+    // initial connect + 5 rejected reconnect attempts
+    expect(calls).toBe(6);
+    expect(events.closedCount).toBe(1);
+    stream.close();
+  });
+
+  it('forwards provider results through the reconnect wrapper unchanged', async () => {
+    const { provider, sockets } = dgHarness();
+    const events = stubEvents();
+    const stream = await provider.start_stream({ diarize: true }, events);
+    sockets[0]!.emit('message', {
+      type: 'Results',
+      is_final: true,
+      start: 0,
+      duration: 1,
+      channel: { alternatives: [{ transcript: 'hello', words: [] }] },
+    });
+    expect(events.finals.map((s) => s.text)).toContain('hello');
+    stream.close();
+  });
+});
