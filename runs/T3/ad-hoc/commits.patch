+import type {
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+export class SttReconnectError extends Error {
+  readonly code = 'STT_RECONNECT_FAILED';
+  constructor(attempts: number) {
+    super(
+      `speech-to-text stream dropped; reconnect failed after ${attempts} attempts`,
+    );
+    this.name = 'SttReconnectError';
+  }
+}
+
+export interface ReconnectOptions {
+  maxAttempts?: number;
+  baseDelayMs?: number;
+  maxDelayMs?: number;
+  maxBuffered?: number;
+  rng?: () => number;
+}
+
+// A new connection that survives this long counts as recovered: the attempt
+// budget resets, so a flapping link still exhausts instead of retrying forever.
+const STABLE_MS = 15_000;
+
+// An unexpected provider socket drop mid-session must not kill the session:
+// reopen the stream with exponential backoff (base 1s, doubling, jittered) and
+// queue audio in the meantime so little of the transcript is lost. Deliberate
+// close() (pause/stop/shutdown) never retries.
+export function withReconnect(
+  provider: STTProvider,
+  opts: ReconnectOptions = {},
+): STTProvider {
+  const maxAttempts = opts.maxAttempts ?? 5;
+  const baseDelayMs = opts.baseDelayMs ?? 1_000;
+  const maxDelayMs = opts.maxDelayMs ?? 30_000;
+  const maxBuffered = opts.maxBuffered ?? 256;
+  const rng = opts.rng ?? Math.random;
+
+  return {
+    name: provider.name,
+    supports_diarization: provider.supports_diarization,
+    async start_stream(
+      streamOpts: StreamOptions,
+      events: StreamEvents,
+    ): Promise<STTStream> {
+      let inner: STTStream | undefined;
+      let done = false;
+      let reconnecting = false;
+      let attempts = 0;
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      let stableTimer: ReturnType<typeof setTimeout> | undefined;
+      const pending: Buffer[] = [];
+
+      const delayMs = (attempt: number) => {
+        const backoff = Math.min(maxDelayMs, baseDelayMs * 2 ** (attempt - 1));
+        return Math.round(backoff * (0.5 + rng() * 0.5));
+      };
+
+      const onDrop = () => {
+        if (done || reconnecting) return;
+        if (attempts >= maxAttempts) {
+          done = true;
+          events.onError(new SttReconnectError(attempts));
+          events.onClose?.();
+          return;
+        }
+        attempts += 1;
+        reconnecting = true;
+        timer = setTimeout(() => {
+          timer = undefined;
+          void reopen();
+        }, delayMs(attempts));
+        timer.unref();
+      };
+
+      const killInner = (stream: STTStream) => {
+        if (inner !== stream) return; // stale or already dropped
+        inner = undefined;
+        try {
+          stream.close();
+        } catch {
+          // already gone
+        }
+        onDrop();
+      };
+
+      const openInner = async (): Promise<STTStream> => {
+        const self: { current?: STTStream } = {};
+        let closeSeen = false;
+        const stream = await provider.start_stream(streamOpts, {
+          onPartial: (s) => events.onPartial(s),
+          onFinal: (s) => events.onFinal(s),
+          // providers only surface fatal socket errors, so an error is a drop
+          // signal too; killInner recycles the socket before it can leak
+          onError: (err) => {
+            if (done) return;
+            events.onError(err);
+            if (self.current) killInner(self.current);
+          },
+          onClose: () => {
+            if (closeSeen) return;
+            closeSeen = true;
+            if (done) {
+              // parity with the bare provider: deliberate close still emits
+              events.onClose?.();
+              return;
+            }
+            if (self.current) killInner(self.current);
+          },
+        });
+        self.current = stream;
+        return stream;
+      };
+
+      const reopen = async () => {
+        let stream: STTStream;
+        try {
+          stream = await openInner();
+        } catch {
+          reconnecting = false;
+          onDrop();
+          return;
+        }
+        if (done) {
+          // session was stopped/paused while the reconnect was in flight
+          try {
+            stream.close();
+          } catch {
+            // already gone
+          }
+          return;
+        }
+        inner = stream;
+        reconnecting = false;
+        if (stableTimer) clearTimeout(stableTimer);
+        stableTimer = setTimeout(() => {
+          attempts = 0;
+        }, STABLE_MS);
+        stableTimer.unref();
+        const queued = pending.splice(0);
+        for (const chunk of queued) {
+          try {
+            stream.send_audio(chunk);
+          } catch {
+            break;
+          }
+        }
+        events.onReconnected?.();
+      };
+
+      inner = await openInner();
+
+      return {
+        send_audio: (chunk: Buffer) => {
