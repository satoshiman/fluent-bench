+        close: () => {
+          if (done) return;
+          done = true;
+          if (timer) {
+            clearTimeout(timer);
+            timer = undefined;
+          }
+          if (stableTimer) {
+            clearTimeout(stableTimer);
+            stableTimer = undefined;
+          }
+          pending.length = 0;
+          const stale = inner;
+          inner = undefined;
+          if (stale) {
+            try {
+              stale.close();
+            } catch {
