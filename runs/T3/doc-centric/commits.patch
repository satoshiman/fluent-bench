+++ b/server/stt/reconnect.ts
@@ -0,0 +1,202 @@
+import type {
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+export interface ReconnectOptions {
+  maxAttempts?: number;
+  baseDelayMs?: number;
+  stableMs?: number;
+  maxPendingChunks?: number;
+  random?: () => number;
+}
+
+export class SttReconnectError extends Error {
+  readonly code = 'STT_RECONNECT_FAILED';
+  readonly attempts: number;
+  constructor(attempts: number, cause?: Error) {
+    super(`STT stream lost; reconnect failed after ${attempts} attempts`, {
+      cause,
+    });
+    this.name = 'SttReconnectError';
+    this.attempts = attempts;
+  }
+}
+
+// Provider-side sockets drop mid-session; rather than ending the session,
+// retry the stream transparently (BDR-001 real-time requirement) inside a
+// bounded retry window (BDR-002 cost ceiling, ADR-002 billing hygiene).
+export function withReconnect(
+  provider: STTProvider,
+  opts: ReconnectOptions = {},
+): STTProvider {
+  const maxAttempts = opts.maxAttempts ?? 5;
+  const baseDelayMs = opts.baseDelayMs ?? 1000;
+  const stableMs = opts.stableMs ?? 5000;
+  const maxPendingChunks = opts.maxPendingChunks ?? 512;
+  const random = opts.random ?? Math.random;
+
+  return {
+    name: provider.name,
+    supports_diarization: provider.supports_diarization,
+    async start_stream(
+      streamOpts: StreamOptions,
+      events: StreamEvents,
+    ): Promise<STTStream> {
+      let deliberate = false;
+      let inner: STTStream | null = null;
+      const pending: Buffer[] = [];
+      let attempts = 0;
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      let openedAt = 0;
+      let lastError: Error | undefined;
+      let exhausted = false;
+      let recovering = false;
+      let closeForwarded = false;
+
+      const forwardClose = () => {
+        if (closeForwarded) return;
+        closeForwarded = true;
+        events.onClose?.();
+      };
+
+      const delayFor = (n: number) => baseDelayMs * 2 ** (n - 1) * random();
+
+      const scheduleAttempt = () => {
+        if (deliberate) return;
+        if (attempts >= maxAttempts) {
+          exhausted = true;
+          recovering = false;
+          pending.length = 0;
+          const dead = inner;
+          inner = null;
+          if (dead) {
+            try {
+              dead.close();
+            } catch {
+              // already gone
+            }
+          }
+          events.onError(new SttReconnectError(attempts, lastError));
+          forwardClose();
+          return;
+        }
+        attempts++;
+        timer = setTimeout(connect, delayFor(attempts));
+      };
+
+      const beginReconnect = () => {
+        // A stream that survived >= stableMs counts as a new incident with a
+        // fresh budget; a socket dying right after open burns the same one.
+        if (Date.now() - openedAt >= stableMs) attempts = 0;
+        scheduleAttempt();
+      };
+
+      const connect = async () => {
+        try {
+          const fresh = await provider.start_stream(streamOpts, wrappedEvents);
+          if (deliberate) {
+            // Opened after the caller stopped: a stray billable socket.
+            try {
+              fresh.close();
+            } catch {
+              // already gone
+            }
+            return;
+          }
+          inner = fresh;
+          recovering = false;
+          openedAt = Date.now();
+          for (const chunk of pending.splice(0)) {
+            try {
+              inner.send_audio(chunk);
+            } catch {
+              break;
+            }
+          }
+          pending.length = 0;
+          events.onReconnect?.();
+        } catch (err) {
+          lastError = err instanceof Error ? err : new Error(String(err));
+          scheduleAttempt();
+        }
+      };
+
+      const wrappedEvents: StreamEvents = {
+        onPartial: (seg) => events.onPartial(seg),
+        onFinal: (seg) => events.onFinal(seg),
+        onError: (err) => {
+          lastError = err;
+          if (deliberate) {
+            events.onError(err);
+            return;
+          }
+          if (recovering || exhausted) return;
+          // Transient errors are held from the client; the stream only
+          // surfaces an error once retries exhaust.
+          recovering = true;
+          const dead = inner;
+          inner = null;
+          if (dead) {
+            try {
+              dead.close();
+            } catch {
+              // already gone
+            }
+          }
+          beginReconnect();
+        },
+        onClose: () => {
+          if (deliberate) {
+            forwardClose();
+            return;
+          }
+          if (recovering || exhausted) return;
+          recovering = true;
+          inner = null;
+          beginReconnect();
+        },
+      };
+
+      // First-connect failures still reject session start; only established
+      // streams are reconnected.
+      inner = await provider.start_stream(streamOpts, wrappedEvents);
+      openedAt = Date.now();
+
+      return {
+        send_audio: (chunk: Buffer) => {
+          if (deliberate || exhausted) return;
+          const target = inner;
+          if (target === null) {
+            pending.push(chunk);
+            if (pending.length > maxPendingChunks) pending.shift();
+            return;
+          }
+          try {
+            target.send_audio(chunk);
+          } catch {
+            // providers must not throw, but stay safe if one does
+          }
+        },
+        close: () => {
+          deliberate = true;
+          if (timer) clearTimeout(timer);
+          recovering = false;
+          pending.length = 0;
+          const dead = inner;
+          inner = null;
+          if (dead) {
+            try {
+              dead.close();
+            } catch {
+              // already gone
+            }
+          }
+          forwardClose();
+        },
+      };
+    },
+  };
+}
