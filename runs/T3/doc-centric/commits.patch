+import { EventEmitter } from 'node:events';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { SttReconnectError, withReconnect } from './reconnect.js';
+import { DeepgramProvider, type DgSocketLike } from './deepgram.js';
+import { AssemblyAIProvider, type WSLike } from './assemblyai.js';
+import type {
+  STTProvider,
+  STTStream,
+  StreamEvents,
+  StreamOptions,
+} from './provider.js';
+
+class FakeStream implements STTStream {
+  audio: Buffer[] = [];
+  closed = false;
+  send_audio(c: Buffer): void {
+    this.audio.push(c);
+  }
+  close(): void {
+    this.closed = true;
+  }
+}
+
+class ScriptedProvider implements STTProvider {
+  readonly name = 'scripted';
+  readonly supports_diarization = false;
+  startCount = 0;
+  streams: FakeStream[] = [];
+  rejectCount = 0;
+  private lastEvents?: StreamEvents;
+
+  start_stream(_opts: StreamOptions, events: StreamEvents): Promise<STTStream> {
+    this.startCount++;
+    this.lastEvents = events;
+    if (this.rejectCount > 0) {
+      this.rejectCount--;
+      return Promise.reject(new Error('connect failed'));
+    }
+    const stream = new FakeStream();
+    this.streams.push(stream);
+    return Promise.resolve(stream);
+  }
+
+  emitClose(): void {
+    this.lastEvents?.onClose?.();
+  }
+
+  emitError(err: Error): void {
+    this.lastEvents?.onError(err);
+  }
+}
+
+function makeEvents() {
+  const errors: Error[] = [];
+  let closes = 0;
+  let reconnects = 0;
+  const events: StreamEvents = {
+    onPartial: () => {},
+    onFinal: () => {},
+    onError: (e) => errors.push(e),
+    onClose: () => closes++,
+    onReconnect: () => reconnects++,
+  };
+  return {
+    events,
+    errors,
+    closes: () => closes,
+    reconnects: () => reconnects,
+  };
+}
+
+const opts = { diarize: false };
+
+describe('withReconnect (scripted inner provider)', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it('retries once after an unexpected close without forwarding onClose', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, closes, reconnects } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    expect(inner.startCount).toBe(1);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.startCount).toBe(2);
+    expect(closes()).toBe(0);
+    expect(reconnects()).toBe(1);
+    stream.close();
+  });
+
+  it('treats an unexpected error like a dropped stream and holds it back', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, errors } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitError(new Error('socket boom'));
+    expect(inner.streams[0]!.closed).toBe(true);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.startCount).toBe(2);
+    expect(errors).toHaveLength(0);
+    stream.close();
+  });
+
+  it('backs off at 0.5/1/2/4/8s and never makes a 6th attempt', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, errors, closes } = makeEvents();
+    await provider.start_stream(opts, events);
+
+    const delays = [500, 1000, 2000, 4000, 8000];
+    for (const [i, delay] of delays.entries()) {
+      inner.emitClose();
+      await vi.advanceTimersByTimeAsync(delay - 1);
+      expect(inner.startCount).toBe(i + 1);
+      await vi.advanceTimersByTimeAsync(1);
+      expect(inner.startCount).toBe(i + 2);
+    }
+
+    inner.emitClose();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(inner.startCount).toBe(6);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toBeInstanceOf(SttReconnectError);
+    expect(closes()).toBe(1);
+  });
+
+  it('emits one SttReconnectError then one onClose after 5 failed attempts', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, errors, closes } = makeEvents();
+    await provider.start_stream(opts, events);
+
+    inner.rejectCount = 5;
+    inner.emitClose();
+    await vi.advanceTimersByTimeAsync(500 + 1000 + 2000 + 4000 + 8000);
+
+    expect(inner.startCount).toBe(6);
+    expect(errors).toHaveLength(1);
+    const err = errors[0]!;
+    expect(err).toBeInstanceOf(SttReconnectError);
+    expect((err as SttReconnectError).code).toBe('STT_RECONNECT_FAILED');
+    expect((err as SttReconnectError).attempts).toBe(5);
+    expect(err.message).toBe(
+      'STT stream lost; reconnect failed after 5 attempts',
+    );
+    expect(closes()).toBe(1);
+  });
+
+  it('buffers audio during the gap and flushes in order to the new stream', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    stream.send_audio(Buffer.from('a'));
+    inner.emitClose();
+    stream.send_audio(Buffer.from('b'));
+    stream.send_audio(Buffer.from('c'));
+    await vi.advanceTimersByTimeAsync(500);
+
+    expect(inner.streams[0]!.audio.map(String)).toEqual(['a']);
+    expect(inner.streams[1]!.audio.map(String)).toEqual(['b', 'c']);
+    stream.send_audio(Buffer.from('d'));
+    expect(inner.streams[1]!.audio.map(String)).toEqual(['b', 'c', 'd']);
+    stream.close();
+  });
+
+  it('drops the oldest chunks when the pending buffer overflows', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, {
+      random: () => 0.5,
+      maxPendingChunks: 3,
+    });
+    const { events } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    for (const c of ['a', 'b', 'c', 'd', 'e']) {
+      stream.send_audio(Buffer.from(c));
+    }
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.streams[1]!.audio.map(String)).toEqual(['c', 'd', 'e']);
+    stream.close();
+  });
+
+  it('cancels a pending retry on close() and never reconnects', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, closes } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    stream.close();
+    expect(closes()).toBe(1);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(inner.startCount).toBe(1);
+  });
+
+  it('is a no-op on close() after exhaustion beyond the single forwarded close', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, {
+      random: () => 0.5,
+      maxAttempts: 1,
+    });
+    const { events, errors, closes } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.startCount).toBe(2);
+    inner.emitClose();
+    expect(errors).toHaveLength(1);
+    expect(closes()).toBe(1);
+
+    stream.close();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(closes()).toBe(1);
+    expect(errors).toHaveLength(1);
+    expect(inner.startCount).toBe(2);
+  });
+
+  it('resets the attempt budget when the lost stream survived stableMs', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.startCount).toBe(2);
+
+    // the replacement survives past stableMs, then drops: fresh budget
+    await vi.advanceTimersByTimeAsync(6000);
+    inner.emitClose();
+    await vi.advanceTimersByTimeAsync(499);
+    expect(inner.startCount).toBe(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(inner.startCount).toBe(3);
+    stream.close();
+  });
+
+  it('consumes an attempt on a rejected reconnect and keeps retrying', async () => {
+    const inner = new ScriptedProvider();
+    const provider = withReconnect(inner, { random: () => 0.5 });
+    const { events, errors } = makeEvents();
+    const stream = await provider.start_stream(opts, events);
+
+    inner.emitClose();
+    inner.rejectCount = 1;
+    await vi.advanceTimersByTimeAsync(500);
+    expect(inner.startCount).toBe(2);
+
+    await vi.advanceTimersByTimeAsync(999);
+    expect(inner.startCount).toBe(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(inner.startCount).toBe(3);
+    expect(errors).toHaveLength(0);
+    stream.close();
+  });
+});
+
+class FakeDgSocket extends EventEmitter implements DgSocketLike {
+  binary: Buffer[] = [];
+  closedFlag = false;
+  readyState?: number;
+  connect(): void {}
+  sendMedia(chunk: ArrayBufferView): void {
+    this.binary.push(
+      Buffer.from(
+        chunk.buffer as ArrayBuffer,
+        chunk.byteOffset,
+        chunk.byteLength,
+      ),
+    );
+  }
+  sendCloseStream(): void {}
+  close(): void {
+    this.closedFlag = true;
+    this.emit('close');
+  }
+}
+
+class FakeWs extends EventEmitter implements WSLike {
+  binary: Buffer[] = [];
+  text: string[] = [];
+  closedFlag = false;
+  send(data: string | Buffer): void {
+    if (typeof data === 'string') this.text.push(data);
+    else this.binary.push(data);
+  }
+  close(): void {
+    this.closedFlag = true;
+    this.emit('close');
+  }
+}
+
+describe('withReconnect over real providers (fake sockets)', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
