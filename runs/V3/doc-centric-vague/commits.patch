+import { describe, expect, it } from 'vitest';
+import { filterSessions, sessionMatches } from './session-search';
+import type { SessionSummary } from './types';
+
+function summary(overrides: Partial<SessionSummary> = {}): SessionSummary {
+  return {
+    id: '2026-11-05-standup-1430',
+    file: '/data/sessions/2026-11-05/2026-11-05-standup-1430.md',
+    started_at: '2026-11-05T14:30:00.000Z',
+    ended_at: '2026-11-05T14:45:00.000Z',
+    source_lang: 'en',
+    target_lang: 'vi',
+    stt_provider: 'deepgram',
+    model: 'nova-3',
+    diarization: true,
+    audio_file: null,
+    speakers: { 'Speaker 1': 'Alice', 'Speaker 2': 'Bob' },
+    duration_s: 900,
+    segments: 42,
+    ...overrides,
+  };
+}
+
+describe('filterSessions', () => {
+  it('returns the input list unchanged for an empty query', () => {
+    const sessions = [summary(), summary({ id: '2026-11-04-sync-0900' })];
+    expect(filterSessions(sessions, '')).toEqual(sessions);
+  });
+
+  it('returns the input list unchanged for a whitespace-only query', () => {
+    const sessions = [summary(), summary({ id: '2026-11-04-sync-0900' })];
+    expect(filterSessions(sessions, '   \t ')).toEqual(sessions);
+  });
+
+  it('matches case-insensitively', () => {
+    expect(sessionMatches(summary(), 'STANDUP')).toBe(true);
+  });
+
+  it('matches an id substring', () => {
+    expect(sessionMatches(summary(), 'standup-1430')).toBe(true);
+  });
+
+  it('matches a file path fragment', () => {
+    expect(sessionMatches(summary(), '2026-11')).toBe(true);
+  });
+
+  it('matches a started_at ISO fragment', () => {
+    expect(sessionMatches(summary(), '11-05t14:30')).toBe(true);
+    expect(sessionMatches(summary(), '05T14')).toBe(true);
+  });
+
+  it('matches source_lang and target_lang', () => {
+    expect(sessionMatches(summary(), 'EN')).toBe(true);
+    expect(sessionMatches(summary(), 'vi')).toBe(true);
+  });
+
+  it('matches stt_provider', () => {
+    expect(sessionMatches(summary(), 'deepgram')).toBe(true);
+  });
+
+  it('matches model', () => {
+    expect(sessionMatches(summary(), 'nova-3')).toBe(true);
+  });
+
+  it('matches a speaker display name', () => {
+    expect(sessionMatches(summary(), 'alice')).toBe(true);
+    expect(sessionMatches(summary(), 'BOB')).toBe(true);
+  });
+
+  it('returns an empty array when nothing matches', () => {
+    const sessions = [summary(), summary({ id: '2026-11-04-sync-0900' })];
+    expect(filterSessions(sessions, 'zzz-no-such-thing')).toEqual([]);
+  });
+
+  it('preserves the input order of matches', () => {
+    const a = summary({ id: '2026-11-03-alpha-0800' });
+    const b = summary({ id: '2026-11-04-beta-0900' });
+    const c = summary({ id: '2026-11-05-gamma-1000' });
