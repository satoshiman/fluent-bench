+        '2\n00:00:03.500 --> 00:00:04.000\nYo.\n',
+    );
+    expect(vtt.endsWith('\n')).toBe(true);
+    expect(vtt.endsWith('\n\n')).toBe(false);
+  });
+
+  it('keeps an identifier-less cue without inventing an identifier', () => {
+    expect(srtToVtt('00:00:01,000 --> 00:00:02,000\nBare text.\n')).toBe(
