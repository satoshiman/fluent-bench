diff --git a/server/session/vtt.ts b/server/session/vtt.ts
new file mode 100644
index 0000000..74c0699
--- /dev/null
+++ b/server/session/vtt.ts
@@ -0,0 +1,40 @@
+// On-demand SRT -> WebVTT export (PLAN-012). The bilingual .srt remains the
+// canonical transcript artifact (ADR-007); the .vtt is a derived view built
+// per request and never persisted. Pure conversion: no I/O, no imports.
+
+// VTT cue text escapes &, <, >. Escaping > also neutralizes a literal `-->`
+// inside text (becomes `--&gt;`), which raw VTT cue text forbids.
+function escapeVttText(line: string): string {
+  return line
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function blockToCue(block: string): string {
+  // A block's own trailing newlines are block separators, not payload: a
+  // stored cue ends in `\n\n`, and a bare trailing `\n` must not become an
+  // empty text line (the file ends with a single `\n`).
+  const lines = block.replace(/\n+$/, '').split('\n');
+  const out: string[] = [];
+  let i = 0;
+  // When the first line is not the timing line it is a cue identifier kept
+  // verbatim (SRT cue numbers are valid VTT cue identifiers).
+  if (!lines[0]?.includes(' --> ')) {
+    out.push(lines[0]!);
+    i = 1;
+  }
+  // Timing line: verbatim except the SRT `HH:MM:SS,mmm` comma becomes a dot.
+  const timing = lines[i];
+  if (timing !== undefined) out.push(timing.replace(/,/g, '.'));
+  for (const line of lines.slice(i + 1)) {
+    out.push(escapeVttText(line));
+  }
+  return out.join('\n');
+}
+
+export function srtToVtt(srt: string): string {
+  const blocks = srt.split(/\n{2,}/).filter((b) => b.trim() !== '');
+  if (blocks.length === 0) return 'WEBVTT\n';
+  return `WEBVTT\n\n${blocks.map(blockToCue).join('\n\n')}\n`;
+}
