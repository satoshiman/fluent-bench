+  // WebVTT export for video tools: converted from the stored .srt on
+  // demand, so mid-session cues already carry every landed translation and
+  // sessions recorded before the export existed work unchanged.
+  app.get('/api/sessions/:id/vtt', async (req, reply) => {
+    const { id } = req.params as { id: string };
+    const stored = await readSession(sessions.dir, id);
+    if (!stored) {
+      return reply.code(404).send({ error: `session not found: ${id}` });
+    }
+    return reply
+      .header('Content-Type', 'text/vtt')
+      .header('Content-Disposition', `attachment; filename="${id}.vtt"`)
+      .send(srtToVtt(stored.srt));
+  });
