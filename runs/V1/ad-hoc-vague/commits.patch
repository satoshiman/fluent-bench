+++ b/server/session/vtt.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { formatCue, insertTranslationLine } from './srt.js';
+import { srtToVtt } from './vtt.js';
+
+describe('srtToVtt', () => {
+  it('adds the WEBVTT header and converts commas to dots in timestamps', () => {
+    const srt =
+      '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\n\n' +
+      '2\n00:00:05,100 --> 00:00:08,200\nHi there.\n\n';
+    expect(srtToVtt(srt)).toBe(
+      'WEBVTT\n\n' +
+        '1\n00:00:02.000 --> 00:00:04.800\nSpeaker 1: Hello.\n\n' +
+        '2\n00:00:05.100 --> 00:00:08.200\nHi there.\n',
+    );
+  });
+
+  it('keeps spliced translation lines inside their cue', () => {
+    const srt = insertTranslationLine(
+      formatCue(0, { text: 'Hello.', start_s: 1, end_s: 2 }),
+      0,
+      'Xin chào.',
+    )!;
+    const vtt = srtToVtt(srt);
+    expect(vtt).toContain('00:00:01.000 --> 00:00:02.000\nHello.\nXin chào.');
+  });
+
+  it('leaves commas outside timestamp lines untouched', () => {
+    const srt = '1\n00:00:01,000 --> 00:00:02,000\none, two, three\n\n';
+    expect(srtToVtt(srt)).toContain('one, two, three');
+  });
+
+  it('emits a header-only document for an empty transcript', () => {
+    expect(srtToVtt('')).toBe('WEBVTT\n');
+    expect(srtToVtt('\n\n')).toBe('WEBVTT\n');
+  });
+});
diff --git a/server/session/vtt.ts b/server/session/vtt.ts
new file mode 100644
index 0000000..b857b1a
--- /dev/null
+++ b/server/session/vtt.ts
@@ -0,0 +1,18 @@
+// WebVTT export derived from the stored .srt (ADR-007). The SRT stays the
+// canonical transcript artifact; the VTT is generated on demand so it always
+// reflects the latest translation splices and works for sessions recorded
+// before the export existed. The conversion is line-level: SRT cue numbers
+// become VTT cue identifiers, `,` millisecond separators become `.`, and a
+// `WEBVTT` magic header goes on top.
+export function srtToVtt(srt: string): string {
+  const body = srt
+    .split('\n')
+    .map((line) =>
+      line.includes(' --> ')
+        ? line.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2')
+        : line,
+    )
+    .join('\n')
+    .trim();
+  return body === '' ? 'WEBVTT\n' : `WEBVTT\n\n${body}\n`;
+}
