+import { describe, expect, it } from 'vitest';
+import { srtToVtt } from './vtt.js';
+
+describe('srtToVtt', () => {
+  it('converts a bilingual two-cue SRT into a WebVTT document', () => {
+    const srt =
+      '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\nXin chào.\n\n' +
+      '2\n00:00:05,100 --> 00:00:08,200\nHi there.\n\n';
+    expect(srtToVtt(srt)).toBe(
+      'WEBVTT\n\n' +
+        '1\n00:00:02.000 --> 00:00:04.800\nSpeaker 1: Hello.\nXin chào.\n\n' +
+        '2\n00:00:05.100 --> 00:00:08.200\nHi there.\n\n',
+    );
+  });
+
+  it('keeps a cue without a translation line single-line', () => {
+    const srt = '3\n00:00:09,000 --> 00:00:10,000\nBye.\n\n';
+    expect(srtToVtt(srt)).toBe(
+      'WEBVTT\n\n3\n00:00:09.000 --> 00:00:10.000\nBye.\n\n',
+    );
+  });
+
+  it('does not touch commas inside cue text', () => {
+    const srt =
+      '1\n00:00:01,000 --> 00:00:02,000\nYes, really, I said so.\n\n';
+    const vtt = srtToVtt(srt);
+    expect(vtt).toContain('00:00:01.000 --> 00:00:02.000');
+    expect(vtt).toContain('Yes, really, I said so.');
+  });
+
+  it('returns a bare WEBVTT header for empty or whitespace-only input', () => {
+    expect(srtToVtt('')).toBe('WEBVTT\n');
+    expect(srtToVtt('  \n \n')).toBe('WEBVTT\n');
+  });
+});
diff --git a/server/session/vtt.ts b/server/session/vtt.ts
new file mode 100644
