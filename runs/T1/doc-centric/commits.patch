--- /dev/null
+++ b/server/session/vtt.ts
@@ -0,0 +1,15 @@
+// WebVTT export (PLAN-012): the stored .srt stays the canonical transcript
+// artifact (ADR-007); VTT is derived at request time and never written to
+// disk. The conversion is a pure line transform: any line containing
+// ` --> ` gets its SRT `HH:MM:SS,mmm` commas converted to WebVTT dots, and
+// every other line passes through byte-for-byte - cue numbers become legal
+// WebVTT cue identifiers (keeping the segment index + 1 binding) and text
+// lines keep their exact source/translation content.
+export function srtToVtt(srt: string): string {
+  if (srt.trim() === '') return 'WEBVTT\n';
+  const body = srt
+    .split('\n')
+    .map((line) => (line.includes(' --> ') ? line.replace(/,/g, '.') : line))
+    .join('\n');
+  return `WEBVTT\n\n${body}`;
+}
