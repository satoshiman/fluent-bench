+describe('session export', () => {
+  it('serves the stored transcript as a WebVTT attachment', async () => {
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/sessions',
+      payload: { diarize: true },
+    });
+    const info = res.json() as { id: string };
+
+    provider.emitFinal({
+      text: 'Hello.',
+      speaker: 'Speaker 1',
+      start_s: 1,
+      end_s: 2,
+    });
+    let srt = '';
+    await vi.waitFor(async () => {
+      const read = await app.inject({
+        method: 'GET',
+        url: `/api/sessions/${info.id}`,
+      });
+      srt = (read.json() as { srt: string }).srt;
+      expect(srt).toContain('XIN CHÀO');
+    });
+    await app.inject({ method: 'POST', url: `/api/sessions/${info.id}/stop` });
+
+    const vtt = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export?format=vtt`,
+    });
+    expect(vtt.statusCode).toBe(200);
+    expect(vtt.headers['content-type']).toContain('text/vtt');
+    expect(vtt.headers['content-disposition']).toBe(
+      `attachment; filename="${info.id}.vtt"`,
+    );
+    // streamBaseS makes the exact ms nondeterministic, so pin the format
+    // rather than the value
+    expect(vtt.body).toMatch(
+      /^WEBVTT\n\n1\n\d{2}:\d{2}:\d{2}\.\d{3} --> \d{2}:\d{2}:\d{2}\.\d{3}\nSpeaker 1: Hello\.\nXIN CHÀO\n$/,
+    );
+    // same cues as the srt artifact, only the timestamp separator changes
+    expect(vtt.body).toBe(
+      `WEBVTT\n\n${srt.replace(/,(\d{3})/g, '.$1').trimEnd()}\n`,
+    );
+  });
+
+  it('returns 404 for an unknown session id', async () => {
+    const res = await app.inject({
+      method: 'GET',
+      url: '/api/sessions/2099-01-01-nope/export?format=vtt',
+    });
+    expect(res.statusCode).toBe(404);
+  });
+
+  it('returns 400 for an unsupported format', async () => {
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/sessions',
+      payload: {},
+    });
+    const info = res.json() as { id: string };
+    await app.inject({ method: 'POST', url: `/api/sessions/${info.id}/stop` });
+
+    const bad = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export?format=txt`,
+    });
+    expect(bad.statusCode).toBe(400);
+
+    const missing = await app.inject({
+      method: 'GET',
+      url: `/api/sessions/${info.id}/export`,
+    });
+    expect(missing.statusCode).toBe(400);
+  });
+});
