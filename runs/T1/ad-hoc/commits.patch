index 0000000..ee83897
--- /dev/null
+++ b/server/session/vtt.ts
@@ -0,0 +1,23 @@
+// WebVTT rendering of the bilingual .srt session artifact (ADR-007): same
+// cues, same text lines; only the syntax changes. SRT timing uses a comma
+// (`HH:MM:SS,mmm`), WebVTT a dot (`HH:MM:SS.mmm`), and the file opens with a
+// `WEBVTT` header. The SRT cue counter is kept as the optional WebVTT cue
+// identifier so cue N still maps to zero-based socket index N - 1.
+const TIMING_LINE =
+  /^\s*\d{2}:\d{2}:\d{2},\d{3}\s+-->\s+\d{2}:\d{2}:\d{2},\d{3}\s*$/;
+
+export function srtToVtt(srt: string): string {
+  const cues = srt
+    .split(/\n{2,}/)
+    .map((block) => block.trim())
+    .filter((block) => block !== '')
+    .map((block) =>
+      block
+        .split('\n')
+        .map((line) =>
+          TIMING_LINE.test(line) ? line.trim().replaceAll(',', '.') : line,
+        )
+        .join('\n'),
+    );
+  return `${['WEBVTT', ...cues].join('\n\n')}\n`;
+}
