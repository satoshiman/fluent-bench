+import { describe, expect, it } from 'vitest';
+import { srtToVtt } from './vtt.js';
+
+describe('srtToVtt', () => {
+  it('emits a WEBVTT header and dot-separated cue timing', () => {
+    const vtt = srtToVtt(
+      '1\n00:00:02,000 --> 00:00:04,800\nSpeaker 1: Hello.\nXIN CHÀO\n\n' +
+        '2\n00:00:05,100 --> 00:00:08,200\nHi there.\n\n',
+    );
+    expect(vtt).toBe(
+      'WEBVTT\n\n' +
+        '1\n00:00:02.000 --> 00:00:04.800\nSpeaker 1: Hello.\nXIN CHÀO\n\n' +
+        '2\n00:00:05.100 --> 00:00:08.200\nHi there.\n',
+    );
+  });
+
+  it('keeps text lines verbatim; only the timing line is rewritten', () => {
+    const vtt = srtToVtt('1\n00:00:01,000 --> 00:00:02,000\na, b, c\n\n');
+    expect(vtt).toContain('a, b, c');
+    expect(vtt).not.toContain(',000');
+  });
+
+  it('renders a bare header for an empty transcript', () => {
+    expect(srtToVtt('')).toBe('WEBVTT\n');
+  });
+});
diff --git a/server/session/vtt.ts b/server/session/vtt.ts
