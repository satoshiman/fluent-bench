+++ b/web/src/lib/filter-sessions.ts
@@ -0,0 +1,15 @@
+import type { SessionSummary } from '@/lib/types';
+
+export function sessionSearchText(s: SessionSummary): string {
+  const date = s.started_at ? new Date(s.started_at).toLocaleString() : '';
+  return `${s.id}\n${date}`.toLowerCase();
+}
+
+export function filterSessions(
+  sessions: SessionSummary[],
+  query: string,
+): SessionSummary[] {
+  const q = query.trim().toLowerCase();
+  if (q === '') return sessions;
+  return sessions.filter((s) => sessionSearchText(s).includes(q));
+}
