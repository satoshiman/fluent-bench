+import { describe, expect, it } from 'vitest';
+import { filterSessions } from './filter-sessions';
+import type { SessionSummary } from './types';
+
+function session(id: string, started_at: string | null): SessionSummary {
+  return {
+    id,
+    file: `${id}.md`,
+    started_at,
+    ended_at: null,
+    source_lang: 'en',
+    target_lang: 'vi',
+    stt_provider: 'deepgram',
+    model: null,
+    diarization: false,
+    audio_file: null,
+    speakers: {},
+    duration_s: null,
+    segments: 0,
+  };
+}
+
+const sessions: SessionSummary[] = [
+  session('2026-11-05-standup-1030', '2026-11-05T10:30:00.000Z'),
+  session('2026-11-04-review-0900', '2026-11-04T09:00:00.000Z'),
+  session('2026-11-03-notes-1400', null),
+];
+
+describe('filterSessions', () => {
+  it('returns all sessions for an empty or whitespace query', () => {
+    expect(filterSessions(sessions, '')).toEqual(sessions);
+    expect(filterSessions(sessions, '   ')).toEqual(sessions);
+  });
+
+  it('matches the session id case-insensitively', () => {
+    const out = filterSessions(sessions, 'STANDUP');
+    expect(out.map((s) => s.id)).toEqual(['2026-11-05-standup-1030']);
+  });
+
+  it('matches against the formatted date', () => {
+    const date = new Date('2026-11-04T09:00:00.000Z').toLocaleString();
+    const out = filterSessions(sessions, date.slice(0, 6));
+    expect(out.map((s) => s.id)).toEqual(['2026-11-04-review-0900']);
+  });
+
+  it('returns an empty array when nothing matches', () => {
+    expect(filterSessions(sessions, 'no-such-session')).toEqual([]);
+  });
+});
diff --git a/web/src/lib/filter-sessions.ts b/web/src/lib/filter-sessions.ts
