+import { describe, expect, it } from 'vitest';
+import { filterSessions } from './session-filter';
+import type { SessionSummary } from './types';
+
+function mk(overrides: Partial<SessionSummary> = {}): SessionSummary {
+  return {
+    id: 'session-0000',
+    file: 'session-0000.md',
+    started_at: '2026-11-04T14:30:00.000Z',
+    ended_at: null,
+    source_lang: 'en',
+    target_lang: 'vi',
+    stt_provider: 'deepgram',
+    model: null,
+    diarization: false,
+    audio_file: null,
+    speakers: {},
+    duration_s: 60,
+    segments: 3,
+    ...overrides,
+  };
+}
+
+const SESSIONS = [
+  mk({ id: 'standup-1430', started_at: '2026-11-04T14:30:00.000Z' }),
+  mk({ id: 'interview-0915', started_at: '2026-11-03T09:15:00.000Z' }),
+  mk({ id: 'lecture-1800', started_at: null }),
+];
+
+describe('filterSessions', () => {
+  it('returns the full list for an empty query', () => {
+    expect(filterSessions(SESSIONS, '')).toBe(SESSIONS);
+  });
+
+  it('returns the full list for a whitespace-only query', () => {
+    expect(filterSessions(SESSIONS, '   ')).toBe(SESSIONS);
+  });
+
+  it('matches id case-insensitively', () => {
+    expect(filterSessions(SESSIONS, 'STANDUP').map((s) => s.id)).toEqual([
+      'standup-1430',
+    ]);
+  });
+
+  it('matches the raw ISO started_at', () => {
+    expect(filterSessions(SESSIONS, '2026-11-04').map((s) => s.id)).toEqual([
+      'standup-1430',
+    ]);
+  });
+
+  it('matches the displayed locale date string', () => {
+    const started = '2026-11-04T14:30:00.000Z';
+    const needle = new Date(started).toLocaleString();
+    expect(filterSessions(SESSIONS, needle).map((s) => s.id)).toEqual([
+      'standup-1430',
+    ]);
+  });
+
+  it('returns an empty array when nothing matches', () => {
+    expect(filterSessions(SESSIONS, 'zzz-no-match')).toEqual([]);
+  });
+
+  it('does not throw on started_at: null and still matches on id', () => {
+    expect(filterSessions(SESSIONS, 'lecture').map((s) => s.id)).toEqual([
+      'lecture-1800',
+    ]);
+  });
+});
diff --git a/web/src/lib/session-filter.ts b/web/src/lib/session-filter.ts
new file mode 100644
