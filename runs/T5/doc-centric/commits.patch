+import { describe, expect, it } from 'vitest';
+import {
+  isPlaybackRate,
+  PLAYBACK_RATES,
+  rateLabel,
+} from './playback-rates';
+
+describe('PLAYBACK_RATES', () => {
+  it('is exactly [0.75, 1, 1.25, 1.5, 2] in order', () => {
+    expect(PLAYBACK_RATES).toEqual([0.75, 1, 1.25, 1.5, 2]);
+  });
+});
+
+describe('isPlaybackRate', () => {
+  it('accepts every listed rate', () => {
+    for (const r of PLAYBACK_RATES) {
+      expect(isPlaybackRate(r)).toBe(true);
+    }
+  });
+
+  it('rejects values outside the list', () => {
+    expect(isPlaybackRate(0.5)).toBe(false);
+    expect(isPlaybackRate(3)).toBe(false);
+    expect(isPlaybackRate(NaN)).toBe(false);
+  });
+});
+
+describe('rateLabel', () => {
+  it('formats the rate with an x suffix', () => {
+    expect(rateLabel(0.75)).toBe('0.75x');
+    expect(rateLabel(1)).toBe('1x');
+    expect(rateLabel(2)).toBe('2x');
+  });
+});
