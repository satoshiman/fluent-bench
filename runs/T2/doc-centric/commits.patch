+++ b/server/translate/retry.ts
@@ -0,0 +1,46 @@
+import { APIConnectionError } from 'openai';
+
+export interface RetryOptions {
+  maxAttempts?: number; // default 3 (total attempts, not retries)
+  baseDelayMs?: number; // default 500
+  jitterRatio?: number; // default 0.25
+  sleep?: (ms: number) => Promise<void>; // default: setTimeout promise
+  random?: () => number; // default: Math.random
+}
+
+export const DEFAULT_MAX_ATTEMPTS = 3;
+export const DEFAULT_BASE_DELAY_MS = 500;
+export const DEFAULT_JITTER_RATIO = 0.25;
+
+// Transient failures only: SDK connection errors (incl. timeouts) and
+// server/rate-limit statuses. Everything else - other 4xx, aborts, plain
+// errors, TranslationError from malformed responses - fails immediately.
+export function isRetryableError(err: unknown): boolean {
+  if (err instanceof APIConnectionError) return true;
+  const status = (err as { status?: unknown } | null | undefined)?.status;
+  return typeof status === 'number' && (status === 429 || status >= 500);
+}
+
+export async function withRetries<T>(
+  fn: () => Promise<T>,
+  options: RetryOptions = {},
+): Promise<T> {
+  const maxAttempts = options.maxAttempts ?? DEFAULT_MAX_ATTEMPTS;
+  const baseDelayMs = options.baseDelayMs ?? DEFAULT_BASE_DELAY_MS;
+  const jitterRatio = options.jitterRatio ?? DEFAULT_JITTER_RATIO;
+  const sleep =
+    options.sleep ??
+    ((ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)));
+  const random = options.random ?? Math.random;
+
+  for (let i = 1; ; i++) {
+    try {
+      return await fn();
+    } catch (err) {
+      if (!isRetryableError(err) || i >= maxAttempts) throw err;
+      const base = baseDelayMs * 2 ** (i - 1);
+      const delay = base + Math.floor(random() * base * jitterRatio);
+      await sleep(delay);
+    }
+  }
+}
