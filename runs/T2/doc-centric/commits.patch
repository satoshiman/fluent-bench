+import { describe, expect, it } from 'vitest';
+import OpenAI from 'openai';
+import { isRetryableError, withRetries } from './retry.js';
+import { TranslationError } from './translator.js';
+
+const apiError = (status: number) =>
+  new OpenAI.APIError(status, undefined, 'boom', undefined);
+
+describe('isRetryableError', () => {
+  it('retries connection errors and timeouts', () => {
+    expect(isRetryableError(new OpenAI.APIConnectionError({ message: 'down' }))).toBe(true);
+    expect(isRetryableError(new OpenAI.APIConnectionTimeoutError({ message: 'slow' }))).toBe(true);
+  });
+
+  it('retries HTTP 5xx and 429', () => {
+    for (const status of [500, 503, 429]) {
+      expect(isRetryableError(apiError(status))).toBe(true);
+    }
+  });
+
+  it('does not retry other 4xx, plain errors, or TranslationError', () => {
+    for (const status of [400, 401, 404]) {
+      expect(isRetryableError(apiError(status))).toBe(false);
+    }
+    expect(isRetryableError(new OpenAI.APIUserAbortError())).toBe(false);
+    expect(isRetryableError(new Error('boom'))).toBe(false);
+    expect(isRetryableError(new TranslationError('empty translation response'))).toBe(false);
+  });
+});
+
+describe('withRetries', () => {
+  it('returns the value on success without sleeping', async () => {
+    const sleeps: number[] = [];
+    const out = await withRetries(async () => 'ok', {
+      sleep: async (ms) => {
+        sleeps.push(ms);
+      },
+    });
+    expect(out).toBe('ok');
+    expect(sleeps).toEqual([]);
+  });
+
+  it('rethrows non-retryable errors on the first failure without sleeping', async () => {
+    const sleeps: number[] = [];
+    let calls = 0;
+    await expect(
+      withRetries(
+        async () => {
+          calls++;
+          throw apiError(400);
+        },
+        {
+          sleep: async (ms) => {
+            sleeps.push(ms);
+          },
+        },
+      ),
+    ).rejects.toBeInstanceOf(OpenAI.APIError);
+    expect(calls).toBe(1);
+    expect(sleeps).toEqual([]);
+  });
+
+  it('sleeps on the pinned exponential schedule between attempts', async () => {
+    const sleeps: number[] = [];
+    let calls = 0;
+    await expect(
+      withRetries(
+        async () => {
+          calls++;
+          throw apiError(503);
+        },
+        {
+          sleep: async (ms) => {
+            sleeps.push(ms);
+          },
+          random: () => 0,
+        },
+      ),
+    ).rejects.toBeInstanceOf(OpenAI.APIError);
+    expect(calls).toBe(3);
+    expect(sleeps).toEqual([500, 1000]);
+  });
+
+  it('succeeds after a transient failure', async () => {
+    const sleeps: number[] = [];
+    let calls = 0;
+    const out = await withRetries(
+      async () => {
+        calls++;
+        if (calls < 2) throw new OpenAI.APIConnectionError({ message: 'down' });
+        return 'ok';
+      },
+      {
+        sleep: async (ms) => {
+          sleeps.push(ms);
+        },
+        random: () => 0,
+      },
+    );
