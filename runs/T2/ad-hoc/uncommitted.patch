+// Transient failures only: HTTP 5xx, HTTP 429, and connection-level
+// network errors. The OpenAI SDK reports HTTP failures via `status` and
+// wraps transport failures in APIConnectionError (no status). Node's
+// undici fetch surfaces transport failures as TypeError whose `cause`
+// carries an errno code, so the cause chain is walked too. Everything
+// else - other 4xx, malformed responses, programming errors - is not
+// retried.
+export function isRetryableError(err: unknown): boolean {
+  let e: unknown = err;
+  while (e != null) {
+    const status = (e as { status?: unknown }).status;
+    if (typeof status === 'number') {
+      return status === 429 || status >= 500;
+    }
+    const name = (e as { name?: unknown }).name;
+    if (
+      name === 'APIConnectionError' ||
+      name === 'APIConnectionTimeoutError'
+    ) {
+      return true;
+    }
+    const code = (e as { code?: unknown }).code;
+    if (typeof code === 'string' && RETRYABLE_CODES.has(code)) {
+      return true;
+    }
+    e = (e as { cause?: unknown }).cause;
+  }
+  return false;
+}
+
+const RETRYABLE_CODES = new Set([
+  'ECONNABORTED',
+  'ECONNREFUSED',
+  'ECONNRESET',
+  'EHOSTUNREACH',
+  'ENETUNREACH',
+  'ENOTFOUND',
+  'EAI_AGAIN',
+  'EPIPE',
+  'ETIMEDOUT',
+  'UND_ERR_BODY_TIMEOUT',
+  'UND_ERR_CONNECT_TIMEOUT',
+  'UND_ERR_HEADERS_TIMEOUT',
+  'UND_ERR_SOCKET',
+]);
+
+export interface RetryOptions {
+  maxAttempts?: number;
+  baseDelayMs?: number;
+  sleep?: (ms: number) => Promise<void>;
+  random?: () => number;
+}
+
+const DEFAULT_MAX_ATTEMPTS = 3;
+const DEFAULT_BASE_DELAY_MS = 500;
+const JITTER_FRACTION = 0.25;
+
+const defaultSleep = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+// Exponential backoff: baseDelayMs, doubling per attempt, plus up to 25%
+// random jitter to avoid thundering herd. The last error is rethrown so
+// exhaustion surfaces through the caller's normal error path.
+export async function withRetry<T>(
+  fn: () => Promise<T>,
+  shouldRetry: (err: unknown) => boolean,
+  opts: RetryOptions = {},
+): Promise<T> {
+  const maxAttempts = opts.maxAttempts ?? DEFAULT_MAX_ATTEMPTS;
+  const baseDelayMs = opts.baseDelayMs ?? DEFAULT_BASE_DELAY_MS;
+  const sleep = opts.sleep ?? defaultSleep;
+  const random = opts.random ?? Math.random;
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await fn();
+    } catch (err) {
+      if (attempt >= maxAttempts || !shouldRetry(err)) throw err;
+      const backoff = baseDelayMs * 2 ** (attempt - 1);
+      await sleep(backoff * (1 + random() * JITTER_FRACTION));
+    }
+  }
+}
